esourceKey="MenuBarItemBackgroundSelected" /></Setter.Value></Setter><Trigger.Value><ns1:Boolean>True</ns1:Boolean></Trigger.Value></Trigger><Trigger Property="UIElement.IsEnabled"><Setter Property="TextElement.Foreground"><Setter.Value><SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" /></Setter.Value></Setter><Setter Property="TextElement.Foreground" TargetName="Chevron"><Setter.Value><SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" /></Setter.Value></Setter><Trigger.Value><ns1:Boolean>False</ns1:Boolean></Trigger.Value></Trigger><Trigger Property="MenuItem.IsSubmenuOpen"><Trigger.EnterActions><BeginStoryboard><Storyboard><Storyboard.Children><DoubleAnimation From="-90" To="0" Duration="00:00:00.1670000" Storyboard.TargetName="SubmenuBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard.Children></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.Value><ns1:Boolean>True</ns1:Boolean></Trigger.Value></Trigger></ControlTemplate.Triggers></ControlTemplate>
