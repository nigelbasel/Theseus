<Window x:Class="Theseus.App.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1000" Height="720" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <!-- A piece's records (Nigel, 2026-11-22): its documents by stage, the chosen one formatted, the folder last. -->
    <DockPanel Margin="16,12,16,12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <!-- One bar at the top: the two views as a selector bar, then the window's commands as a toolbar, icon and word,
             in place of a button at the bottom and a link beside it (walkthrough row 42; checklist G38, G42, G125; baseline W15). -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once"
                        KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Views of the document">
                <RadioButton x:Name="PreviewTab" Content="Preview" GroupName="RecordView" Style="{DynamicResource SelectorBarItem}"
                             IsChecked="{Binding IsPreview, Mode=OneWay}" Command="{Binding PreviewCommand}"
                             ToolTip="Preview: the document drawn, as it reads" />
                <RadioButton x:Name="SourceTab" Content="Source" GroupName="RecordView" Style="{DynamicResource SelectorBarItem}"
                             IsChecked="{Binding IsSource, Mode=OneWay}" Command="{Binding SourceCommand}"
                             ToolTip="Source: the document's Markdown, as written" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenInEditor" Style="{DynamicResource ToolIcon}" FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                        Height="32" Padding="8,0" Margin="0,0,8,0" Command="{Binding OpenInEditorCommand}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Open in editor: the document shown, in your editor" AutomationProperties.Name="Open in editor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <AccessText Text="Open in _editor" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolder" Style="{DynamicResource ToolIcon}" FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                        Height="32" Padding="8,0" Command="{Binding OpenFolderCommand}"
                        ToolTip="Open folder: the records folder, in Explorer" AutomationProperties.Name="Open folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <AccessText Text="Open _folder" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="None" DockPanel.Dock="Top" Text="{Binding NoneText}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasNone, Converter={StaticResource Visible}}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Entries" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Margin="0,0,12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Records by stage">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4" Cursor="Hand" AutomationProperties.Name="{Binding Stage}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Purpose}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding FileName}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="1" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                      Visibility="{Binding IsPreview, Converter={StaticResource Visible}}" />
            <TextBox x:Name="Source" Grid.Column="1" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="The document's Markdown"
                     Visibility="{Binding IsSource, Converter={StaticResource Visible}}" />
        </Grid>
    </DockPanel>
</Window>
