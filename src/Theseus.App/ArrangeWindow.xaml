<Window x:Class="Theseus.App.ArrangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange terminal windows"
        Width="560"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Preview}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />

                <!--
                    Said before anything moves, because finding out that four terminals are sixty
                    columns wide by doing it - after your own arrangement has been destroyed - is a
                    poor way to learn it.
                -->
                <TextBlock Text="Windows this narrow fold Claude Code's output. Two side by side is the comfortable limit here."
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding IsTooNarrow, Converter={StaticResource BoolToVisibility}}"
                           Foreground="#D68910" />

                <TextBlock Text="{Binding Outcome}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Outcome, Converter={StaticResource NotEmptyToVisibility}}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Put back" Padding="14,5" Margin="0,0,8,0"
                            ToolTip="Return every window to where it was before the first arrangement"
                            Command="{Binding RestoreCommand}" />
                    <Button Content="Close" Padding="14,5" Margin="0,0,8,0" IsCancel="True"
                            Command="{Binding CloseCommand}" />
                    <Button Content="Arrange" Padding="18,5" IsDefault="True"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Arrangement" VerticalAlignment="Center" FontSize="12"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox Width="150" VerticalAlignment="Center"
                              ItemsSource="{Binding Kinds}"
                              SelectedItem="{Binding Kind, Mode=TwoWay}" />
                    <Button Content="Look again" Padding="12,4" Margin="12,0,0,0"
                            ToolTip="Read the desktop again, in case a window has opened or closed"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>

                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Untick a window to leave it exactly where it is. Sessions cannot be moved between windows from here — drag the tab in Windows Terminal to do that." />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,10">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,0,0,8" CornerRadius="6"
                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                                <TextBlock Text="{Binding Sessions}" FontSize="11" TextWrapping="Wrap"
                                           Margin="26,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Where}" FontSize="10.5" Margin="26,4,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
