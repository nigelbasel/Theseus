<Window x:Class="Theseus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Theseus.App.ViewModels"
        xmlns:settings="clr-namespace:Theseus.Core.Settings;assembly=Theseus.Core"
        xmlns:launching="clr-namespace:Theseus.Core.Launching;assembly=Theseus.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        AllowsTransparency="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="Manual"
        Icon="Assets/theseus.ico"
        Title="Theseus" Height="760" Width="1400" MinHeight="480" MinWidth="720">

    <Window.Resources>

        <ObjectDataProvider x:Key="ThemeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="settings:AppTheme" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!--
            The icon font is set on the glyph itself and never on anything that contains text.
            FontFamily inherits, so a command bar carrying its icon on the parent turns every label
            below it into a row of empty squares.
        -->
        <Style x:Key="CommandGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,1,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!--
            The command bar draws its own button rather than taking the theme's.

            The Fluent theme paints hover and pressed through a VisualStateManager inside its
            template, and in dark mode the difference is a few percent of lightness - Nigel reported
            the bar as having no feedback at all on hover or on click, which is what that amounts to
            in practice. A property trigger on the theme's own style would not help either: the
            template's visual states win over it.

            Disabled is worth as much as the other two here. "Start selected" is disabled until
            something is ticked, and a button that looks identical either way reads as broken rather
            than as waiting.
        -->
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Face">
                            <Border CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" />

                            <!--
                                Hover fills the button with the accent outright. A wash over the
                                ordinary fill was tried first and Nigel still called it faint: on a
                                dark board a partly transparent tint is a change of shade, and a
                                change of shade is what he was complaining about in the first place.
                                The label turns white with it, which is what keeps it readable on a
                                saturated fill whatever the theme.
                            -->
                            <Border x:Name="Glow" CornerRadius="4" Opacity="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />

                            <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <!--
                                Pressed darkens the accent and drops the button a pixel, so a click
                                reads as going in rather than merely as another shade of the same.
                            -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                <Setter TargetName="Glow" Property="Background" Value="#FF1F4E7A" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="White" />
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="4" Padding="6,2"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="JiraKeyTemplate">
            <Button Style="{StaticResource ChipButton}"
                    Command="{Binding DataContext.OpenJiraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding StringFormat=Open {0} in Jira}">
                <TextBlock Text="{Binding}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PullRequestTemplate">
            <Button Style="{StaticResource ChipButton}"
                    Command="{Binding DataContext.OpenPullRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Url}">
                <TextBlock Text="{Binding Number, StringFormat=PR {0}}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:WorkstreamCardViewModel}">
            <!--
                MinHeight is on the style so a folded card can drop it. Left at 96 the card would
                keep the height of its full self and fold to nothing worth looking at.
            -->
            <Border CornerRadius="8" Margin="0,0,0,8"
                    ToolTip="{Binding Workstream.WorkingDirectory}"
                    MouseLeftButtonUp="OnCardClicked">
                <!--
                    A card with no session takes the lane's own fill and sinks into the board; a
                    running one stays raised above it. Neither hue nor the border is available to say
                    this: the stripe is the workstream's permanent tab colour, and the border already
                    means selected.
                -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MinHeight" Value="96" />
                        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="MinHeight" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAdoptTarget}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        A working session flies a banner: the whole card takes its own tab colour,
                        and a band of light travels across it.

                        It replaced a stripe that faded from full to a third and back. That was the
                        only sign a session was working, it moved six pixels of a card, and it was
                        easy to miss across a full board.

                        The banner shows whenever the session is running; only the band's movement is
                        held back when the window is not in front or the machine has animation turned
                        off. A card that has stopped moving because you looked away must not also stop
                        looking busy.

                        It is declared first so it paints beneath the stripe and the text, and it is
                        in the template rather than in a shared style: a template gets a name scope
                        per card, so each card sweeps on its own clock.
                    -->
                    <Border x:Name="Banner" Grid.ColumnSpan="2" CornerRadius="8" ClipToBounds="True"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <!--
                                The tint carries its opacity on itself and not on the banner. Dimming
                                the banner would dim the band travelling over it in the same measure,
                                and the whole effect with it.
                            -->
                            <Rectangle Opacity="0.22"
                                       Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />

                            <Rectangle x:Name="Sheen" Width="180" HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="Sweep" X="-180" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <Border x:Name="Stripe" Grid.Column="0" CornerRadius="8,0,0,8"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!--
                        Folded: the title, the tick, and a way back. The tick stays because folding
                        is how you clear the board down to what is running before starting some of
                        the rest, and having to unfold a card to choose it would undo the point.
                    -->
                    <Grid Grid.Column="1" Margin="12,8,10,8"
                          Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  ToolTip="Include this card in Start selected and Stop selected" />

                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Button Grid.Column="2" Style="{StaticResource CommandButton}"
                                Padding="8,2" VerticalAlignment="Center"
                                ToolTip="Open this card again"
                                Click="OnExpandCard">
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,10,12,10"
                                Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                        <!--
                            The title has the card's full width and the buttons sit beneath it.

                            They shared a line, with the title keeping clear by a fixed margin that
                            guessed how wide the buttons were. Adding Archive made the guess wrong and
                            the title ran straight over Start. Widening the guess would only postpone
                            it, and there is no width that works: the cells of a grid are narrower
                            than the columns they replaced, and a title long enough to need reading is
                            exactly the one that gets trimmed to nothing.

                            So the two do not compete. The title is trimmed only by the card, and it
                            keeps its tooltip for what does not fit.
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                The tick is what a bulk Start or Stop acts on. It sits with the title
                                rather than with the buttons because it says what this card *is* to
                                the next gesture, not what to do with it now.
                            -->
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      ToolTip="Include this card in Start selected and Stop selected" />

                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                       ToolTip="{Binding Title}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Text="{Binding Lifecycle, Converter={StaticResource LifecycleGlyph}}"
                                       FontSize="16" ToolTip="{Binding StatusLine}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <Button Content="{Binding PrimaryAction}" FontSize="11" Padding="8,1" Margin="0,0,4,0"
                                        Visibility="{Binding IsLive, Converter={StaticResource NotBoolToVisibility}}"
                                        ToolTip="{Binding RestartCost}"
                                        Command="{Binding DataContext.StartCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <!--
                                    The other way to start. A context menu is not in the window's
                                    visual tree, so it cannot reach the window's commands by ancestor;
                                    the card carries its own, the way it carries Adopt.
                                -->
                                <Button Content="▾" FontSize="11" Padding="4,1" Margin="-3,0,4,0"
                                        Visibility="{Binding IsLive, Converter={StaticResource NotBoolToVisibility}}"
                                        ToolTip="Resume the last conversation, or start fresh from the handoff"
                                        Click="OnOverflowClick">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                  RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Resume the last conversation"
                                                      Command="{Binding ResumeCommand}"
                                                      ToolTip="{Binding ResumeTooltip}"
                                                      ToolTipService.ShowOnDisabled="True" />
                                            <MenuItem Header="Start fresh from the handoff"
                                                      Command="{Binding StartFreshCommand}"
                                                      ToolTip="{x:Static launching:StartModeChoice.FreshTooltip}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="Stop" FontSize="11" Padding="8,1" Margin="0,0,4,0"
                                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Ask this session to write a handoff and exit when its turn ends"
                                        Command="{Binding DataContext.StopCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Focus" FontSize="11" Padding="8,1" Margin="0,0,4,0"
                                        ToolTip="Bring this session's tab to the front"
                                        Command="{Binding DataContext.FocusCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <!--
                                    Archive is here and deleting is not. This one is reversible and
                                    is the everyday way to clear finished work off the board; the
                                    other destroys a plan file with no undo, and a destructive button
                                    one click from Start is a trap rather than a convenience.
                                -->
                                <Button Content="{Binding ArchiveLabel}" FontSize="11" Padding="8,1"
                                        ToolTip="Take this workstream off the board without losing anything. Restore it from Archived."
                                        Command="{Binding DataContext.ArchiveCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                        </StackPanel>

                        <!--
                            Only the first few issues. One workstream here spans sixteen, which wraps
                            to five rows of chips and makes its card taller than everything around it
                            - and on a grid that pushes the whole row out of shape, so one busy
                            workstream distorts the board. The rest are counted, and named in the
                            tooltip, and all of them are in the details where they are edited anyway.
                        -->
                        <WrapPanel Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding VisibleJiraKeys}"
                                          ItemTemplate="{StaticResource JiraKeyTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding MoreJiraKeys}" FontSize="11" Margin="2,2,0,4"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding AllJiraKeys}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding MoreJiraKeys, Converter={StaticResource NotEmptyToVisibility}}" />
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding PullRequests}"
                                      ItemTemplate="{StaticResource PullRequestTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   ToolTip="{Binding TodoSummary}"
                                   Text="{Binding TodoSummary}"
                                   Visibility="{Binding TodoSummary, Converter={StaticResource NotEmptyToVisibility}}" />

                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding StatusLine}" />

                        <!--
                            Which model the session is on, read off the end of its transcript - the
                            only place it is recorded, and the only thing that shows a switch made
                            part-way through. Shown for a stopped card too: worth knowing before a
                            restart.
                        -->
                        <TextBlock FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="The model this session is running, from the last turn in its transcript"
                                   Text="{Binding Model}"
                                   Visibility="{Binding Model, Converter={StaticResource NotEmptyToVisibility}}" />

                        <!--
                            Shown only when the card has been renamed under a running session. A tab
                            cannot be renamed once it is open, so the two disagree until the session
                            is restarted, and a discrepancy nobody explains reads as a fault.
                        -->
                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="{Binding RunningAs}"
                                   Text="{Binding RunningAs}"
                                   Visibility="{Binding RunningAs, Converter={StaticResource NotEmptyToVisibility}}" />

                        <!--
                            Coloured, unlike the other card lines, because this one is not a status:
                            it is the board saying two workstreams are about to tread on each other,
                            which nothing else on the card can see.
                        -->
                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Foreground="#D68910"
                                   ToolTip="{Binding Clash}"
                                   Text="{Binding Clash}"
                                   Visibility="{Binding Clash, Converter={StaticResource NotEmptyToVisibility}}" />

                        <Button Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="11" Padding="8,2"
                                Content="{Binding LostSessionName, StringFormat='Adopt the running &quot;{0}&quot;'}"
                                ToolTip="This workstream's session was restarted outside Theseus, so the board stopped following it"
                                Command="{Binding AdoptLostCommand}"
                                Visibility="{Binding LostSessionName,
                                             Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Only a session that is working moves. A session waiting for a reply is the one thing
                on the board asking for a person, and it stands out by being still among its moving
                neighbours.

                The trigger belongs to the template rather than to the stripe's style: an inline
                style is one object shared by every card, so a storyboard named inside it is shared
                too, and starting it for one card while stopping it for another leaves the movement
                on whichever card last held it. A template gets a name scope per card.
            -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Working">
                            <Storyboard>
                                <!--
                                    The band starts off the left edge and travels past the right. It
                                    runs to 560 rather than to the card's width because a card in a
                                    grid cell has no fixed width; the overshoot is clipped, and the
                                    quiet moment it leaves before the next pass is what makes this
                                    read as a ripple rather than a scanner.
                                -->
                                <DoubleAnimation Storyboard.TargetName="Sweep"
                                                 Storyboard.TargetProperty="X"
                                                 From="-180" To="560" Duration="0:0:2.6"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Working" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ColumnTemplate" DataType="{x:Type vm:ColumnViewModel}">
            <Border MinWidth="260" Margin="4" CornerRadius="8" Padding="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <!--
                        The cell does not repeat the stage name. It is written once across the top of
                        the board, and printing it again in every row is noise on a grid that already
                        has too much to say.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,6"
                          Visibility="{Binding Count, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{Binding Count}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Cards}"
                                  ItemTemplate="{StaticResource CardTemplate}"
                                  AllowDrop="True"
                                  Drop="OnColumnDrop"
                                  DragOver="OnColumnDragOver"
                                  Background="Transparent"
                                  MinHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <!--
                                    PreviewMouseWheel because a ScrollViewer marks the wheel handled
                                    whether or not it had anywhere to scroll. A cell that is not full
                                    would otherwise swallow every turn of the wheel over it, and the
                                    board behind it would never move - which is what a two-finger
                                    scroll over a card did.
                                -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True"
                                              Focusable="False"
                                              Padding="0,0,2,0"
                                              PreviewMouseWheel="OnCellMouseWheel"
                                              Background="{TemplateBinding Background}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!--
            One row of the board: an area, with a cell per stage.

            Collapsed, it keeps its header and a count per stage rather than disappearing. A row that
            vanished would hide the very thing somebody folded it away to see past - where the work
            in that area actually is.
        -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:BoardRowViewModel}">
            <Border Margin="0,0,0,6" CornerRadius="10" Padding="4"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <!--
                        The header is on the left and kept narrow. Width is the scarce dimension on
                        this board - it decides how many columns of text a tiled terminal gets - so
                        the row label takes as little of it as it can and still be read.
                    -->
                    <StackPanel DockPanel.Dock="Left" Width="104" Margin="6,8,4,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                    Padding="4,0" Margin="0,0,4,0" VerticalAlignment="Center"
                                    ToolTip="Fold this row away, or open it"
                                    Command="{Binding ToggleCommand}" />
                            <TextBlock Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Area}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   ToolTip="{Binding Area}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Summary}" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Cells}"
                                  ItemTemplate="{StaticResource ColumnTemplate}"
                                  Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>


        <DataTemplate x:Key="LiveSessionTemplate" DataType="{x:Type vm:LiveSessionViewModel}">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,20,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="on board" FontSize="10" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="{Binding IsAdopted, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding WorkingDirectory}" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusLine}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Focus" FontSize="11" Padding="10,2" Margin="0,0,6,0"
                                ToolTip="Bring this session's terminal to the front"
                                Command="{Binding DataContext.Sessions.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button x:Name="AdoptButton" Content="Adopt into…" FontSize="11" Padding="10,2"
                                ToolTip="Make a workstream follow this running session"
                                Visibility="{Binding IsAdopted, Converter={StaticResource NotBoolToVisibility}}"
                                Click="OnAdoptClicked">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding AdoptTargets}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Title}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource CommandButton}" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center"
                        ToolTip="Show or hide the live sessions panel"
                        Command="{Binding ToggleSessionsPanelCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Sessions.Status}" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CommandButton}" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center"
                        ToolTip="Show or hide the machine's locks: who holds each, and who is waiting"
                        Command="{Binding Locks.ToggleCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Locks.ButtonText}" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--
                    The notice is a sentence, not a label - "3 sessions were interrupted mid-turn
                    and handed the request" - so it is trimmed and carries its own tooltip rather
                    than pushing the buttons off the edge or running underneath them.
                -->
                <StackPanel>
                    <TextBlock Text="{Binding Board.Status}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Notice}" FontSize="12" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <!--
                    A command bar rather than a row of peers. Eleven controls had grown along the top,
                    every one of them the same size and weight, so starting every session on the board
                    read as no more consequential than reloading it. What stays out here is what is
                    used constantly or is worth the width; the rest is a click away under the overflow,
                    and the next thing added goes there rather than becoming a twelfth button.
                -->
                <Button Style="{StaticResource CommandButton}" Padding="12,4" Margin="0,0,12,0"
                        ToolTip="Create a workstream and open a session for it"
                        Command="{Binding NewWorkstream.OpenCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource CommandGlyph}" />
                        <TextBlock Text="New workstream" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--
                    Everything bulk goes through the ticks on the cards. There is no Start all, and
                    no Start for a row or a cell: those worked out what to start from where a card
                    sat, which is a guess about the board's shape, and it started paused work on any
                    board whose last column was not the only one to leave alone.
                -->
                <TextBlock Text="{Binding SelectionSummary}" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <!--
                    The three that change what is ticked, grouped the same way as the two that act on
                    it. "Unselect all" rather than "Clear": it is disabled whenever nothing is ticked,
                    so a word that does not pair with "Select all" reads as some other, unrelated
                    thing that happens to be greyed out.
                -->
                <Border CornerRadius="4" Margin="0,0,12,0" Padding="2"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CommandButton}" Padding="10,3" Margin="0,0,2,0"
                                ToolTip="Tick every card on the board"
                                Command="{Binding SelectAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73A;" Style="{StaticResource CommandGlyph}" />
                                <TextBlock Text="Select all" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CommandButton}" Padding="10,3" Margin="0,0,2,0"
                                ToolTip="Untick everything"
                                Command="{Binding ClearSelectionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE739;" Style="{StaticResource CommandGlyph}" />
                                <TextBlock Text="Unselect all" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CommandButton}" Padding="10,3"
                                ToolTip="Tick what is not ticked, and untick what is"
                                Command="{Binding InvertSelectionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEF1F;" Style="{StaticResource CommandGlyph}" />
                                <TextBlock Text="Invert" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Folding the board down to what is alive, and opening it again. -->
                <Border CornerRadius="4" Margin="0,0,12,0" Padding="2"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CommandButton}" Padding="10,3" Margin="0,0,2,0"
                                ToolTip="Fold every card with no session running down to its title"
                                Command="{Binding CollapseInactiveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70E;" Style="{StaticResource CommandGlyph}" />
                                <TextBlock Text="Collapse inactive" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CommandButton}" Padding="10,3"
                                ToolTip="Open every card again"
                                Command="{Binding ExpandAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70D;" Style="{StaticResource CommandGlyph}" />
                                <TextBlock Text="Expand all" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border CornerRadius="4" Margin="0,0,12,0" Padding="2"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CommandButton}" Padding="11,3" Margin="0,0,2,0"
                                ToolTip="Start the ticked cards that are not already running"
                                Command="{Binding StartSelectedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource CommandGlyph}" />
                                <TextBlock Text="Start selected" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CommandButton}" Padding="11,3"
                                ToolTip="Ask the ticked cards' running sessions to write a handoff and exit"
                                Command="{Binding StopSelectedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource CommandGlyph}" />
                                <TextBlock Text="Stop selected" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--
                    A button carrying a context menu rather than a Menu, for two reasons. A bare
                    MenuItem draws no button chrome, so the overflow read as three loose dots beside
                    real buttons; and FontFamily inherits, so the icon font it needed for its own
                    glyph descended into every item beneath it and rendered their labels as rows of
                    empty squares.
                -->
                <Button Style="{StaticResource CommandButton}" Padding="10,4" Margin="0,0,12,0"
                        Click="OnOverflowClick"
                        ToolTip="The rest of the board's commands">
                    <!--
                        The glyph sits in its own TextBlock rather than on the button. A context menu
                        is a logical child of the element that owns it, so an icon font set on the
                        button would reach the menu's labels just as surely as one set on a MenuItem.
                    -->
                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" />
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Day report…" Command="{Binding DayReport.OpenCommand}"
                                      ToolTip="What was worked on today, and which tabs are safe to close">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE787;" Style="{StaticResource MenuGlyph}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Arrange windows…" Command="{Binding Arrange.OpenCommand}"
                                      ToolTip="Tile, cascade or stack the terminal windows">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8A9;" Style="{StaticResource MenuGlyph}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Show archived" IsCheckable="True"
                                      IsChecked="{Binding Board.ShowArchived, Mode=TwoWay}"
                                      ToolTip="Show what has been put away instead of what is being worked on" />
                            <Separator />
                            <MenuItem StaysOpenOnClick="True">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE790;" Style="{StaticResource MenuGlyph}" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox ItemsSource="{Binding Source={StaticResource ThemeValues}}"
                                                  SelectedItem="{Binding Theme, Mode=TwoWay}"
                                                  Width="110" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!--
                    Icons, because a refresh arrow and a gear need no label, and three words of chrome
                    were taking the width of a card.
                -->
                <Button Style="{StaticResource CommandButton}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Padding="9,4" Margin="0,0,4,0"
                        ToolTip="Read the board and the running sessions again"
                        Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource CommandButton}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Padding="9,4" Margin="0,0,4,0"
                        ToolTip="Settings"
                        Command="{Binding Settings.OpenCommand}" />
                <Button Style="{StaticResource CommandButton}" Content="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Padding="9,4"
                        Command="{Binding Help.OpenCommand}"
                        ToolTip="What the buttons do, how starting and stopping work, and what to look at when one of them does nothing" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Left" Width="280" Margin="16,8,0,16" CornerRadius="10" Padding="10"
                Visibility="{Binding IsSessionsPanelOpen, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                    <TextBlock Text="Live sessions" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Sessions.Status}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Padding="6,2" Margin="8,0,0,0" ToolTip="Hide the live sessions panel"
                                Command="{Binding ToggleSessionsPanelCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions.Sessions}"
                                  ItemTemplate="{StaticResource LiveSessionTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!--
            The machine's locks, held by Theseus (Nigel, 2026-10-06), opened from the command bar like the
            live sessions panel and docked on the other side so both can be open. One card per lock, free
            or not. Reordering, cancelling and releasing happen here and nowhere else; Release asks twice,
            because it does not stop the holder's run and another may then start beside it.
        -->
        <Border DockPanel.Dock="Right" Width="340" Margin="0,8,16,16" CornerRadius="10" Padding="10"
                Visibility="{Binding Locks.IsOpen, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                    <TextBlock Text="Locks" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Padding="6,2" HorizontalAlignment="Right" ToolTip="Hide the locks panel"
                            Command="{Binding Locks.ToggleCommand}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Locks.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding HeldFor}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeld}" Value="False">
                                                                <Setter Property="Text" Value="free" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLong}" Value="True">
                                                                <Setter Property="Foreground" Value="#D68910" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Guards}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsHeld, Converter={StaticResource BoolToVisibility}}">
                                            <Border Margin="0,0,0,6" Padding="8,4" CornerRadius="4" BorderThickness="4,0,0,0"
                                                    BorderBrush="{Binding HolderColorHex, Converter={StaticResource HexToBrush}}">
                                                <StackPanel>
                                                    <TextBlock Text="Held by" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{Binding Holder}" FontSize="12.5" TextWrapping="Wrap" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Button Style="{StaticResource CommandButton}" Content="Release…" HorizontalAlignment="Left"
                                                    ToolTip="Take the lock from its holder. Its run keeps going."
                                                    Command="{Binding AskReleaseCommand}"
                                                    Visibility="{Binding CanAskRelease, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Visibility="{Binding IsConfirmingRelease, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Its run keeps going, and the next in line may start beside it." FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource CommandButton}" Content="Release" Margin="0,0,6,0"
                                                            Command="{Binding ConfirmReleaseCommand}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Keep"
                                                            Command="{Binding KeepCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding Waiting.Count, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Text="Waiting, in order" FontSize="11" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <ItemsControl ItemsSource="{Binding Waiting}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6"
                                                                BorderThickness="4,0,0,0"
                                                                BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                        <Run Text="waiting " />
                                                                        <Run Text="{Binding WaitingFor, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                                        <Run Text="{Binding Position, Mode=OneWay}" />
                                                                        <Run Text=". " />
                                                                        <Run Text="{Binding Who, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Purpose}" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding Reason}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                                                           Visibility="{Binding Reason, Converter={StaticResource NotEmptyToVisibility}}"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <Button Style="{StaticResource CommandButton}" Content="Up" Margin="0,0,4,0"
                                                                            ToolTip="Move one place towards the front"
                                                                            Command="{Binding MoveUpCommand}" />
                                                                    <Button Style="{StaticResource CommandButton}" Content="Down" Margin="0,0,4,0"
                                                                            ToolTip="Move one place back"
                                                                            Command="{Binding MoveDownCommand}" />
                                                                    <Button Style="{StaticResource CommandButton}" Content="Cancel"
                                                                            ToolTip="Take it out of the queue; its script is told it was cancelled"
                                                                            Command="{Binding CancelCommand}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="30" Padding="16,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <!--
                Two columns, because these two halves were sharing one cell and drawing over each
                other. Left-aligned content growing rightwards and right-aligned content growing
                leftwards meet in the middle and neither yields: the usage figures were being
                overwritten by whatever the right-hand side had grown to. A column apiece makes the
                right side take what it needs and the left side live in the remainder.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            ClipToBounds="True"
                            Visibility="{Binding Usage.HasReading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Usage.SessionText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Usage.WeeklyText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="  ·  " FontSize="12"
                               Visibility="{Binding Usage.BindingText, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Usage.BindingText}" FontSize="12"
                               Visibility="{Binding Usage.BindingText, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Usage.IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="#D68910" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="0" Text="{Binding Usage.Problem}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Usage.Problem, Converter={StaticResource NotEmptyToVisibility}}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Locks.Summary}" FontSize="11" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="The machine's shared locks, held by Theseus"
                               Visibility="{Binding Locks.Summary, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Locks.HasLongHold}" Value="True">
                                        <Setter Property="Foreground" Value="#D68910" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Version}" FontSize="11" Margin="12,0,14,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding VersionDescribed}"
                               Visibility="{Binding Version, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Account}" FontSize="11" Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               ToolTip="The Claude account every session on this machine runs as"
                               Visibility="{Binding Account, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Usage.Age}" FontSize="11" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button Content="↻" FontSize="12" Padding="8,0" ToolTip="Read usage now"
                            Command="{Binding Usage.RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <DockPanel Margin="8,0,8,8">
                <!--
                    Stops asked for before this Theseus opened wait for an answer here.

                    A request survives the board being closed on purpose - the session was asked to
                    stop, wrote its handoff, and nothing ever typed the exit - but finishing it
                    silently on the next launch closes sessions within a second of startup. Two of
                    Nigel's went that way on 2026-09-02, 0.8s after the window appeared.

                    It asks in place rather than in a message box, and names the sessions, which is
                    the same way deleting asks. Nothing happens until one of the two is pressed, so
                    the board stays usable and the question cannot fire before it has been read.
                -->
                <Border DockPanel.Dock="Top" Margin="4,0,4,8" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasUnconfirmedStops, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource CommandButton}" Content="Close them"
                                    Margin="0,0,6,0"
                                    ToolTip="Finish the stop: each session is told to exit"
                                    Command="{Binding ConfirmStopsCommand}" />
                            <Button Style="{StaticResource CommandButton}" Content="Leave them running"
                                    ToolTip="Drop the request and carry on"
                                    Command="{Binding AbandonStopsCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding UnconfirmedStopsSummary}" FontSize="12.5"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <!--
                    A Start that would open a second tab beside one already there asks first.

                    Sessions left in their tabs over a weekend had their Claude processes exit without
                    the tabs closing, so Monday's Start found nothing registered, resumed three of them,
                    and put a new tab beside each stale one with no sign which was which. Nothing was
                    registered, so every check the board had said go; the tab was the only evidence,
                    and nothing was looking at it.

                    Asked in place, naming them, like the stop strip above. The workstreams that had no
                    tab of their own started immediately - only the doubtful ones wait.
                -->
                <Border DockPanel.Dock="Top" Margin="4,0,4,8" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasHeldForTabs, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource CommandButton}" Content="Open new tabs"
                                    Margin="0,0,6,0"
                                    ToolTip="Start anyway, beside the tabs already open"
                                    Command="{Binding StartAnywayCommand}" />
                            <Button Style="{StaticResource CommandButton}" Content="Leave them"
                                    ToolTip="Do not start these; their existing tabs are yours to deal with"
                                    Command="{Binding KeepExistingTabsCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding HeldForTabsSummary}" FontSize="12.5"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <!--
                    The stage headings, written once. The left margin matches the width of a row's
                    header so the headings line up with the cells beneath them; both are fixed, and
                    they have to stay in step.
                -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Board.Stages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Board.Rows}"
                                  ItemTemplate="{StaticResource RowTemplate}" />
                </ScrollViewer>
            </DockPanel>

            <!-- Detail drawer -->
            <Border HorizontalAlignment="Right" Width="480" Margin="0,0,0,8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding Drawer.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="18,14,18,14">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Drawer.ColorHex, Converter={StaticResource HexToBrush}}"
                                    ToolTip="Permanent. A change applies from the next launch." />
                            <TextBlock Text="{Binding Drawer.Key}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <Button Content="Close" HorizontalAlignment="Right" Padding="12,3"
                                Command="{Binding Drawer.CloseCommand}" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <!--
                            Deleting asks in place rather than in a message box: the question names
                            what goes and what stays, which is more than a title bar and two buttons
                            can say, and the answer is one click from the thing it is about.
                        -->
                        <Border Visibility="{Binding Drawer.IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                Padding="10" CornerRadius="6" Margin="0,0,0,8"
                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Drawer.DeleteConsequence}" TextWrapping="Wrap" FontSize="11.5" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Keep it" Padding="12,3" Margin="0,0,8,0"
                                            Command="{Binding Drawer.CancelDeleteCommand}" />
                                    <Button Content="Delete for good" Padding="12,3"
                                            Command="{Binding Drawer.ConfirmDeleteCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Drawer.RemovalRefusal}" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding Drawer.IsLive, Converter={StaticResource BoolToVisibility}}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="{Binding Drawer.ArchiveLabel}" Padding="12,4" Margin="0,0,8,0"
                                        Command="{Binding Drawer.ArchiveCommand}"
                                        ToolTip="Hide this workstream without losing it. Restore it from Archived." />
                                <Button Content="Delete" Padding="12,4"
                                        Command="{Binding Drawer.DeleteCommand}"
                                        ToolTip="Destroy this workstream and its plan file. Its notes and its work are left alone." />
                            </StackPanel>
                            <Button Content="Save" HorizontalAlignment="Right" Padding="20,4"
                                    Command="{Binding Drawer.SaveCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding Drawer.PlanPath}" FontSize="10" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Drawer.PlanPath}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Drawer.Title, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Also the tab title. A tab cannot be renamed once it is open, so a running session keeps the name it started with until it is restarted." />

                            <TextBlock Text="Jira issues" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Drawer.JiraKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,70,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Button Content="Remove" FontSize="11" Padding="8,1"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.Drawer.RemoveJiraKeyCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <TextBox Text="{Binding Drawer.NewJiraKey, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,60,0" />
                                <Button Content="Add" HorizontalAlignment="Right" Padding="12,3"
                                        Command="{Binding Drawer.AddJiraKeyCommand}" />
                            </Grid>
                            <Button Content="{Binding Drawer.UnclaimedKeys.Count,
                                              StringFormat=Take {0} more from the prompt}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3" FontSize="11"
                                    Command="{Binding Drawer.RescanPromptCommand}"
                                    Visibility="{Binding Drawer.UnclaimedKeys.Count,
                                                 Converter={StaticResource CountToVisibility}}" />

                            <Button Content="Instructions and skills…" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" Padding="10,3" FontSize="11"
                                    ToolTip="Every CLAUDE.md, rule, skill, command and agent this workstream's sessions get, in the order they are read"
                                    Command="{Binding Instructions.OpenCommand}"
                                    CommandParameter="{Binding Drawer}" />

                            <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <TextBox Text="{Binding Drawer.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,80,0" />
                                <Button Content="Open" HorizontalAlignment="Right" Padding="12,3"
                                        Command="{Binding Drawer.OpenWorkingDirectoryCommand}" />
                            </Grid>
                            <TextBlock FontSize="11" Margin="0,4,0,0"
                                       Text="This directory is missing."
                                       Foreground="#CF5D61">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drawer.WorkingDirectoryExists}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Extra directories" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Drawer.AddDirectories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,70,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Button Content="Remove" FontSize="11" Padding="8,1"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.Drawer.RemoveDirectoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <TextBox Text="{Binding Drawer.NewDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,60,0" />
                                <Button Content="Add" HorizontalAlignment="Right" Padding="12,3"
                                        Command="{Binding Drawer.AddDirectoryCommand}" />
                            </Grid>

                            <TextBlock Text="First run only" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Drawer.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding Drawer.HasRun}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                            <TextBlock Text="{Binding Drawer.FirstRunHint}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <TextBlock Text="Every start" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Drawer.EveryStartPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Told to this workstream's sessions every time they start, after everything the board says. Use {handoff} for its notes." />

                            <Grid Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Order" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox Text="{Binding Drawer.BoardOrder, UpdateSourceTrigger=PropertyChanged}"
                                             Width="50" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox Content="Blocked" Margin="0,0,14,0"
                                              IsChecked="{Binding Drawer.IsBlocked}" />
                                    <CheckBox Content="Reopen tomorrow"
                                              IsChecked="{Binding Drawer.ReopenTomorrow}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Handover notes" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <TextBox Text="{Binding Drawer.StatusDocumentPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,70,0" />
                                <Button Content="Open" FontSize="11" Padding="10,2" HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding Drawer.OpenStatusDocumentCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding Drawer.HandoffDestination, StringFormat=Leave empty to use {0}}"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Text="Terminal window" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Drawer.WindowGroup, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Leave empty to follow the lane. Name a window here to put this workstream beside another one whatever lane it is in. It applies from the next launch — a running session stays in the window it started in." />

                            <TextBlock Text="Workflows" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding Drawer.Workflows.Count,
                                                    Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Drawer.Workflows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8" ToolTip="{Binding Summary}">
                                            <TextBlock Text="{Binding Headline}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Phases}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Phases,
                                                                    Converter={StaticResource NotEmptyToVisibility}}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Runs" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Drawer.Runs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="8,5" CornerRadius="4"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Started}" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="{Binding ShortSessionId, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Outcome, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Duration}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No runs recorded yet." FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Drawer.Runs.Count, Converter={StaticResource ZeroToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Background="#99000000"
                    Visibility="{Binding NewWorkstream.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                        CornerRadius="10" Padding="22"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Allocated automatically, and permanent once created"
                                    Background="{Binding NewWorkstream.ColourHex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="New workstream" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewWorkstream.Title, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding NewWorkstream.Key, StringFormat=plan file: {0}.json}"
                                   Style="{StaticResource FieldHint}" />

                        <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewWorkstream.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="This directory does not exist." FontSize="11" Margin="0,4,0,0"
                                   Foreground="#CF5D61">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewWorkstream.WorkingDirectoryExists}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            Where the card lands. Every new workstream used to appear in the first
                            cell whatever it was for, and had to be dragged where it belonged.
                        -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stage" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding NewWorkstream.Stages}"
                                          SelectedItem="{Binding NewWorkstream.Stage, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding NewWorkstream.HasAreas, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Area" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding NewWorkstream.Areas}"
                                          SelectedItem="{Binding NewWorkstream.Area, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="Which cell of the board the card starts in. It can be dragged anywhere afterwards." />

                        <TextBlock Text="Opening prompt" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewWorkstream.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />

                        <Grid Margin="0,18,0,0">
                            <CheckBox Content="Open a tab now" VerticalAlignment="Center"
                                      IsChecked="{Binding NewWorkstream.StartNow}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Padding="18,5" Margin="0,0,8,0"
                                        Command="{Binding NewWorkstream.CloseCommand}" />
                                <Button Content="Create" Padding="18,5"
                                        Command="{Binding NewWorkstream.CreateCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </DockPanel>
</Window>
