<Window x:Class="Theseus.App.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <StackPanel Margin="{DynamicResource DialogGutter}">
        <TextBlock x:Name="Question" TextWrapping="Wrap" />
        <!-- The actions on the left, Cancel on the right (W9); Cancel is the default, so Enter does only what Esc does (W12). -->
        <StackPanel x:Name="Footer" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="ActionButton" Style="{DynamicResource DialogButton}" Click="OnAction" />
            <Button x:Name="SecondActionButton" Style="{DynamicResource DialogButton}" Margin="8,0,0,0" Click="OnSecondAction" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Style="{DynamicResource DialogButton}"
                    Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
