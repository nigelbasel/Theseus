<Window x:Class="Theseus.App.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="720" Height="520" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- One row per item, sparse, each ticked to begin with; the foot says what the press will do (Nigel, 2026-11-23). -->
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,14" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="FootText" DockPanel.Dock="Left" Text="{Binding Foot}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
            <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="{Binding ConfirmLabel}" MinWidth="110" IsDefault="True"
                    IsEnabled="{Binding CanConfirm}" Click="OnConfirm" />
        </DockPanel>
        <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay}" Margin="0,8" VerticalContentAlignment="Top"
                                      AutomationProperties.Name="{Binding Label}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
