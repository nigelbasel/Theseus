<Window x:Class="Theseus.App.InstructionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instructions and skills"
        Width="820"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <!--
            One line per file or skill. Imports are indented under the file that imports them, and
            anything a session will not actually get - a skill that loses its name, a file that is
            never read - is faded rather than hidden, because seeing why something does not apply is
            the point of looking.
        -->
        <DataTemplate x:Key="RowTemplate">
            <Border Padding="0,7" Margin="{Binding Indent}" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Badge}" FontSize="11" Margin="0,2,10,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="12"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Open" Padding="10,2" FontSize="11" Margin="10,0,0,0"
                            VerticalAlignment="Top"
                            ToolTip="Open this file in VS Code"
                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Path}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Instruction files never override one another: every one is read, broadest first, so a file nearer the work is read later. Skills, commands and agents do override by name. Worked out from Claude Code's documentation; /context in a session shows what actually loaded." />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <CheckBox Content="List plugin skills, commands and agents too" VerticalAlignment="Center"
                          IsChecked="{Binding ShowPluginItems, Mode=TwoWay}"
                          ToolTip="Plugins can bring hundreds. Each is prefixed with its plugin's name, so none of them takes another's." />
                <Button Content="Close" Padding="18,5" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                        Command="{Binding CloseCommand}" />
            </Grid>
        </Border>

        <TabControl Margin="12,10,12,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="Instruction files">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                    <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource RowTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Skills, commands and agents">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                    <ItemsControl ItemsSource="{Binding Commands}" ItemTemplate="{StaticResource RowTemplate}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
