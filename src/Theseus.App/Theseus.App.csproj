<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Theseus.App</RootNamespace>
    <AssemblyName>Theseus</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\theseus.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    The interop structs are internal so their marshalled layout can be asserted. An INPUT that is
    32 bytes instead of 40 is accepted silently by SendInput and types nothing, which cost this
    project two wrong diagnoses; a size is the only thing that catches it.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Theseus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\theseus.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Theseus.Core\Theseus.Core.csproj" />
    <ProjectReference Include="..\Theseus.Launcher\Theseus.Launcher.csproj" />
    <ProjectReference Include="..\Theseus.Hook\Theseus.Hook.csproj" />
  </ItemGroup>

  <!--
    The shim is a separate executable that Windows Terminal starts in each tab, so it must sit next
    to the application. A project reference alone copies only the managed assembly, not the apphost.
  -->
  <Target Name="CopyLauncherHost" AfterTargets="Build">
    <ItemGroup>
      <LauncherHost Include="$(MSBuildThisFileDirectory)..\Theseus.Launcher\bin\$(Configuration)\net11.0\Theseus.Launcher.exe" />
      <LauncherHost Include="$(MSBuildThisFileDirectory)..\Theseus.Hook\bin\$(Configuration)\net11.0\Theseus.Hook.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(LauncherHost)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(LauncherHost.FullPath)')" />
  </Target>

</Project>
