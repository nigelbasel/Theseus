<Window x:Class="Theseus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Theseus.App.ViewModels"
        xmlns:controls="clr-namespace:Theseus.App.Controls"
        xmlns:converters="clr-namespace:Theseus.App.Converters"
        xmlns:local="clr-namespace:Theseus.App"
        xmlns:views="clr-namespace:Theseus.App.Views"
        xmlns:behaviors="clr-namespace:Theseus.App.Behaviors"
        xmlns:settings="clr-namespace:Theseus.Core.Settings;assembly=Theseus.Core"
        xmlns:launching="clr-namespace:Theseus.Core.Launching;assembly=Theseus.Core"
        xmlns:ci="clr-namespace:Theseus.Core.CiStatus;assembly=Theseus.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        AllowsTransparency="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="Manual"
        Icon="Assets/theseus.ico"
        Title="Theseus" Height="760" Width="1400" MinHeight="480" MinWidth="720">

    <!-- The busy cursor while Refresh runs, over every control's own cursor (board-small-changes item 1, Nigel, 2026-11-26). -->
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Refreshing.IsBusy}" Value="True">
                    <Setter Property="Cursor" Value="Wait" />
                    <Setter Property="ForceCursor" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NextPaneCommand}" Executed="OnNextPane" />
        <CommandBinding Command="{x:Static local:MainWindow.PreviousPaneCommand}" Executed="OnPreviousPane" />
        <CommandBinding Command="{x:Static local:MainWindow.FindCardsCommand}" Executed="OnFindCards" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewInContextCommand}" />
        <!-- The one Board / Projects toggle, and All projects before the projects' Ctrl+1 to Ctrl+9 (project-view-as-tabs AC 3, 5). -->
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleViewCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding OpenAllProjectsCommand}" />
        <!-- Ctrl+J, not Ctrl+D, which is Delete's standard key (W27, B6). -->
        <KeyBinding Gesture="Ctrl+J" Command="{Binding DayReport.OpenCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Ctrl+I" Command="{Binding InvertSelectionCommand}" />
        <!-- The panels take F7 to F9, so that Ctrl+1 to Ctrl+9 mean the project tabs only, as in a browser (W27, B7). -->
        <KeyBinding Gesture="F7" Command="{Binding ToggleSessionsPanelCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding Locks.ToggleCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding Chains.ToggleCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectProjectTabCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectProjectTabCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectProjectTabCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding SelectProjectTabCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding SelectProjectTabCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Ctrl+D6" Command="{Binding SelectProjectTabCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Ctrl+D7" Command="{Binding SelectProjectTabCommand}" CommandParameter="7" />
        <KeyBinding Gesture="Ctrl+D8" Command="{Binding SelectProjectTabCommand}" CommandParameter="8" />
        <KeyBinding Gesture="Ctrl+D9" Command="{Binding SelectProjectTabCommand}" CommandParameter="9" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextProjectTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousProjectTabCommand}" />
        <KeyBinding Gesture="F6" Command="{x:Static local:MainWindow.NextPaneCommand}" />
        <KeyBinding Gesture="Shift+F6" Command="{x:Static local:MainWindow.PreviousPaneCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding Settings.OpenCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding Help.OpenCommand}" />
        <KeyBinding Gesture="Alt+Enter" Command="{Binding PropertiesCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
        <!-- The search's keys (card-search-and-tags item 6); Ctrl+F and / are handled in OnWindowPreviewKeyDown. -->
        <KeyBinding Gesture="F3" Command="{Binding NextMatchCommand}" />
        <KeyBinding Gesture="Shift+F3" Command="{Binding PreviousMatchCommand}" />
        <!-- Back and Forward through the places visited in project views (I46). -->
        <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding GoForwardCommand}" />
        <!-- Ctrl+L: a free Ctrl+letter key for a wide-scope command (G77), "lead" (git-22, 2026-11-24). -->
        <KeyBinding Gesture="Ctrl+L" Command="{Binding FocusLeadCommand}" />
        <!-- Ctrl+K: a free Ctrl+letter key for a wide-scope command (G77), Show active only (Nigel, 2026-11-24). -->
        <KeyBinding Gesture="Ctrl+K" Command="{Binding Board.ToggleActiveOnlyCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!--
            CommandButton, ToolButton, ToolIcon, ToolIconToggle, ChipButton and ClickableCard come from
            Themes/Interactive.xaml through App.xaml, so their hover, pressed, disabled and focus looks are
            defined once (1.1e AC 6b).
        -->

        <!--
            The icon font is set on the glyph itself and never on anything that contains text.
            FontFamily inherits, so a command bar carrying its icon on the parent turns every label
            below it into a row of empty squares.
        -->
        <!-- A menu's icon: 16, the menus' glyph size (W22, G53), in the theme's icon font (W24). -->
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            A menu item or toolbar button that stays in place when it does not apply, greyed, and says why (W13, W31; G61,
            G157): its Tag is the tooltip while it is enabled, controls:OffReason.Text while it is not. A local ToolTip
            would hide the reason, so items with this style carry their tooltip in Tag.
        -->
        <Style x:Key="ExplainsWhenOff" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="{Binding (controls:OffReason.Text), RelativeSource={RelativeSource Self}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One choice of a set, marked by a bullet while chosen, each set between separators (W32, G54, C12). -->
        <Style x:Key="RadioMenuItem" TargetType="MenuItem" BasedOn="{StaticResource ExplainsWhenOff}">
            <Style.Triggers>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource CompactRadioItem}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            A menu item that acts on the board's cards: in the project view it is greyed with its reason rather than live and
            doing nothing, and the menu keeps its shape (project-view-as-tabs AC 9).
        -->
        <Style x:Key="BoardOnlyItem" TargetType="MenuItem" BasedOn="{StaticResource ExplainsWhenOff}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProjectViewShown}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="These act on the board's cards. Go to the board with Board (Ctrl+B)." />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BoardOnlyRadio" TargetType="MenuItem" BasedOn="{StaticResource RadioMenuItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProjectViewShown}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="These act on the board's cards. Go to the board with Board (Ctrl+B)." />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A disabled menu item's reason on a second, dimmer line, for the items whose label never changes (W30). -->
        <Style x:Key="MenuReasonLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ExplainsWhenOffTool" TargetType="Button" BasedOn="{StaticResource ToolIcon}">
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="{Binding (controls:OffReason.Text), RelativeSource={RelativeSource Self}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A toolbar command a new user looks for, with its name to the right of its icon (W34, G38, C7). -->
        <Style x:Key="LabelledTool" TargetType="Button" BasedOn="{StaticResource ExplainsWhenOffTool}">
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <!-- The name beside a toolbar icon: the UI font, since the button's own font is the icon font. -->
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!--
            Menu items at desktop density. The Fluent theme spaces them for touch, which Nigel found
            wider than menus normally are.
        -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource CompactTopLevelHeader}" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource CompactTopLevelItem}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource CompactSubmenuHeader}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource CompactSubmenuItem}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One row of such a drop-down: the id and title, opening it when chosen. -->
        <Style x:Key="ItemRow" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Display, Converter={StaticResource AccessKeyEscape}}" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
        </Style>

        <!-- A status row (pr-ci-status): one with nothing to open is disabled, and still says why when hovered. -->
        <Style x:Key="StatusRow" TargetType="MenuItem" BasedOn="{StaticResource ItemRow}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <!--
            One item of the Project menu (project-view AC 4): a project opens its slugs, which use this style in turn.
            An unreadable project is listed disabled, its reason in the tooltip.
        -->
        <Style x:Key="ProjectChoiceItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="IsCheckable" Value="{Binding IsCheckable}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="ItemsSource" Value="{Binding Children}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource ProjectChoiceItem}" />
        </Style>

        <!--
            A card's own buttons: the toolbar's flat icon button, 32 by 32 from ToolButton's minimum (W38, G112), with the
            glyph at 16 (W22). Each sits 4 from the next in its group, and 8 before Archive and More.
        -->
        <Style x:Key="CardIcon" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- A panel's or the status bar's small icon button: ToolButton's 32 by 32, glyph at 16 (W22, W38). -->
        <Style x:Key="PanelIcon" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- An item of the side panel's Locks | Chains selector bar: the shared selector bar item, 32 high (W15, W56). -->
        <Style x:Key="PanelSwitchItem" TargetType="RadioButton" BasedOn="{StaticResource SelectorBarItem}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- A pane's resizable edge: an 8 epx hit area with the pane's own 1 px border as the visible line (W38, W39). -->
        <Style x:Key="PaneEdge" TargetType="controls:PaneResizeThumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:PaneResizeThumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Focus brings a session's window forward; while the card has none, it says so on hover, disabled (W13, G157). -->
        <Style x:Key="FocusCardIcon" TargetType="Button" BasedOn="{StaticResource CardIcon}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTip" Value="Focus: bring the session's window forward." />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="No session to bring forward: it opens when the card is started." />
                    <Setter Property="AutomationProperties.HelpText" Value="No session to bring forward: it opens when the card is started." />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FocusCardButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTip" Value="Focus: bring the session's window forward." />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="No session to bring forward: it opens when the card is started." />
                    <Setter Property="AutomationProperties.HelpText" Value="No session to bring forward: it opens when the card is started." />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A project card's fold chevron shows its state, as a row's does (W25): down while open, right while folded; named for what it does (E9). -->
        <Style x:Key="CardFoldButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Content" Value="&#xE70D;" />
            <Setter Property="ToolTip" Value="Fold card: fold this project card down to its title." />
            <Setter Property="AutomationProperties.Name" Value="Fold card" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter Property="Content" Value="&#xE76C;" />
                    <Setter Property="ToolTip" Value="Unfold card: open this project card again." />
                    <Setter Property="AutomationProperties.Name" Value="Unfold card" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A board row's fold chevron: an icon button whose name follows its state (E9, G167). -->
        <Style x:Key="RowFoldButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="AutomationProperties.Name" Value="Fold row" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="Unfold row" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            A fold's header line on the locks panel (Nigel, 2026-11-26): the whole line toggles, its chevron in a 24 epx hit
            area drawn as the Chains panel's (E76C folded, E70D open), Right and Left unfold and fold, as in a tree (1.9).
        -->
        <Style x:Key="LockFold" TargetType="controls:FoldToggle">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:FoldToggle">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" Background="Transparent" VerticalAlignment="Top">
                                    <controls:GlyphText x:Name="Chevron" Text="&#xE76C;" FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A panel's button: stays pressed while its panel is open, and is wider for its count. -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}" />
        </Style>

        <!-- A panel button's glyph: 20, the toolbar's glyph size (W22, G41), in the theme's icon font (W24). -->
        <Style x:Key="ToolGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A panel button's count: a pill over the accent, its text in the theme's text-on-accent brush (C5, E1). -->
        <Style x:Key="ToolBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="-4,0,4,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>

        <!-- A count over its icon's top-right corner, so the button keeps the icon's width with or without one (Nigel, 2026-11-24). -->
        <Style x:Key="OverlayToolBadge" TargetType="Border" BasedOn="{StaticResource ToolBadge}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-4,-8,0" />
        </Style>

        <!-- An urgent count: the caution wash and text, and a ⚠ before the number, never the colour alone (E5, W46, G161). -->
        <Style x:Key="UrgentToolBadge" TargetType="Border" BasedOn="{StaticResource ToolBadge}">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CautionTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionTextBrush}" />
        </Style>

        <Style x:Key="ToolSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!-- A card's drop-down for its Jira issues or pull requests. -->
        <Style x:Key="ItemDropDown" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>



        <!--
            The font is set here because a context menu is a logical child of the element that owns it
            and inherits its font: owned by the ⋯ icon button, it drew every label in the icon font.
        -->
        <!--
            A tag on a card (card-search-and-tags item 11): a small rounded label outlined in the tag's colour over a light
            wash of it, readable in both themes. It is a button: clicking it filters the board by the tag (item 12).
        -->
        <converters:FormatConverter x:Key="TagToolTip" />
        <Style x:Key="TagChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Face">
                            <Border x:Name="Wash" CornerRadius="8" Opacity="0.16"
                                    Background="{Binding ColourHex, Converter={StaticResource HexToWash}}" />
                            <Border CornerRadius="8" BorderThickness="1" Padding="8,0,8,0"
                                    BorderBrush="{Binding ColourHex, Converter={StaticResource HexToBrush}}">
                                <ContentPresenter x:Name="Label" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.6" />
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Wash" Property="Opacity" Value="0" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One item of Tags ›: the tag with its tick and a dot of its colour, or New tag… (item 10). The header is access
            text: New tag… has its key, and a tag's own underscores come escaped from BoardTags (C9, B12).
        -->
        <Style x:Key="TagMenuItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <!-- A template, not an Icon: one Icon element set by a style is shared, so only one item could show its dot (review T3). -->
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding ColourHex, Converter={StaticResource HexToSwatch}}"
                                     Visibility="{Binding IsTag, Converter={StaticResource BoolToVisibility}}" />
                            <AccessText Text="{Binding Header}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A card's menu: the start choices, its marks, and Spawn follow-on. One resource, used by the
            ▾ beside Start and by a right-click anywhere on the card, which is where a Windows user
            looks for a thing's options. Not shared, so each card gets its own instance.

            Its labels never change with the card's state (W30, G62): each pair is two items, and the one that does not
            apply is removed. The access keys follow W26 and are unique, removed items included (C9, B11). Properties keeps
            its r, as in the Edit menu, so Resume takes the l of "last".
        -->
        <ContextMenu x:Key="CardMenu" x:Shared="False" Opened="OnCardMenuOpened"
                     FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="P_roperties" InputGestureText="Alt+Enter" FontWeight="SemiBold"
                      Command="{Binding PropertiesCommand}"
                      ToolTip="Rename it, edit its setup, its Jira keys, its links, or delete it." />
            <MenuItem Header="_Duties…" Command="{Binding DutiesCommand}"
                      ToolTip="The instructions Theseus gives this card on a cadence: run, pause, change or add them." />
            <Separator />
            <MenuItem Header="Resume the _last conversation"
                      Command="{Binding ResumeCommand}"
                      ToolTip="{Binding ResumeTooltip}"
                      ToolTipService.ShowOnDisabled="True"
                      Visibility="{Binding IsLive, Converter={StaticResource NotBoolToVisibility}}" />
            <MenuItem Header="Start _fresh from the handoff"
                      Command="{Binding StartFreshCommand}"
                      ToolTip="{x:Static launching:StartModeChoice.FreshTooltip}"
                      Visibility="{Binding IsLive, Converter={StaticResource NotBoolToVisibility}}" />
            <Separator Visibility="{Binding IsLive, Converter={StaticResource NotBoolToVisibility}}" />
            <MenuItem Header="_Pause" Command="{Binding MenuPauseCommand}" ToolTip="{Binding PauseTooltip}"
                      Visibility="{Binding IsPaused, Converter={StaticResource NotBoolToVisibility}}">
                <MenuItem.Icon><controls:GlyphText Text="&#xE769;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Unpause" Command="{Binding MenuPauseCommand}" ToolTip="{Binding PauseTooltip}"
                      Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Icon><controls:GlyphText Text="&#xE768;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="E_xit session" Command="{Binding CloseNowCommand}"
                      ToolTip="Type /exit into this session once more. Brings its terminal to the front."
                      Visibility="{Binding CanCloseNow, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="_Block" Command="{Binding ToggleBlockedCommand}"
                      ToolTip="Blocked means waiting on something outside your control. A mark on the card: it keeps its stage."
                      Visibility="{Binding IsBlocked, Converter={StaticResource NotBoolToVisibility}}" />
            <MenuItem Header="Unbloc_k" Command="{Binding ToggleBlockedCommand}"
                      ToolTip="Take the blocked mark off. The card keeps its stage."
                      Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Reopen to_morrow" IsChecked="{Binding ReopenTomorrow, Mode=OneWay}"
                      Command="{Binding ToggleReopenTomorrowCommand}"
                      ToolTip="Include this workstream when the whole board is started." />
            <Separator />
            <!-- Headless runs (Nigel, 2026-11-24): how the card runs, its output, a tab on its conversation, and its breaker. -->
            <MenuItem Header="Headle_ss" ToolTip="How this card runs, its headless run's output, a tab on its conversation, and its breaker.">
                <MenuItem Header="Run _mode" ToolTip="Whether this card's session opens in a tab or runs headless, with no tab.">
                    <MenuItem Header="_Tab" IsChecked="{Binding RunsInTabByChoice, Mode=OneWay}"
                              Command="{Binding RunInTabCommand}" ToolTip="Open its session in a Windows Terminal tab, for work you are watching." />
                    <MenuItem Header="_Headless" IsChecked="{Binding RunsHeadlessByChoice, Mode=OneWay}"
                              Command="{Binding RunHeadlessCommand}"
                              ToolTip="Run its session with no tab, inside its budget; its output is on the card and under Output…." />
                    <MenuItem Header="_Project default" IsChecked="{Binding RunsByDefault, Mode=OneWay}"
                              Command="{Binding RunByDefaultCommand}"
                              ToolTip="Take its project's run mode; with none, verifiers and scenario writers run headless and the rest in a tab." />
                </MenuItem>
                <MenuItem Header="Outp_ut…" Command="{Binding ShowOutputCommand}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="What its headless run has written, followed while it goes." />
                <MenuItem Header="Open in a _tab" Command="{Binding OpenInTabCommand}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="End its headless run now and resume the same conversation in a tab. The card runs in a tab from then on." />
                <MenuItem Header="Reset _breaker" Command="{Binding ResetBreakerCommand}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="Clear its tripped breaker: it is unpaused if the breaker paused it, and its count of failed runs starts again." />
            </MenuItem>
            <Separator />
            <MenuItem Header="_Tags" ItemsSource="{Binding TagMenu}" ItemContainerStyle="{StaticResource TagMenuItem}"
                      ToolTip="Put a tag on this card, or the selected cards, or take one off." />
            <Separator />
            <MenuItem Header="Spa_wn follow-on…"
                      Command="{Binding SpawnFollowOnCommand}"
                      ToolTip="Create a new card this one hands over to, in the same working directory." />
            <MenuItem Header="Re_name handover to match title" Command="{Binding RenameHandoffCommand}"
                      ToolTip="{Binding HandoffRenameToolTip}"
                      Visibility="{Binding HandoffRenameTo, Converter={StaticResource NotEmptyToVisibility}}" />
            <MenuItem Command="{Binding VerifyWithHoldoutsCommand}" ToolTipService.ShowOnDisabled="True"
                      ToolTip="{Binding VerifyToolTip}">
                <MenuItem.Header>
                    <StackPanel>
                        <AccessText Text="Independent c_heck…" />
                        <TextBlock Text="{Binding VerifyOffReason}" Style="{StaticResource MenuReasonLine}"
                                   Visibility="{Binding VerifyOffReason, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Add to project…" Command="{Binding AddToProjectCommand}" ToolTipService.ShowOnDisabled="True"
                      ToolTip="Add this card to a project: a row naming it under one of the project's objectives in its project.md. Needs a projects folder; not for a card already in a project." />
            <MenuItem Header="R_emove from project" Command="{Binding RemoveFromProjectCommand}" ToolTipService.ShowOnDisabled="True"
                      ToolTip="Take this card's rows out of its project's project.md. Its records in the project's work folder are kept." />
            <MenuItem Header="_Convert to project…" Command="{Binding ConvertToProjectCommand}" ToolTipService.ShowOnDisabled="True"
                      ToolTip="Start a new project with this card as its first workstream, and its handoff as the project's first record." />
        </ContextMenu>

        <!--
            A project on the board (project-view AC 12, 14; 1.1d AC 38 to 44): unmistakably a project, by a stripe and the
            stacked-card mark in its own colour and the word PROJECT, as in the project view's summary; then where it is,
            in the view's sentence and counts. Selected, dragged, started and stopped as a card is; the accent border means
            selected, as on a card. Double-click, Enter or Open on its menu opens the project view. A dimmed card (its
            project.md does not read) keeps its mark, colour and reason, and has no ▶ or ■.
        -->
        <DataTemplate x:Key="ProjectCardTemplate" DataType="{x:Type vm:ProjectCardViewModel}">
            <Border x:Name="ProjectFace" Tag="ProjectCard" CornerRadius="4" Margin="0,0,0,8"
                    Focusable="True"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    ToolTip="{Binding ToolTipText}" Opacity="{Binding CardOpacity}"
                    AutomationProperties.Name="{Binding Title, StringFormat=Project {0}}"
                    MouseLeftButtonDown="OnProjectCardMouseDown"
                    MouseLeftButtonUp="OnProjectCardClicked"
                    PreviewMouseRightButtonDown="OnProjectCardRightButtonDown">
                <Border.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding OpenCommand}" />
                    <KeyBinding Key="Space" CommandParameter="{Binding}"
                                Command="{Binding DataContext.Board.KeySelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <KeyBinding Key="Space" Modifiers="Control" CommandParameter="{Binding}"
                                Command="{Binding DataContext.Board.KeyToggleSelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ClickableCard}">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu FontFamily="{x:Static SystemFonts.MessageFontFamily}" Opened="OnCardMenuOpened">
                        <MenuItem Header="_Open" FontWeight="SemiBold" Command="{Binding OpenCommand}"
                                  ToolTip="{Binding OpenToolTip}"
                                  Visibility="{Binding IsDimmed, Converter={StaticResource NotBoolToVisibility}}" />
                        <MenuItem Header="_Update" FontWeight="SemiBold" Command="{Binding OpenCommand}"
                                  ToolTip="{Binding OpenToolTip}"
                                  Visibility="{Binding IsDimmed, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="_Not a project" Command="{Binding HideCommand}"
                                  ToolTip="Hide this folder's card: it is not a project. Tools &gt; Options lists it, to show it again."
                                  Visibility="{Binding IsDimmed, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="_Start" Command="{Binding StartCommand}" ToolTip="{Binding StartToolTip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  Visibility="{Binding ShowsRunButtons, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="S_top the project…" Command="{Binding StopCommand}" ToolTip="{Binding StopToolTip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  Visibility="{Binding ShowsRunButtons, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Icon><TextBlock Text="&#xE71A;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="T_ags" ItemsSource="{Binding TagMenu}" ItemContainerStyle="{StaticResource TagMenuItem}"
                                  ToolTip="Put a tag on this card, or the selected cards, or take one off." />
                        <MenuItem Header="Open project._md" Command="{Binding OpenFileCommand}"
                                  ToolTip="Open the project's file in its editor."
                                  Visibility="{Binding IsDimmed, Converter={StaticResource NotBoolToVisibility}}" />
                        <MenuItem Header="Add o_bjective…" Command="{Binding AddObjectiveCommand}"
                                  Visibility="{Binding IsDimmed, Converter={StaticResource NotBoolToVisibility}}"
                                  ToolTip="Add an objective at the end of the current phase in project.md." />
                        <MenuItem Header="_Duties…" Command="{Binding DutiesCommand}"
                                  Visibility="{Binding IsDimmed, Converter={StaticResource NotBoolToVisibility}}"
                                  ToolTip="The instructions Theseus gives this project's cards on a cadence: run, pause, change or add them." />
                        <Separator />
                        <!-- Close and Archive are the owner's alone (archive-a-project); each asks once, so no ellipsis (W17). -->
                        <MenuItem Header="C_lose project" Command="{Binding CloseCommand}"
                                  Visibility="{Binding IsOpenProject, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Stop its cards after their handover, pause its duties and queue, and put it under Archived until you reopen it." />
                        <MenuItem Header="Arc_hive project" Command="{Binding ArchiveCommand}"
                                  Visibility="{Binding IsOpenProject, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="As Close, and archive its cards too. project.md and its records stay where they are." />
                        <MenuItem Header="Reop_en project" Command="{Binding ReopenCommand}" FontWeight="SemiBold"
                                  Visibility="{Binding IsPutAway, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Put it back on the board as it was: its duties, its queue and its archived cards. Nothing starts." />
                        <Separator />
                        <MenuItem Header="Project p_roperties" Command="{Binding PropertiesCommand}"
                                  ToolTip="Its title, its colour, its tags and its project.md; the colour can be changed here." />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ProjectStripe" Grid.Column="0" CornerRadius="4,0,0,4"
                            Background="{Binding ColourHex, Converter={StaticResource HexToBrush}}" />

                    <StackPanel Grid.Column="1" Margin="12,8,12,8">
                        <DockPanel>
                            <!-- Folds the project card to this row, as a card folds (Nigel, 2026-11-24). -->
                            <Button x:Name="ProjectFold" DockPanel.Dock="Right" Style="{StaticResource CardFoldButton}" Margin="8,0,0,0"
                                    Click="OnFoldProjectCard" />
                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,0" MinWidth="20" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource StateWaitingSoftBrush}"
                                    ToolTip="{Binding WaitingText}"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding CountText}" AutomationProperties.Name="{Binding WaitingText}" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <controls:StackedCardMark x:Name="ProjectMark" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Foreground="{Binding ColourHex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock x:Name="ProjectTag" DockPanel.Dock="Right" Text="Project" Style="{StaticResource TagText}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProjectTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       controls:HighlightedText.Text="{Binding Title}" controls:HighlightedText.Spans="{Binding TitleHighlights}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" behaviors:TrimmedToolTip.IsEnabled="True"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                        <StackPanel x:Name="ProjectBody"
                                    Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                            <!-- A search that matches its cards says so, since they are not on the board (card-search-and-tags item 7). -->
                            <TextBlock x:Name="ProjectMatchesInside" Text="{Binding MatchesInsideText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                       ToolTip="Open the project to see its matching pieces of work highlighted."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding MatchesInsideText, Converter={StaticResource NotEmptyToVisibility}}" />
                            <!-- Its tags, at most three then "+2"; clicking one filters the board by it (card-search-and-tags items 11, 12). -->
                            <WrapPanel x:Name="ProjectTags" Margin="0,4,0,0" Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl AutomationProperties.Name="Tags" ItemContainerStyle="{StaticResource ItemNamedByLabel}" ItemsSource="{Binding TagChips}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TagChipButton}" Content="{Binding Label, Converter={StaticResource AccessKeyEscape}}" ToolTip="{Binding ToolTip}"
                                                    AutomationProperties.Name="{Binding ToolTip}"
                                                    Command="{Binding FilterCommand}" CommandParameter="{Binding Tag}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreTags}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"
                                           ToolTip="{Binding MoreTagsToolTip}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding MoreTags, Converter={StaticResource NotEmptyToVisibility}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding PhaseText}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PhaseText}" behaviors:TrimmedToolTip.IsEnabled="True"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding ObjectivesText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <!-- Where it is, on one line: the view's sentence, whole in its tooltip (1.1d AC 39). -->
                            <TextBlock x:Name="ProjectSentence" Text="{Binding Sentence}" FontSize="12" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Sentence}" behaviors:TrimmedToolTip.IsEnabled="True"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding HasSentence, Converter={StaticResource BoolToVisibility}}" />
                            <!-- A closed or archived project says so, and how to bring it back (archive-a-project). -->
                            <DockPanel x:Name="ProjectClosed" Margin="0,4,0,0"
                                       Visibility="{Binding IsPutAway, Converter={StaticResource BoolToVisibility}}">
                                <Button x:Name="ProjectReopen" DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Margin="8,0,0,0"
                                        Command="{Binding ReopenCommand}" AutomationProperties.Name="Reopen project"
                                        ToolTip="Put it back on the board as it was: its duties, its queue and its archived cards. Nothing starts.">
                                    <AccessText Text="Reop_en" />
                                </Button>
                                <TextBlock Text="{Binding ClosedText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                            <!-- A stopped project keeps its run state and says so (1.1e AC 8). -->
                            <TextBlock x:Name="ProjectStopped" Text="⏸ Project stopped" FontSize="12" Margin="0,4,0,0"
                                       ToolTip="Start brings back the cards that were running when it was stopped."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl AutomationProperties.Name="Counts" ItemContainerStyle="{StaticResource ItemNamedByText}" x:Name="ProjectCounts" ItemsSource="{Binding Counts}" Margin="0,8,0,0" Focusable="False"
                                          Visibility="{Binding HasSentence, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StateCountViewModel}">
                                        <controls:StateCountChip />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!--
                                Open first, always shown, as opening is a project card's main action (1.1e AC 5); then start and
                                stop the whole project, as a card's own ▶ and ■ (1.1d AC 43), not on a dimmed card (AC 44).
                            -->
                            <StackPanel x:Name="ProjectButtons" Orientation="Horizontal" HorizontalAlignment="Left" Margin="-4,4,0,0">
                                <Button x:Name="ProjectOpen" Style="{StaticResource CardIcon}" Content="&#xE8E5;" Margin="0,0,4,0"
                                        ToolTip="{Binding OpenButtonToolTip}" AutomationProperties.Name="Open project"
                                        Visibility="{Binding IsDimmed, Converter={StaticResource NotBoolToVisibility}}"
                                        Command="{Binding OpenCommand}" />
                                <!-- A file that does not read: its ↗ becomes Update (1.1e AC 18). -->
                                <Button x:Name="ProjectUpdate" Style="{StaticResource CommandButton}" Content="Update" Margin="0,0,4,0"
                                        ToolTip="{Binding OpenButtonToolTip}" AutomationProperties.Name="Update project file"
                                        Visibility="{Binding IsDimmed, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding OpenCommand}" />
                                <!-- The lead's terminal, beside Open (Nigel, 2026-11-22). -->
                                <Button x:Name="ProjectFocusLead" Style="{StaticResource CardIcon}" Content="&#xE8A7;" Margin="0,0,4,0"
                                        ToolTip="{Binding FocusLeadToolTip}" ToolTipService.ShowOnDisabled="True"
                                        AutomationProperties.Name="Focus lead" Command="{Binding FocusLeadCommand}"
                                        Visibility="{Binding IsDimmed, Converter={StaticResource NotBoolToVisibility}}" />
                                <Button x:Name="ProjectStart" Style="{StaticResource CardIcon}" Content="&#xE768;" Margin="0,0,4,0"
                                        ToolTip="{Binding StartToolTip}" AutomationProperties.Name="Start project"
                                        Command="{Binding StartCommand}"
                                        Visibility="{Binding ShowsRunButtons, Converter={StaticResource BoolToVisibility}}" />
                                <Button x:Name="ProjectStop" Style="{StaticResource CardIcon}" Content="&#xE71A;"
                                        ToolTip="{Binding StopToolTip}" AutomationProperties.Name="Stop project"
                                        Command="{Binding StopCommand}"
                                        Visibility="{Binding ShowsRunButtons, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A card's title: trimmed, except while the search highlights it, when it wraps so the match is seen (review R4). -->
        <Style x:Key="SearchableTitle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTitleHighlights}" Value="True">
                    <Setter Property="TextTrimming" Value="None" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:WorkstreamCardViewModel}">
            <!--
                MinHeight is on the style so a folded card can drop it. Left at 96 the card would
                keep the height of its full self and fold to nothing worth looking at.
            -->
            <Border x:Name="CardFace" CornerRadius="4" Margin="0,0,0,8" Tag="Card"
                    ToolTip="{Binding FaceTooltip}"
                    ContextMenu="{StaticResource CardMenu}"
                    MouseLeftButtonDown="OnCardMouseDown"
                    PreviewMouseRightButtonDown="OnCardRightButtonDown"
                    MouseLeftButtonUp="OnCardClicked"
                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave">
                <Border.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding PropertiesCommand}" />
                    <KeyBinding Key="Space" CommandParameter="{Binding}"
                                Command="{Binding DataContext.Board.KeySelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <KeyBinding Key="Space" Modifiers="Control" CommandParameter="{Binding}"
                                Command="{Binding DataContext.Board.KeyToggleSelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Border.InputBindings>
                <!--
                    A card with no session takes the lane's own fill and sinks into the board; a
                    running one stays raised above it. Neither hue nor the border is available to say
                    this: the stripe is the workstream's permanent tab colour, and the border already
                    means selected.
                -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ClickableCard}">
                        <Setter Property="MinHeight" Value="96" />
                        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="MinHeight" Value="0" />
                            </DataTrigger>
                            <!-- A done card is muted as a pinned project card is, and stays where it was put (1.1e AC 12). -->
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <!-- Not matched by the board's search: dimmed, not removed, so the board keeps its shape (card-search-and-tags item 3). -->
                            <DataTrigger Binding="{Binding IsSearchDimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            </DataTrigger>
                            <!-- Linked to the card under the pointer: outlined, lighter than selection. -->
                            <DataTrigger Binding="{Binding IsLinkHighlighted}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        A working session flies a banner: the whole card takes its own tab colour,
                        and a band of light travels across it.

                        It replaced a stripe that faded from full to a third and back. That was the
                        only sign a session was working, it moved six pixels of a card, and it was
                        easy to miss across a full board.

                        The banner shows whenever the session is running; only the band's movement is
                        held back when the window is not in front or the machine has animation turned
                        off. A card that has stopped moving because you looked away must not also stop
                        looking busy.

                        It is declared first so it paints beneath the stripe and the text, and it is
                        in the template rather than in a shared style: a template gets a name scope
                        per card, so each card sweeps on its own clock.
                    -->
                    <Border x:Name="Banner" Grid.ColumnSpan="2" CornerRadius="4" ClipToBounds="True"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <!--
                                The tint carries its opacity on itself and not on the banner. Dimming
                                the banner would dim the band travelling over it in the same measure,
                                and the whole effect with it.
                            -->
                            <Rectangle Opacity="0.22"
                                       Fill="{Binding ColorHex, Converter={StaticResource HexToWash}}" />

                            <Rectangle x:Name="Sheen" Width="180" HorizontalAlignment="Left" Fill="{DynamicResource SheenBrush}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="Sweep" X="-180" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <Border x:Name="Stripe" Grid.Column="0" CornerRadius="4,0,0,4"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!--
                        Folded: the title, the tick, and a way back. The tick stays because folding
                        is how you clear the board down to what is running before starting some of
                        the rest, and having to unfold a card to choose it would undo the point.
                    -->
                    <Grid Grid.Column="1" Margin="12,8,8,8"
                          Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Folded, a card still says whether its session is running, and its marks. -->
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding FlagText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource CautionTextBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding FlagText, Converter={StaticResource NotEmptyToVisibility}}" />
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Lifecycle, Converter={StaticResource LifecycleGlyph}}"
                                       FontSize="14" ToolTip="{Binding StatusToolTip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource StateBusyBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Text="Ready" FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SuccessTextBrush}"
                                       ToolTip="{Binding LinkTooltip}"
                                       Visibility="{Binding IsLinkReady, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock FontSize="14"
                                       controls:HighlightedText.Text="{Binding Title}" controls:HighlightedText.Spans="{Binding TitleHighlights}"
                                       VerticalAlignment="Center" Style="{StaticResource SearchableTitle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>

                        <Button Grid.Column="2" Style="{StaticResource CommandButton}"
                                Padding="8,0" VerticalAlignment="Center"
                                ToolTip="Unfold card: open this card again."
                                AutomationProperties.Name="Unfold card"
                                Click="OnExpandCard">
                            <controls:GlyphText Text="&#xE76C;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,8,12,8"
                                Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                        <!--
                            The title has the card's full width and the buttons sit beneath it.

                            They shared a line, with the title keeping clear by a fixed margin that
                            guessed how wide the buttons were. Adding Archive made the guess wrong and
                            the title ran straight over Start. Widening the guess would only postpone
                            it, and there is no width that works: the cells of a grid are narrower
                            than the columns they replaced, and a title long enough to need reading is
                            exactly the one that gets trimmed to nothing.

                            So the two do not compete. The title is trimmed only by the card, and it
                            keeps its tooltip for what does not fit.
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="3" Style="{StaticResource CommandButton}"
                                    Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Fold card: fold this card down to its title."
                                    AutomationProperties.Name="Fold card"
                                    Click="OnCollapseCard">
                                <controls:GlyphText Text="&#xE70D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12" />
                            </Button>

                            <!--
                                The tick is what a bulk Start or Stop acts on. It sits with the title
                                rather than with the buttons because it says what this card *is* to
                                the next gesture, not what to do with it now.
                            -->

                            <TextBlock x:Name="CardTitle" Grid.Column="1" FontSize="18"
                                       controls:HighlightedText.Text="{Binding Title}" controls:HighlightedText.Spans="{Binding TitleHighlights}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Style="{StaticResource SearchableTitle}" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Text="{Binding Lifecycle, Converter={StaticResource LifecycleGlyph}}"
                                       FontSize="18" ToolTip="{Binding StatusToolTip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource StateBusyBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Paused or blocked, in amber under the title: a mark on the card, not a column. -->
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding FlagText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource CautionTextBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding FlagText, Converter={StaticResource NotEmptyToVisibility}}" />
                        <!-- Its project's branch rules, granted by the owner (1.1e AC 12b). -->
                        <TextBlock x:Name="BranchRules" Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding BranchRulesMark}" FontSize="12"
                                   ToolTip="{Binding BranchRulesToolTip}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding BranchRulesMark, Converter={StaticResource NotEmptyToVisibility}}" />
                        <!-- Its duties: each one's cadence, next run and last outcome. -->
                        <TextBlock x:Name="CardDuties" Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding DutyText}" FontSize="12" TextWrapping="Wrap"
                                   ToolTip="{Binding DutyToolTip}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.Name="Duties"
                                   Visibility="{Binding DutyText, Converter={StaticResource NotEmptyToVisibility}}" />
                        <!-- Its tags, at most three then "+2"; clicking one filters the board by it (card-search-and-tags items 11, 12). -->
                        <WrapPanel x:Name="CardTags" Margin="0,4,0,0" Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl AutomationProperties.Name="Tags" ItemContainerStyle="{StaticResource ItemNamedByLabel}" ItemsSource="{Binding TagChips}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TagChipButton}" Content="{Binding Label, Converter={StaticResource AccessKeyEscape}}" ToolTip="{Binding ToolTip}"
                                                AutomationProperties.Name="{Binding ToolTip}"
                                                Command="{Binding FilterCommand}" CommandParameter="{Binding Tag}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding MoreTags}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"
                                       ToolTip="{Binding MoreTagsToolTip}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding MoreTags, Converter={StaticResource NotEmptyToVisibility}}" />
                        </WrapPanel>

                        <!--
                            Icons, as media and transport controls are everywhere (Nigel, 2026-10-30):
                            play starts or restarts, stop asks the session to hand over and exit,
                            pause stops it and marks the card paused. Each tooltip says what it does.
                        -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-4,4,0,0">
                            <Button Style="{StaticResource CardIcon}" Content="&#xE768;" Margin="0,0,4,0"
                                    ToolTip="{Binding PlayTooltip}" AutomationProperties.Name="{Binding PrimaryAction}"
                                    Visibility="{Binding IsLive, Converter={StaticResource NotBoolToVisibility}}"
                                    Command="{Binding DataContext.StartCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource CardIcon}" Content="&#xE71A;" Margin="0,0,4,0"
                                    ToolTip="Stop: ask this session to write a handoff and exit when its turn ends."
                                    AutomationProperties.Name="Stop"
                                    Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.StopCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <!--
                                While a stop is under way the Stop icon gives way to this, which cannot be pressed,
                                in the board's amber, saying how far the stop has got (close-step AC 5 and 6).
                            -->
                            <TextBlock Text="&#xE71A;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Foreground="{DynamicResource CautionTextBrush}"
                                       Width="32" Height="32" Margin="0,0,4,0" TextAlignment="Center" Padding="0,8,0,0" Background="Transparent"
                                       ToolTip="{Binding StopTooltip}" AutomationProperties.Name="Stopping"
                                       Visibility="{Binding IsStopping, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Exit session" Style="{StaticResource CommandButton}" Margin="0,0,4,0"
                                    ToolTip="Type /exit into this session once more. Brings its terminal to the front."
                                    Visibility="{Binding CanCloseNow, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding CloseNowCommand}" />
                            <Button Content="&#xE769;" Margin="0,0,4,0" ToolTip="{Binding PauseTooltip}" AutomationProperties.Name="Pause"
                                    Command="{Binding PauseCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CardIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource FocusCardIcon}" Content="&#xE8A7;" Margin="0,0,8,0"
                                    AutomationProperties.Name="Focus"
                                    Command="{Binding DataContext.FocusCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource CardIcon}" Content="&#xE7B8;" Margin="0,0,4,0"
                                    ToolTip="{Binding ArchiveTooltip}" AutomationProperties.Name="{Binding ArchiveLabel}"
                                    Command="{Binding DataContext.ArchiveCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource CardIcon}" Content="&#xE712;"
                                    ToolTip="More options"
                                    AutomationProperties.Name="More"
                                    AutomationProperties.HelpText="Properties, start choices, paused, blocked, reopen tomorrow and spawn follow-on. Right-click the card for the same menu."
                                    ContextMenu="{StaticResource CardMenu}"
                                    Click="OnOverflowClick" />
                        </StackPanel>

                        <!--
                            Jira issues and pull requests in drop-downs, with titles where a session
                            reported them, and the branch line (the card's repos' branches, or the working directory's)
                            (Nigel, 2026-10-30). They were chips, and a workstream with twenty-five
                            issues grew a card taller than everything around it.
                        -->
                        <WrapPanel Margin="-4,8,0,4">
                            <Button Style="{StaticResource ItemDropDown}" Click="OnOverflowClick"
                                    ToolTip="This card's Jira issues. Choose one to open it." AutomationProperties.Name="{Binding JiraButtonText}"
                                    Visibility="{Binding JiraItems.Count, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding JiraButtonText, Mode=OneWay}" VerticalAlignment="Center" />
                                    <controls:GlyphText Text="&#xE70D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="8"
                                                        Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding JiraItems}" ItemContainerStyle="{StaticResource ItemRow}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
                                </Button.ContextMenu>
                            </Button>
                            <Button Style="{StaticResource ItemDropDown}" Click="OnOverflowClick"
                                    ToolTip="This card's pull requests. Choose one to open it." AutomationProperties.Name="{Binding PullRequestButtonText}"
                                    Visibility="{Binding PullRequestItems.Count, Converter={StaticResource CountToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PullRequestButtonText, Mode=OneWay}" VerticalAlignment="Center" />
                                    <controls:GlyphText Text="&#xE70D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="8"
                                                        Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding PullRequestItems}" ItemContainerStyle="{StaticResource ItemRow}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
                                </Button.ContextMenu>
                            </Button>
                            <!--
                                Pull request and CI status (pr-ci-status, objective 1.7): each repo's open pull request and newest
                                CI run, read from GitHub with no token, each row opening its page. Unknown says unknown; only
                                GitHub's answer is ever shown as passing. Failed is critical with a cross, so the shape says it too.
                            -->
                            <Button Click="OnOverflowClick" AutomationProperties.Name="{Binding StatusButtonText}"
                                    AutomationProperties.HelpText="Pull request and CI status, read from GitHub. Choose a row to open it."
                                    ToolTip="Pull request and CI status, read from GitHub. Choose a row to open it."
                                    Visibility="{Binding StatusButtonText, Converter={StaticResource NotEmptyToVisibility}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ItemDropDown}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusState}" Value="{x:Static ci:CiState.Passed}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusState}" Value="{x:Static ci:CiState.Failed}">
                                                <Setter Property="Foreground" Value="{DynamicResource CriticalTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusButtonText, Mode=OneWay}" VerticalAlignment="Center" />
                                    <controls:GlyphText Text="&#xE70D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="8"
                                                        Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding StatusItems}" ItemContainerStyle="{StaticResource StatusRow}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
                                </Button.ContextMenu>
                            </Button>
                            <!--
                                The branch line (card-branches, Nigel 2026-11-18): worded in Core, one line however
                                many repos the card covers, the list in the tooltip, and the caution colour when the
                                repos are not all on one branch.
                            -->
                            <TextBlock FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="220" ToolTip="{Binding BranchTooltip}"
                                       Visibility="{Binding Branch, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Branch}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BranchesDiffer}" Value="True">
                                                <Setter Property="Text" Value="{Binding Branch, StringFormat=⚠ {0} (branches differ)}" />
                                                <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </WrapPanel>

                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding TodoSummary}" behaviors:TrimmedToolTip.IsEnabled="True"
                                   Text="{Binding TodoSummary}"
                                   Visibility="{Binding TodoSummary, Converter={StaticResource NotEmptyToVisibility}}" />

                        <!-- A headless run: going, queued or ended, with its measured tokens and cost; its latest line under it (Nigel, 2026-11-24). -->
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding HeadlessLine}" behaviors:TrimmedToolTip.IsEnabled="True"
                                   Text="{Binding HeadlessLine}"
                                   Visibility="{Binding HeadlessLine, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="{Binding HeadlessDetail}" behaviors:TrimmedToolTip.IsEnabled="True"
                                   Text="{Binding HeadlessDetail}"
                                   Visibility="{Binding HeadlessDetail, Converter={StaticResource NotEmptyToVisibility}}" />

                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding ResourcesTooltip}"
                                   Text="{Binding Resources}"
                                   Visibility="{Binding Resources, Converter={StaticResource NotEmptyToVisibility}}" />

                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusToolTip}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding StatusLine}" />

                        <!--
                            Which model the session is on, read off the end of its transcript - the
                            only place it is recorded, and the only thing that shows a switch made
                            part-way through. Shown for a stopped card too: worth knowing before a
                            restart.
                        -->
                        <TextBlock FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="The model this session is running, from the last turn in its transcript"
                                   Text="{Binding Model}"
                                   Visibility="{Binding Model, Converter={StaticResource NotEmptyToVisibility}}" />

                        <!--
                            Shown only when the card has been renamed under a running session. A tab
                            cannot be renamed once it is open, so the two disagree until the session
                            is restarted, and a discrepancy nobody explains reads as a fault.
                        -->
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding RunningAs}" behaviors:TrimmedToolTip.IsEnabled="True"
                                   Text="{Binding RunningAs}"
                                   Visibility="{Binding RunningAs, Converter={StaticResource NotEmptyToVisibility}}" />

                        <!--
                            Coloured, unlike the other card lines, because this one is not a status:
                            it is the board saying two workstreams are about to tread on each other,
                            which nothing else on the card can see.
                        -->
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Foreground="{DynamicResource CautionTextBrush}"
                                   ToolTip="{Binding Clash}" behaviors:TrimmedToolTip.IsEnabled="True"
                                   Text="{Binding Clash}"
                                   Visibility="{Binding Clash, Converter={StaticResource NotEmptyToVisibility}}" />

                        <!--
                            A Jira issue shared with a linked card is deliberate, so it is said quietly,
                            not in the clash colour, and stays visible.
                        -->
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding LinkedShare}" behaviors:TrimmedToolTip.IsEnabled="True"
                                   Text="{Binding LinkedShare}"
                                   Visibility="{Binding LinkedShare, Converter={StaticResource NotEmptyToVisibility}}" />

                        <!--
                            The card's links in one line of words: Ready or what it waits on, then where
                            it came from. Green only for Ready, which is shown and never acted on.
                            Clicking it opens the card's details on its Links tab.
                        -->
                        <Button Margin="0,2,0,0" Padding="0" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="{Binding LinkTooltip}"
                                Command="{Binding DataContext.ShowCardLinksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding LinkLine, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding LinkLine}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLinkReady}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" FontSize="12" Padding="8,4"
                                Content="Adopt session"
                                ToolTip="{Binding LostSessionName, Converter={StaticResource TagToolTip}, ConverterParameter='Adopt the running &quot;{0}&quot;: its session was restarted outside Theseus, so the board stopped following it.'}"
                                Command="{Binding AdoptLostCommand}"
                                Visibility="{Binding LostSessionName,
                                             Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Only a session that is working moves. A session waiting for a reply is the one thing
                on the board asking for a person, and it stands out by being still among its moving
                neighbours.

                The trigger belongs to the template rather than to the stripe's style: an inline
                style is one object shared by every card, so a storyboard named inside it is shared
                too, and starting it for one card while stopping it for another leaves the movement
                on whichever card last held it. A template gets a name scope per card.
            -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Working">
                            <Storyboard>
                                <!--
                                    The band starts off the left edge and travels past the right. It
                                    runs to 560 rather than to the card's width because a card in a
                                    grid cell has no fixed width; the overshoot is clipped, and the
                                    quiet moment it leaves before the next pass is what makes this
                                    read as a ripple rather than a scanner.
                                -->
                                <DoubleAnimation Storyboard.TargetName="Sweep"
                                                 Storyboard.TargetProperty="X"
                                                 From="-180" To="560" Duration="0:0:2.6"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Working" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ColumnTemplate" DataType="{x:Type vm:ColumnViewModel}">
            <Grid>
            <Border Margin="4" CornerRadius="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MinWidth" Value="260" />
                        <Setter Property="Padding" Value="8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Padding" Value="0,8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                <!-- Folded: how many cards the stage holds here, and how many are live. -->
                <StackPanel HorizontalAlignment="Center" ToolTip="{Binding FoldedTooltip}" Background="Transparent"
                            Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Count}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding LiveCount, StringFormat='&#x25CF; {0}'}" FontSize="12" Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource StateBusyBrush}"
                               Visibility="{Binding LiveCount, Converter={StaticResource CountToVisibility}}" />
                    <!-- A match folded away shows without unfolding anything (card-search-and-tags item 4). -->
                    <StackPanel x:Name="FoldedMatches" Margin="0,8,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding MatchText, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding MatchText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="40" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Width="4" Height="24" Margin="0,4,0,0" CornerRadius="2" HorizontalAlignment="Center"
                                Background="{DynamicResource SearchHighlightBrush}" />
                    </StackPanel>
                </StackPanel>
                <DockPanel Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                    <!--
                        The cell does not repeat the stage name. It is written once across the top of
                        the board, and printing it again in every row is noise on a grid that already
                        has too much to say.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,8"
                          Visibility="{Binding Count, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- The project cards in this cell, standing for their cards (project-view AC 12, 13). -->
                    <ItemsControl AutomationProperties.Name="Projects" ItemContainerStyle="{StaticResource ItemNamedByTitle}" x:Name="ProjectCards" DockPanel.Dock="Top" ItemsSource="{Binding Projects}"
                                  ItemTemplate="{StaticResource ProjectCardTemplate}"
                                  AllowDrop="True" Drop="OnProjectsDrop" DragOver="OnColumnDragOver" />

                    <ItemsControl AutomationProperties.Name="Cards" ItemContainerStyle="{StaticResource ItemNamedByTitle}" ItemsSource="{Binding Cards}"
                                  ItemTemplate="{StaticResource CardTemplate}"
                                  AllowDrop="True"
                                  Drop="OnColumnDrop"
                                  DragOver="OnColumnDragOver"
                                  Background="Transparent"
                                  MinHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <!--
                                    PreviewMouseWheel because a ScrollViewer marks the wheel handled
                                    whether or not it had anywhere to scroll. A cell that is not full
                                    would otherwise swallow every turn of the wheel over it, and the
                                    board behind it would never move - which is what a two-finger
                                    scroll over a card did.
                                -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True"
                                              Focusable="False"
                                              Padding="0,0,4,0"
                                              PreviewMouseWheel="OnCellMouseWheel"
                                              Background="{TemplateBinding Background}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
                </Grid>
            </Border>
            <Thumb AutomationProperties.Name="Resize columns" HorizontalAlignment="Right" Width="8" Cursor="SizeWE"
                   ToolTip="Drag to resize the columns either side. Double-click to make them all even."
                   DragDelta="OnCellEdgeDrag" DragCompleted="OnSizeDragCompleted"
                   PreviewMouseLeftButtonDown="OnColumnEdgeDown"
                   Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Line" Width="1" HorizontalAlignment="Center" Opacity="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            </Grid>
        </DataTemplate>

        <!--
            One row of the board: an area, with a cell per stage.

            Collapsed, it keeps its header and a count per stage rather than disappearing. A row that
            vanished would hide the very thing somebody folded it away to see past - where the work
            in that area actually is.
        -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:BoardRowViewModel}">
            <!--
                The gap between rows is the row's resize handle. It was inside the row with a negative
                margin, which WPF clipped to two pixels, so only the bottom row could be dragged.
            -->
            <DockPanel>
            <!-- Drag to set the row's height; double-click to let it fit its cards again. -->
            <Thumb AutomationProperties.Name="Resize row" DockPanel.Dock="Bottom" Height="8" Cursor="SizeNS"
                   ToolTip="Drag to set this row's height. Double-click to let it fit its cards."
                   DragDelta="OnRowEdgeDrag" DragCompleted="OnSizeDragCompleted"
                   PreviewMouseLeftButtonDown="OnRowEdgeDown">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Line" Height="1" VerticalAlignment="Center" Opacity="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Border CornerRadius="8" Padding="4"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <!--
                        The header is on the left and kept narrow. Width is the scarce dimension on
                        this board - it decides how many columns of text a tiled terminal gets - so
                        the row label takes as little of it as it can and still be read.
                    -->
                    <StackPanel DockPanel.Dock="Left" Width="104" Margin="8,8,4,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Glyph}" Style="{StaticResource RowFoldButton}"
                                    Margin="0,0,4,0" VerticalAlignment="Center"
                                    ToolTip="Fold this row away, or open it."
                                    Command="{Binding ToggleCommand}" />
                            <TextBlock Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding LiveText, StringFormat='  &#x25CF; {0}'}" FontSize="12"
                                       VerticalAlignment="Center"
                                       ToolTip="Cards in this row with a session running"
                                       Foreground="{DynamicResource StateBusyBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCollapsed}" Value="True" />
                                                    <Condition Binding="{Binding LiveCount, Converter={StaticResource CountToVisibility}}"
                                                               Value="{x:Static Visibility.Visible}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Area}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="RowMatchText" Text="{Binding MatchText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                   ToolTip="Cards in this row the search matches"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCollapsed}" Value="True" />
                                                <Condition Binding="{Binding MatchText, Converter={StaticResource NotEmptyToVisibility}}"
                                                           Value="{x:Static Visibility.Visible}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- Folded: the counts per stage, and the search's matches drawn in a strip (card-search-and-tags item 4). -->
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Summary}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ItemsControl AutomationProperties.Name="Matches" ItemContainerStyle="{StaticResource ItemNamedByTitle}" x:Name="RowMatchStrip" ItemsSource="{Binding Matched}" Margin="0,4,0,0" Focusable="False"
                                      Visibility="{Binding MatchText, Converter={StaticResource NotEmptyToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,0" Margin="0,0,8,4"
                                            Background="{DynamicResource SearchHighlightBrush}">
                                        <TextBlock Text="{Binding Title}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}" behaviors:TrimmedToolTip.IsEnabled="True"
                                                   Foreground="{DynamicResource SearchHighlightTextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>


                    <ItemsControl AutomationProperties.Name="{Binding Area, StringFormat={}{0} stages}" ItemsSource="{Binding Cells}"
                                  ItemTemplate="{StaticResource ColumnTemplate}"
                                  Height="{Binding Height}"
                                  Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:StageColumnsPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter" BasedOn="{StaticResource ItemNamedByHeading}">
                                <Setter Property="controls:StageColumnsPanel.IsFolded" Value="{Binding IsCollapsed}" />
                                <Setter Property="controls:StageColumnsPanel.Weight" Value="{Binding Weight}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </DockPanel>
            </Border>
            </DockPanel>
        </DataTemplate>


        <DataTemplate x:Key="LiveSessionTemplate" DataType="{x:Type vm:LiveSessionViewModel}">
            <Border Margin="0,0,0,8" Padding="8,8" CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,20,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="On board" FontSize="12" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsAdopted, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding WorkingDirectory}" FontSize="12" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusLine}" FontSize="12" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusLine}" behaviors:TrimmedToolTip.IsEnabled="True"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource CommandButton}" Content="Focus" FontSize="12" Margin="0,0,8,0"
                                ToolTip="Focus: bring the session's window forward."
                                Command="{Binding DataContext.Sessions.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button x:Name="AdoptButton" Style="{StaticResource ItemDropDown}" MinHeight="32" AutomationProperties.Name="Adopt into"
                                ToolTip="Make a workstream follow this running session."
                                Visibility="{Binding IsAdopted, Converter={StaticResource NotBoolToVisibility}}"
                                Click="OnAdoptClicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Adopt into" VerticalAlignment="Center" />
                                <controls:GlyphText Text="&#xE70D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="8"
                                                    Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding AdoptTargets}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Title, Converter={StaticResource AccessKeyEscape}}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <!--
            The standard Windows layout (Nigel, 2026-10-30): a menu bar holding every command, an
            icon toolbar holding the frequent ones, and a status bar for readings. It replaced a row
            of eleven word buttons, three bordered groups and a "⋯" menu that had become a drawer for
            whatever did not fit, which he found to follow no standard and to cost width and reading.

            Each menu item with a toolbar button carries the same icon, so the toolbar is learned
            from the menus; items without one keep the menu's empty icon column, so labels align.
        -->
        <!--
            Every item has an access key, unique in its menu, items removed or disabled included, by W26's letter rule and
            its View map (C9, B5, B11). A command that does not apply is disabled with its reason, never hidden (W31, C8).
            Labels never change with the state (W30). No ellipsis on a command that asks nothing more (W14, C13).
        -->
        <Menu DockPanel.Dock="Top" Padding="8,0,8,0" Background="Transparent">
            <MenuItem Header="_File">
                <!-- Never greyed out: with no projects folder it opens the setup's folder step (first-run-setup, Nigel 2026-11-25). -->
                <MenuItem Header="New _project…" Command="{Binding NewProjectCommand}"
                          ToolTip="Start a new project: a project.md in the projects folder. With none chosen yet, it asks for one first." />
                <MenuItem Header="_New workstream…" InputGestureText="Ctrl+N" Command="{Binding NewWorkstream.OpenCommand}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE710;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Day report" InputGestureText="Ctrl+J" Command="{Binding DayReport.OpenCommand}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE9F9;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" Style="{StaticResource BoardOnlyItem}" />
                <MenuItem Header="Select _live" Command="{Binding SelectLiveCommand}" Style="{StaticResource BoardOnlyItem}"
                          Tag="Tick every card with a session running."
                          controls:OffReason.Text="{Binding SelectLiveCommand.WhyNot}" />
                <MenuItem Header="In_vert selection" InputGestureText="Ctrl+I" Command="{Binding InvertSelectionCommand}" Style="{StaticResource BoardOnlyItem}" />
                <MenuItem Header="_Unselect all" InputGestureText="Esc" Command="{Binding ClearSelectionCommand}" Style="{StaticResource BoardOnlyItem}" />
                <Separator />
                <!-- The search's keys, listed where a user looks for them (W27, C14, G55). -->
                <MenuItem Header="_Find cards" InputGestureText="Ctrl+F" Command="{x:Static local:MainWindow.FindCardsCommand}" Style="{StaticResource BoardOnlyItem}" />
                <MenuItem Header="Find _next" InputGestureText="F3" Command="{Binding NextMatchCommand}"
                          Style="{StaticResource BoardOnlyItem}" Tag="Go to the next card the search finds."
                          controls:OffReason.Text="Only on the board, with something typed in Find cards." />
                <MenuItem Header="Find _previous" InputGestureText="Shift+F3" Command="{Binding PreviousMatchCommand}"
                          Style="{StaticResource BoardOnlyItem}" Tag="Go to the card the search found before."
                          controls:OffReason.Text="Only on the board, with something typed in Find cards." />
                <Separator />
                <MenuItem Header="P_roperties" InputGestureText="Alt+Enter" Command="{Binding PropertiesCommand}"
                          ToolTipService.ShowOnDisabled="True" ToolTip="{Binding PropertiesToolTip}" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Live _sessions panel" InputGestureText="F7" IsCheckable="True"
                          IsChecked="{Binding IsSessionsPanelOpen, Mode=TwoWay}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE90C;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Locks panel" InputGestureText="F8" IsCheckable="True"
                          IsChecked="{Binding Locks.IsOpen, Mode=TwoWay}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE72E;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Chains panel" InputGestureText="F9" IsCheckable="True"
                          IsChecked="{Binding Chains.IsOpen, Mode=TwoWay}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE71B;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Columns by, Rows by and Group project by, as three radio sets in one submenu (W32, C12, C23, C25). -->
                <MenuItem x:Name="GroupByMenu" Header="_Group by">
                    <MenuItem Header="Columns by s_tage" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                              IsChecked="{Binding Board.ColumnsByStage, Mode=TwoWay}"
                              Tag="How far along the work is. Cards can be dragged between stages." />
                    <MenuItem Header="Columns by _session state" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                              IsChecked="{Binding Board.ColumnsBySessionState, Mode=TwoWay}"
                              Tag="What each session is doing: needs you, working, idle, not running, done" />
                    <Separator />
                    <MenuItem Header="Rows by _area" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                              IsChecked="{Binding Board.RowsByArea, Mode=TwoWay}" Tag="The kind of work, as set in Options" />
                    <MenuItem Header="Rows by _folder" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                              IsChecked="{Binding Board.RowsByProject, Mode=TwoWay}" Tag="The folder each workstream works in" />
                    <MenuItem Header="Rows by _chain" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                              IsChecked="{Binding Board.RowsByChain, Mode=TwoWay}" Tag="The chain of hand-overs each workstream belongs to" />
                    <MenuItem Header="Rows by _none" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                              IsChecked="{Binding Board.RowsByNone, Mode=TwoWay}" Tag="One row holding everything" />
                    <Separator />
                    <MenuItem Header="Project by _rounds and work" Style="{StaticResource RadioMenuItem}" IsCheckable="True"
                              IsChecked="{Binding ProjectView.IsGroupedByFlow, Mode=TwoWay}" IsEnabled="{Binding IsProjectOpen}"
                              Tag="The open project's pieces of work as they hand work on, time running down the page. Kept for each project."
                              controls:OffReason.Text="No project is open." />
                    <MenuItem Header="Project by o_bjectives only" Style="{StaticResource RadioMenuItem}" IsCheckable="True"
                              IsChecked="{Binding ProjectView.IsGroupedByObjectives, Mode=TwoWay}" IsEnabled="{Binding IsProjectOpen}"
                              Tag="The open project's pieces of work under the phases and objectives of project.md. Kept for each project."
                              controls:OffReason.Text="No project is open." />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Archive" Style="{StaticResource BoardOnlyItem}" IsCheckable="True" IsChecked="{Binding Board.ShowArchived, Mode=TwoWay}"
                          ToolTip="Show what has been put away instead of what is being worked on." />
                <Separator />
                <MenuItem Header="S_how all cards" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                          IsChecked="{Binding Board.ShowsAll, Mode=TwoWay}" />
                <MenuItem Header="Show only _projects" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                          IsChecked="{Binding Board.ShowsProjects, Mode=TwoWay}" />
                <MenuItem Header="Show only _workstreams" Style="{StaticResource BoardOnlyRadio}" IsCheckable="True"
                          IsChecked="{Binding Board.ShowsWorkstreams, Mode=TwoWay}" Tag="Show only the workstreams that are in no project." />
                <Separator />
                <!-- J: every other letter of the label is taken in View or avoided (W26); "just" is a word's first letter. -->
                <MenuItem x:Name="ActiveOnlyMenu" Style="{StaticResource BoardOnlyItem}" Header="Show _just active cards" IsCheckable="True" InputGestureText="Ctrl+K"
                          IsChecked="{Binding Board.ShowsActiveOnly, Mode=TwoWay}"
                          ToolTip="Hide every card that has no session and nothing waiting on you. A project stays while any of its cards is active." />
                <Separator />
                <!-- O is the one I or O key, a recorded deviation: Open project's other letters are taken or avoided (W4, W26). -->
                <MenuItem Header="_Open project" ItemsSource="{Binding OpenProjectChoices}"
                          ItemContainerStyle="{StaticResource ProjectChoiceItem}" Style="{StaticResource ExplainsWhenOff}"
                          IsEnabled="{Binding HasOpenProjectChoices}"
                          Tag="Fill the main area with a project: where it is, and its pieces of work as they run down the page."
                          controls:OffReason.Text="No project can be opened. Projects are read from the projects folder set in Tools › Options." />
                <!--
                    The toolbar's one toggle (project-view-as-tabs AC 5), as two items so the menu keeps its shape and keys (W26):
                    Project view on the board, I from "view" since every letter of Projects is taken in View; Back to the board in
                    the view, keeping its E. Each is greyed where it does not apply.
                -->
                <MenuItem x:Name="ProjectViewMenu" Header="Project v_iew" Command="{Binding ToggleViewCommand}" InputGestureText="Ctrl+B"
                          IsEnabled="{Binding IsBoardShown}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Open the project view where you left it: All projects, or the project you last opened."
                          controls:OffReason.Text="The project view is open." />
                <MenuItem Header="Back to th_e board" Command="{Binding CloseProjectCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Close the project view and show the board again (Ctrl+B)." controls:OffReason.Text="No project is open." />
                <MenuItem Header="Bac_k" InputGestureText="Alt+Left" Command="{Binding GoBackCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Back to the place you were before." controls:OffReason.Text="Nowhere to go back to." />
                <MenuItem Header="_Forward" InputGestureText="Alt+Right" Command="{Binding GoForwardCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Forward again, after going back." controls:OffReason.Text="Nowhere to go forward to." />
                <Separator />
                <!-- Y: every letter of "All projects" and "kanban" is taken in View (W26). -->
                <MenuItem Header="All projects la_yout">
                    <MenuItem Header="Show _closed projects" IsChecked="{Binding KanbanShowsClosed, Mode=OneWay}"
                              Command="{Binding KanbanShowsClosedCommand}" Style="{StaticResource ExplainsWhenOff}"
                              Tag="Give closed and archived projects rows of their own, after the open ones."
                              controls:OffReason.Text="All projects is not open." />
                    <MenuItem Header="_Fold all rows" Command="{Binding KanbanFoldAllCommand}" Style="{StaticResource ExplainsWhenOff}"
                              Tag="Fold every project's row down to its counts." controls:OffReason.Text="All projects is not open." />
                    <MenuItem Header="_Unfold all rows" Command="{Binding KanbanUnfoldAllCommand}" Style="{StaticResource ExplainsWhenOff}"
                              Tag="Open every folded row again." controls:OffReason.Text="All projects is not open." />
                </MenuItem>
                <MenuItem Header="Fold cards with _no session" Command="{Binding CollapseInactiveCommand}" Style="{StaticResource BoardOnlyItem}"
                          Tag="Fold every card with no session down to its title."
                          controls:OffReason.Text="{Binding CollapseInactiveCommand.WhyNot}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xF165;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Fol_d all cards" Command="{Binding FoldAllCommand}" Style="{StaticResource BoardOnlyItem}"
                          Tag="Fold every card down to its title." controls:OffReason.Text="No card is open to fold." />
                <MenuItem Header="_Unfold all cards" Command="{Binding ExpandAllCommand}" Style="{StaticResource BoardOnlyItem}"
                          Tag="Open every folded card again." controls:OffReason.Text="{Binding ExpandAllCommand.WhyNot}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xF164;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Unfold all rows and colu_mns" Command="{Binding UnfoldGridCommand}" Style="{StaticResource BoardOnlyItem}"
                          Tag="Open every folded row and column again." controls:OffReason.Text="No row or column is folded." />
                <MenuItem Header="Make lanes e_ven" Command="{Binding MakeLanesEvenCommand}" Style="{StaticResource BoardOnlyItem}"
                          Tag="Give every column an even share of the width and let every row fit its cards: the keyboard's way to dragging the lane edges."
                          controls:OffReason.Text="{Binding MakeLanesEvenCommand.WhyNot}" />
                <Separator />
                <MenuItem Header="_Toolbar" IsCheckable="True" IsChecked="{Binding IsToolbarVisible, Mode=TwoWay}" />
                <MenuItem Header="Status _bar" IsCheckable="True" IsChecked="{Binding IsStatusBarVisible, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="_Refresh" InputGestureText="F5" Command="{Binding RefreshCommand}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE72C;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Workstream">
                <MenuItem Header="_Start selected" Command="{Binding StartSelectedCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Start the ticked cards that are not already running; a ticked project starts as it was when stopped, or its first card."
                          controls:OffReason.Text="{Binding StartSelectedCommand.WhyNot}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE768;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="S_top selected" Command="{Binding StopSelectedCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Ask the ticked cards' running sessions, and a ticked project's, to write a handoff and exit."
                          controls:OffReason.Text="{Binding StopSelectedCommand.WhyNot}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE71A;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Focus lead session" InputGestureText="Ctrl+L" Command="{Binding FocusLeadCommand}"
                          ToolTipService.ShowOnDisabled="True" ToolTip="{Binding FocusLeadToolTip}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE8A7;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Mark as _paused" Command="{Binding MarkSelectedPausedCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Mark the ticked cards paused: set aside on purpose, keeping their stage."
                          controls:OffReason.Text="{Binding MarkSelectedPausedCommand.WhyNot}" />
                <MenuItem Header="Mark as _blocked" Command="{Binding MarkSelectedBlockedCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Mark the ticked cards blocked: waiting on something outside your control."
                          controls:OffReason.Text="{Binding MarkSelectedBlockedCommand.WhyNot}" />
                <MenuItem Header="_Clear paused and blocked" Command="{Binding ClearSelectedMarksCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Take both marks off the ticked cards."
                          controls:OffReason.Text="{Binding ClearSelectedMarksCommand.WhyNot}" />
                <Separator />
                <MenuItem Command="{Binding VerifySelectedWithHoldoutsCommand}"
                          ToolTipService.ShowOnDisabled="True" ToolTip="{Binding VerifySelectedToolTip}">
                    <MenuItem.Header>
                        <StackPanel>
                            <AccessText Text="Independent c_heck…" />
                            <TextBlock Text="{Binding VerifySelectedOffReason}" Style="{StaticResource MenuReasonLine}"
                                       Visibility="{Binding VerifySelectedOffReason, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="_View spec" ItemsSource="{Binding OpenSpecChoices}"
                          ItemContainerStyle="{StaticResource ProjectChoiceItem}" Style="{StaticResource ExplainsWhenOff}"
                          IsEnabled="{Binding HasSpecChoices}" Tag="Open a spec waiting on you in the open project, in its window."
                          controls:OffReason.Text="No spec is waiting on you in the open project." />
                <MenuItem Header="Acc_ept spec" ItemsSource="{Binding AcceptSpecChoices}"
                          ItemContainerStyle="{StaticResource ProjectChoiceItem}" Style="{StaticResource ExplainsWhenOff}"
                          IsEnabled="{Binding HasSpecChoices}"
                          Tag="Accept a spec waiting on you in the open project; asks first, naming the piece of work and the commit."
                          controls:OffReason.Text="No spec is waiting on you in the open project." />
                <Separator />
                <!-- Archive and Restore are a fixed pair; the one that does not apply is disabled with its reason (W30, W31). -->
                <MenuItem Header="_Archive selected" InputGestureText="Del" Command="{Binding ArchiveSelectedCommand}"
                          Style="{StaticResource ExplainsWhenOff}" Tag="Archive the ticked cards with no session running."
                          controls:OffReason.Text="{Binding ArchiveSelectedCommand.WhyNot}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE7B8;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Restore selected" Command="{Binding RestoreSelectedCommand}"
                          Style="{StaticResource ExplainsWhenOff}" Tag="Put the ticked cards back on the board."
                          controls:OffReason.Text="{Binding RestoreSelectedCommand.WhyNot}" />
            </MenuItem>

            <!--
                The open project's commands (project-view-as-tabs AC 9). On the board, and on All projects, each is greyed with
                the reason; the menu bar never changes shape. P is free in the menu bar (W26).
            -->
            <MenuItem Header="_Project" x:Name="ProjectMenu">
                <MenuItem Header="_Start the project" Command="{Binding ProjectStartCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Start the cards that were running when it was stopped, and its duties and queue."
                          controls:OffReason.Text="{Binding ProjectStartCommand.WhyNot}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE768;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="S_top the project…" Command="{Binding ProjectStopCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Ask its running cards to hand over and stop, pause its duties and queue, and release their locks once they have stopped."
                          controls:OffReason.Text="{Binding ProjectStopCommand.WhyNot}">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE71A;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Focus lead session" Command="{Binding ProjectFocusLeadCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Bring the lead's terminal forward." controls:OffReason.Text="{Binding ProjectFocusLeadCommand.WhyNot}" />
                <Separator />
                <MenuItem Header="_New workstream in this project…" Command="{Binding ProjectNewWorkstreamCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Make a workstream, then add it to this project under an objective."
                          controls:OffReason.Text="{Binding ProjectNewWorkstreamCommand.WhyNot}" />
                <Separator />
                <MenuItem Header="_Close project…" Command="{Binding ProjectCloseCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Stop its cards after their handover, pause its duties and queue, and put it under Archived until you reopen it."
                          controls:OffReason.Text="{Binding ProjectCloseCommand.WhyNot}" />
                <MenuItem Header="_Archive project…" Command="{Binding ProjectArchiveCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="As Close, and archive its cards too. project.md and its records stay where they are."
                          controls:OffReason.Text="{Binding ProjectArchiveCommand.WhyNot}" />
                <Separator />
                <MenuItem Header="P_roperties" Command="{Binding ProjectPropertiesCommand}" Style="{StaticResource ExplainsWhenOff}"
                          Tag="Its title, colour, lead and project.md." controls:OffReason.Text="{Binding ProjectPropertiesCommand.WhyNot}" />
            </MenuItem>

            <MenuItem Header="Win_dow">
                <MenuItem Header="_Arrange windows…" Command="{Binding Arrange.OpenCommand}"
                          ToolTip="Tile, cascade or stack the terminal windows.">
                    <MenuItem.Icon><controls:GlyphText Text="&#xE8A9;" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                </MenuItem>
                <!-- A window command, so here beside Arrange windows rather than in View (W32). -->
                <MenuItem Header="_Bring project window forward" Command="{Binding BringProjectWindowForwardCommand}"
                          ToolTip="{Binding ProjectWindowTooltip}" ToolTipService.ShowOnDisabled="True" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="O_ptions" InputGestureText="Ctrl+," Command="{Binding Settings.OpenCommand}" />
                <MenuItem Header="_Set up Theseus…" Command="{Binding FirstRun.OpenCommand}"
                          ToolTip="The first-run setup: folders, the stop hook, the holdout guard and the tools, showing only what is missing." />
                <MenuItem Header="D_uties…" Command="{Binding OpenDutiesCommand}"
                          ToolTip="Every duty on the board: the instructions Theseus gives cards on a cadence." />
                <Separator />
                <MenuItem Header="Tripped _breakers…" Command="{Binding TrippedBreakersCommand}"
                          ToolTip="Every card whose circuit breaker tripped, with Reset for those you tick." />
                <Separator />
                <MenuItem Header="Open _logs folder" Command="{Binding OpenLogsFolderCommand}" />
                <MenuItem Header="Open _data folder" Command="{Binding OpenDataFolderCommand}" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="View _help" InputGestureText="F1" Command="{Binding Help.OpenCommand}" />
                <MenuItem Header="How your work is _laid out" Command="{Binding Help.OpenCommand}" CommandParameter="project-layout" />
                <Separator />
                <MenuItem Header="Check for _updates" Command="{Binding Updates.CheckNowCommand}"
                          ToolTip="Ask GitHub for a newer release now, including one you skipped." />
                <MenuItem Header="_What's new in this version" Command="{Binding OpenReleaseNotesCommand}" />
                <Separator />
                <MenuItem Header="_About Theseus" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!--
            The toolbar row: the toolbar, then Show, then the search, declared in that order so that Tab reads them left to
            right (B2, G65). The search stays when the toolbar is hidden, since Ctrl+F reaches it from anywhere
            (card-search-and-tags item 1). Every control in the row is one height, 32, from the shared styles (W56, D19).

            The toolbar holds the frequent commands, in groups split by separators. New, Start, Stop and Archive carry
            their names (W34, C7); the rest are icons, a recorded deviation, each named for screen readers. A command that
            does not apply is greyed with its reason, never hidden (W31, C8, C-m1).
        -->
        <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToolBarTray Grid.Column="0" IsLocked="True" Background="Transparent"
                         Visibility="{Binding IsToolbarVisible, Converter={StaticResource BoolToVisibility}}">
                <ToolBar x:Name="MainToolBar" Background="Transparent" Loaded="OnToolBarLoaded">
                    <!-- New makes its card in the open project when a project's tab is shown (project-view-as-tabs AC 8). -->
                    <Button Style="{StaticResource LabelledTool}" Command="{Binding NewInContextCommand}"
                            Tag="{Binding NewInContextToolTip}" AutomationProperties.Name="New workstream" AutomationProperties.AcceleratorKey="Ctrl+N"
                            controls:OffReason.Text="{Binding NewInContextCommand.WhyNot}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphText Text="&#xE710;" VerticalAlignment="Center" />
                            <TextBlock Text="New" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ExplainsWhenOffTool}" Content="&#xE8F4;" AutomationProperties.Name="New project"
                            Command="{Binding NewProjectCommand}" Tag="New project" />
                    <!--
                        One toggle between the board and the project view, its words and glyph following where you are
                        (project-view-as-tabs AC 5; Nigel, 2026-11-26: "a single toolbar button that changes depending on context").
                    -->
                    <Button x:Name="ToggleViewButton" Style="{StaticResource LabelledTool}" Command="{Binding ToggleViewCommand}"
                            Tag="{Binding ToggleViewToolTip}" AutomationProperties.Name="{Binding ToggleViewText}" AutomationProperties.AcceleratorKey="Ctrl+B"
                            controls:OffReason.Text="{Binding ToggleViewCommand.WhyNot}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphText Text="{Binding ToggleViewGlyph}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ToggleViewText}" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>

                    <Separator />

                    <Button Style="{StaticResource LabelledTool}" Command="{Binding StartSelectedCommand}"
                            Tag="Start selected" AutomationProperties.Name="Start selected" Visibility="{Binding IsBoardShown, Converter={StaticResource BoolToVisibility}}"
                            controls:OffReason.Text="{Binding StartSelectedCommand.WhyNot}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphText Text="&#xE768;" VerticalAlignment="Center" />
                            <TextBlock Text="Start" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelledTool}" Command="{Binding StopSelectedCommand}"
                            Tag="Stop selected" AutomationProperties.Name="Stop selected" Visibility="{Binding IsBoardShown, Converter={StaticResource BoolToVisibility}}"
                            controls:OffReason.Text="{Binding StopSelectedCommand.WhyNot}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphText Text="&#xE71A;" VerticalAlignment="Center" />
                            <TextBlock Text="Stop" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelledTool}" Command="{Binding ArchiveSelectedCommand}"
                            Tag="Archive selected (Del)" AutomationProperties.Name="Archive selected" AutomationProperties.AcceleratorKey="Del" Visibility="{Binding IsBoardShown, Converter={StaticResource BoolToVisibility}}"
                            controls:OffReason.Text="{Binding ArchiveSelectedCommand.WhyNot}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphText Text="&#xE7B8;" VerticalAlignment="Center" />
                            <TextBlock Text="Archive" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>

                    <!--
                        In the project view the toolbar acts on the project shown (project-view-as-tabs AC 7): Start the project,
                        Stop the project, and its less used commands behind More, the Windows overflow. On All projects each is
                        greyed with "Open a project's tab to act on it" (agreed with 1.5b).
                    -->
                    <Button x:Name="ProjectStartTool" Style="{StaticResource LabelledTool}" Command="{Binding ProjectStartCommand}"
                            Tag="Start the project: the cards that were running when it was stopped, its duties and its queue"
                            AutomationProperties.Name="Start the project" controls:OffReason.Text="{Binding ProjectStartCommand.WhyNot}" Visibility="{Binding IsProjectViewShown, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphText Text="&#xE768;" VerticalAlignment="Center" />
                            <TextBlock Text="Start the project" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProjectStopTool" Style="{StaticResource LabelledTool}" Command="{Binding ProjectStopCommand}"
                            Tag="Stop the project: its cards hand over and stop, its duties and queue pause, and their locks are released once they have stopped"
                            AutomationProperties.Name="Stop the project" controls:OffReason.Text="{Binding ProjectStopCommand.WhyNot}" Visibility="{Binding IsProjectViewShown, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphText Text="&#xE71A;" VerticalAlignment="Center" />
                            <TextBlock Text="Stop the project…" Style="{StaticResource ToolLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProjectMoreTool" Style="{StaticResource ToolIcon}" Content="&#xE712;" ToolTip="More: close, archive or show the properties of this project"
                            AutomationProperties.Name="More project commands" Click="OnProjectMore" Visibility="{Binding IsProjectViewShown, Converter={StaticResource BoolToVisibility}}">
                        <Button.ContextMenu>
                            <!-- The message font: a menu takes its button's, which here is the icon font. -->
                            <ContextMenu FontFamily="{x:Static SystemFonts.MessageFontFamily}">
                                <MenuItem Header="_Close project…" Command="{Binding ProjectCloseCommand}" Style="{StaticResource ExplainsWhenOff}"
                                          Tag="Stop its cards after their handover, pause its duties and queue, and put it under Archived until you reopen it."
                                          controls:OffReason.Text="{Binding ProjectCloseCommand.WhyNot}" />
                                <MenuItem Header="_Archive project…" Command="{Binding ProjectArchiveCommand}" Style="{StaticResource ExplainsWhenOff}"
                                          Tag="As Close, and archive its cards too. project.md and its records stay where they are."
                                          controls:OffReason.Text="{Binding ProjectArchiveCommand.WhyNot}" />
                                <Separator />
                                <MenuItem Header="P_roperties" Command="{Binding ProjectPropertiesCommand}" Style="{StaticResource ExplainsWhenOff}"
                                          Tag="Its title, colour, lead and project.md." controls:OffReason.Text="{Binding ProjectPropertiesCommand.WhyNot}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Separator />

                    <Button Style="{StaticResource ExplainsWhenOffTool}" Content="&#xF165;" Tag="Fold cards with no session"
                            AutomationProperties.Name="Fold cards with no session" Visibility="{Binding IsBoardShown, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding CollapseInactiveCommand}" controls:OffReason.Text="{Binding CollapseInactiveCommand.WhyNot}" />
                    <Button Style="{StaticResource ExplainsWhenOffTool}" Content="&#xF164;" Tag="Unfold all cards"
                            AutomationProperties.Name="Unfold all cards" Visibility="{Binding IsBoardShown, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding ExpandAllCommand}" controls:OffReason.Text="{Binding ExpandAllCommand.WhyNot}" />
                    <!-- The project's Fold all and Unfold all, moved up from the page's own toolbar (AC 7). -->
                    <Button Style="{StaticResource ExplainsWhenOffTool}" Content="&#xF165;" Tag="Fold all: every piece of work and every heading"
                            AutomationProperties.Name="Fold all" Visibility="{Binding IsProjectViewShown, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding ProjectFoldAllCommand}" controls:OffReason.Text="{Binding ProjectFoldAllCommand.WhyNot}" />
                    <Button Style="{StaticResource ExplainsWhenOffTool}" Content="&#xF164;" Tag="Unfold all: every piece of work into its stages, and every heading"
                            AutomationProperties.Name="Unfold all" Visibility="{Binding IsProjectViewShown, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding ProjectUnfoldAllCommand}" controls:OffReason.Text="{Binding ProjectUnfoldAllCommand.WhyNot}" />

                    <Separator />

                    <!--
                        A panel's button names only the panel and its key; its status and count go to screen readers as help
                        text, and the count's own text is left out of the tree (W35, C20, E13). An urgent count shows ⚠.
                    -->
                    <ToggleButton Style="{StaticResource ToolIconToggle}" IsChecked="{Binding IsSessionsPanelOpen, Mode=TwoWay}"
                                  ToolTip="Live sessions panel (F7)" AutomationProperties.Name="Live sessions panel"
                                  AutomationProperties.AcceleratorKey="F7" AutomationProperties.HelpText="{Binding Sessions.Status}">
                        <Grid>
                            <controls:GlyphText Text="&#xE90C;" Style="{StaticResource ToolGlyph}" />
                            <Border Style="{StaticResource OverlayToolBadge}"
                                    Visibility="{Binding Sessions.Sessions.Count, Converter={StaticResource CountToVisibility}}">
                                <controls:GlyphText Text="{Binding Sessions.Sessions.Count}" />
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolIconToggle}" IsChecked="{Binding Locks.IsOpen, Mode=TwoWay}"
                                  ToolTip="Locks panel (F8)" AutomationProperties.Name="Locks panel"
                                  AutomationProperties.AcceleratorKey="F8" AutomationProperties.HelpText="{Binding Locks.ButtonText}">
                        <Grid>
                            <controls:GlyphText Text="&#xE72E;" Style="{StaticResource ToolGlyph}" />
                            <Border Visibility="{Binding Locks.Busy, Converter={StaticResource CountToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource OverlayToolBadge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Locks.IsUrgent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CautionTextBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:GlyphText Text="⚠ " Visibility="{Binding Locks.IsUrgent, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:GlyphText Text="{Binding Locks.Busy}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolIconToggle}" IsChecked="{Binding Chains.IsOpen, Mode=TwoWay}"
                                  ToolTip="Chains panel (F9)" AutomationProperties.Name="Chains panel"
                                  AutomationProperties.AcceleratorKey="F9" AutomationProperties.HelpText="{Binding Chains.ButtonText}">
                        <Grid>
                            <controls:GlyphText Text="&#xE71B;" Style="{StaticResource ToolGlyph}" />
                            <Border Visibility="{Binding Chains.BadgeCount, Converter={StaticResource CountToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource OverlayToolBadge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chains.IsUrgent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CautionTextBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:GlyphText Text="⚠ " Visibility="{Binding Chains.IsUrgent, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:GlyphText Text="{Binding Chains.BadgeCount}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ToggleButton>

                    <Separator />

                    <Button Style="{StaticResource ToolIcon}" Content="&#xE9F9;" ToolTip="Day report (Ctrl+J)" AutomationProperties.Name="Day report"
                            AutomationProperties.AcceleratorKey="Ctrl+J" Command="{Binding DayReport.OpenCommand}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE8A9;" ToolTip="Arrange windows" AutomationProperties.Name="Arrange windows"
                            Command="{Binding Arrange.OpenCommand}" />

                    <Separator />

                    <Button Style="{StaticResource ToolIcon}" Content="&#xE72C;" ToolTip="Refresh, and check for a new version (F5)" AutomationProperties.Name="Refresh"
                            AutomationProperties.AcceleratorKey="F5" Command="{Binding RefreshCommand}" />
                </ToolBar>
            </ToolBarTray>

            <!--
                What the board shows: all, only project cards, or only workstreams (Nigel, 2026-11-23). Remembered. Three views
                of the same cards, so a selector bar: one Tab stop, the arrows choose and do not wrap (W15, W42; D7, B16, D8).
                While it hides any cards it says so with a mark and words beside it, not colour alone (1.5 walkthrough row 3).
            -->
            <StackPanel x:Name="BoardShowBar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="12,0,12,0" DataContext="{Binding Board}"
                        Visibility="{Binding DataContext.IsBoardShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <StackPanel.Resources>
                    <Style x:Key="ShowItem" TargetType="RadioButton" BasedOn="{StaticResource SelectorBarItem}">
                        <Setter Property="GroupName" Value="BoardShows" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="controls:SelectorBar.SelectsOnFocus" Value="True" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Show:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- The group's arrows stay among its three choices; Active only and the note sit beside it (W42, G67). -->
                <controls:SelectorGroup x:Name="BoardShowsChoice" AutomationProperties.Name="Show" Orientation="Horizontal"
                                        KeyboardNavigation.DirectionalNavigation="Contained">
                <RadioButton x:Name="ShowAllCards" Content="All" Style="{StaticResource ShowItem}"
                             IsChecked="{Binding ShowsAll, Mode=TwoWay}" AutomationProperties.Name="Show all cards" />
                <RadioButton x:Name="ShowProjectCards" Content="Projects" Style="{StaticResource ShowItem}"
                             IsChecked="{Binding ShowsProjects, Mode=TwoWay}"
                             AutomationProperties.Name="Show only projects" />
                <RadioButton x:Name="ShowWorkstreamCards" Content="Workstreams" Style="{StaticResource ShowItem}"
                             IsChecked="{Binding ShowsWorkstreams, Mode=TwoWay}" ToolTip="Show only the workstreams that are in no project."
                             AutomationProperties.Name="Show only workstreams" />
                </controls:SelectorGroup>
                <ToggleButton x:Name="ActiveOnlyToggle" Style="{StaticResource ToolIconToggle}" Margin="8,0,0,0" Padding="8,0"
                              Content="Active only" IsChecked="{Binding ShowsActiveOnly, Mode=TwoWay}"
                              ToolTip="Show active only (Ctrl+K)" AutomationProperties.Name="Show active only"
                              AutomationProperties.AcceleratorKey="Ctrl+K"
                              AutomationProperties.HelpText="Hides every card that has no session and nothing waiting on you." />
                <StackPanel x:Name="ShowHides" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            ToolTip="Show hides some cards. Choose All to see every card."
                            Visibility="{Binding ShowsAll, Converter={StaticResource NotBoolToVisibility}}">
                    <controls:GlyphText Text="&#xE946;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16"
                                        VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ShowHidesText" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Some cards hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsProjects}" Value="True">
                                        <Setter Property="Text" Value="Workstreams hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowsWorkstreams}" Value="True">
                                        <Setter Property="Text" Value="Projects hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SearchBar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        DataContext="{Binding Board.Search}">
                <Grid Width="260" VerticalAlignment="Center">
                    <ComboBox x:Name="SearchBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                              ItemsSource="{Binding History}" MinHeight="32"
                              Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                              ToolTip="Find cards by any part of a title, key, project, area, Jira key, tag, branch or repo. #tag filters by a tag. Enter goes to the next match, Ctrl+Enter opens it, Esc clears."
                              AutomationProperties.Name="Find cards" AutomationProperties.AcceleratorKey="Ctrl+F"
                              PreviewKeyDown="OnSearchKeyDown" LostKeyboardFocus="OnSearchLostFocus" />
                    <TextBlock Text="Find cards (Ctrl+F)" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding ShowsPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <!-- Tags ▾ (card-search-and-tags item 12): every tag with its count; ticking filters, Any | All at the top. -->
                <ToggleButton x:Name="TagsToggle" Style="{StaticResource ToolIconToggle}" Margin="8,0,0,0" Padding="8,0"
                              Content="{Binding TagsButtonText, Converter={StaticResource AccessKeyEscape}}" Checked="OnTagsOpened"
                              ToolTip="Filter the board by tags." AutomationProperties.Name="Tags" />
                <!-- A flyout: the overlay radius and padding, and a thicker edge under a contrast theme (D12, D-m1, E7). -->
                <Popup x:Name="TagsPopup" PlacementTarget="{Binding ElementName=TagsToggle}" Placement="Bottom" StaysOpen="False" Opened="OnTagsPopupOpened"
                       AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=TagsToggle, Mode=TwoWay}">
                    <Border x:Name="TagsFlyout" Padding="16" CornerRadius="8" MinWidth="220" MaxHeight="420"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="{DynamicResource FlyoutBorderThickness}"
                            PreviewKeyDown="OnTagsFlyoutKeyDown">
                        <DockPanel>
                            <controls:SelectorGroup x:Name="TagMatch" AutomationProperties.Name="Show cards with" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                        KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                                <TextBlock Text="Show cards with:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <RadioButton x:Name="TagsAny" Content="Any" GroupName="TagMatch" IsChecked="{Binding IsAny, Mode=TwoWay}"
                                             IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                             controls:SelectorBar.SelectsOnFocus="True"
                                             ToolTip="Show cards with any of the ticked tags." Margin="0,0,8,0" />
                                <RadioButton x:Name="TagsAll" Content="All" GroupName="TagMatch" IsChecked="{Binding IsAll, Mode=TwoWay}"
                                             IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                             controls:SelectorBar.SelectsOnFocus="True"
                                             ToolTip="Show only cards with every ticked tag." />
                            </controls:SelectorGroup>
                            <TextBlock DockPanel.Dock="Top" FontSize="12" TextWrapping="Wrap" MaxWidth="260"
                                       Text="No card has a tag yet. Add one from a card's menu, Tags, or its Properties."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasNoTags, Converter={StaticResource BoolToVisibility}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl AutomationProperties.Name="Tags" ItemContainerStyle="{StaticResource ItemNamedByLabel}" x:Name="TagRows" ItemsSource="{Binding TagRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay}" Margin="0,4"
                                                      ToolTip="{Binding Label, Converter={StaticResource TagToolTip}, ConverterParameter=Show cards tagged {0}}"
                                                      AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Fill="{Binding ColourHex, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Count}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
                <ToggleButton x:Name="HideRestToggle" Style="{StaticResource ToolIconToggle}" Margin="8,0,0,0" Padding="8,0"
                              IsChecked="{Binding HideRest, Mode=TwoWay}" Content="Hide the _rest"
                              ToolTip="Hide the cards the search does not match, instead of dimming them."
                              AutomationProperties.Name="Hide the rest" />
                <Button x:Name="ClearSearch" Style="{StaticResource CommandButton}" Content="_Clear" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" ToolTip="{Binding ClearToolTip}" ToolTipService.ShowOnDisabled="True" />
            </StackPanel>
        </Grid>

        <!--
            The information bar, as in Visual Studio and Office: shown only while a newer build is
            on offer, which is the one message worth moving the board for. Offered, never installed
            until Update and restart is pressed.
        -->
        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Margin="12,0,12,8" Padding="12,8" CornerRadius="4"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding Updates.IsOffered, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <!--
                The offer is an informational bar on the accent, so it stands out (Nigel, 2026-11-24), never caution amber; a
                stopped update is an error, on the critical red with its own glyph (W46, C17, G150).
            -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource UpdateOfferBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource UpdateOfferTextBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Updates.Severity}" Value="{x:Static vm:NoticeSeverity.Error}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- A solid backing: the button's own fill is translucent, and on the accent its label would fade (Nigel, 2026-11-24). -->
                    <Border Margin="8,0,0,0" CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            Visibility="{Binding Updates.IsDownloading, Converter={StaticResource NotBoolToVisibility}}">
                        <Button Style="{StaticResource CommandButton}" Content="_Update and restart"
                            ToolTip="Download it, check its SHA-256, install it (Windows asks for permission) and restart Theseus. Running sessions are not touched."
                            Command="{Binding Updates.UpdateCommand}" />
                    </Border>
                    <Border Margin="8,0,0,0" CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            Visibility="{Binding Updates.IsDownloading, Converter={StaticResource NotBoolToVisibility}}">
                        <Button Style="{StaticResource CommandButton}" Content="S_kip this version"
                            ToolTip="Not this version. Theseus offers again when a newer one is published."
                            Command="{Binding Updates.LaterCommand}" />
                    </Border>
                    <Border Margin="8,0,0,0" CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVisibility}}">
                        <Button x:Name="CancelUpdate" Style="{StaticResource CommandButton}" Content="Cancel"
                            ToolTip="Stop the download. Nothing is installed, and the offer stays."
                            Command="{Binding Updates.CancelDownloadCommand}" />
                    </Border>
                </StackPanel>
                <controls:GlyphText DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16">
                    <controls:GlyphText.Style>
                        <Style TargetType="controls:GlyphText">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Updates.Severity}" Value="{x:Static vm:NoticeSeverity.Error}">
                                    <Setter Property="Text" Value="&#xE783;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:GlyphText.Style>
                </controls:GlyphText>
                <!-- Determinate from the download's Content-Length, running while its size is unknown (W52, G148). -->
                <ProgressBar x:Name="UpdateProgress" DockPanel.Dock="Bottom" Margin="0,8,0,0" Height="4" Maximum="100"
                             Value="{Binding Updates.DownloadPercent, Mode=OneWay}"
                             AutomationProperties.Name="Downloading the update"
                             Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="IsIndeterminate" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Updates.IsProgressKnown}" Value="True">
                                    <Setter Property="IsIndeterminate" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           ToolTip="{Binding Updates.Offer.Page}">
                    <Run Text="{Binding Updates.OfferText, Mode=OneWay}" />
                    <Run Text="{Binding Updates.Status, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Border x:Name="SessionsPane" DockPanel.Dock="Left" Width="280" MinWidth="220" MaxWidth="480" Margin="12,8,0,12"
                CornerRadius="8" Padding="12"
                Visibility="{Binding IsSessionsPanelOpen, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <controls:PaneResizeThumb AutomationProperties.Name="Resize the sessions panel" DockPanel.Dock="Right" Style="{StaticResource PaneEdge}" Margin="0,-12,-16,-12" HorizontalAlignment="Right"
                                          Pane="{Binding ElementName=SessionsPane}" />
                <Grid DockPanel.Dock="Top" Margin="4,4,4,8">
                    <TextBlock Text="Live sessions" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Sessions.Status}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource PanelIcon}" Content="&#xE8BB;" Margin="8,0,0,0"
                                ToolTip="Hide the live sessions panel (F7)" AutomationProperties.Name="Hide live sessions"
                                AutomationProperties.AcceleratorKey="F7"
                                Command="{Binding ToggleSessionsPanelCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl AutomationProperties.Name="Sessions" ItemContainerStyle="{StaticResource ItemNamedByName}" ItemsSource="{Binding Sessions.Sessions}"
                                  ItemTemplate="{StaticResource LiveSessionTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!--
            The chains (Nigel, 2026-10-23): every card with links, under the card that handed over to it,
            with what it waits on and whom it reports back to as lines beneath it. Read-only in this phase: links are made and changed in
            a card's details. Ready is listed and never acted on; nothing here starts a session. It shares
            the right-hand side with Locks and the two never sit side by side.
        -->
        <Border x:Name="ChainsPane" DockPanel.Dock="Right" Width="340" MinWidth="280" MaxWidth="560" Margin="0,8,12,12"
                CornerRadius="8" Padding="12"
                Visibility="{Binding Chains.IsOpen, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <controls:PaneResizeThumb AutomationProperties.Name="Resize the chains panel" DockPanel.Dock="Left" Style="{StaticResource PaneEdge}" Margin="-16,-12,0,-12" HorizontalAlignment="Left"
                                          Pane="{Binding ElementName=ChainsPane}" IsOnTheRight="True" />
                <Grid DockPanel.Dock="Top" Margin="4,4,4,8">
                    <!-- Locks and Chains are two views of the side panel: a selector bar (W15, D7, G125). -->
                    <controls:SelectorGroup x:Name="ChainsPaneSwitch" Orientation="Horizontal" AutomationProperties.Name="Views of the side panel"
                                KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                        <RadioButton Content="Locks" Style="{StaticResource PanelSwitchItem}" GroupName="ChainsPaneSwitch"
                                     IsChecked="{Binding Locks.IsOpen, Mode=OneWay}" controls:SelectorBar.SelectsOnFocus="True"
                                     ToolTip="Show the locks panel." Command="{Binding Locks.OpenCommand}" />
                        <RadioButton Content="Chains" Style="{StaticResource PanelSwitchItem}" GroupName="ChainsPaneSwitch"
                                     IsChecked="{Binding Chains.IsOpen, Mode=OneWay}" controls:SelectorBar.SelectsOnFocus="True"
                                     ToolTip="Show the chains panel." Command="{Binding Chains.OpenCommand}" />
                    </controls:SelectorGroup>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Fold all and Unfold all the tree (walkthrough row 11), with the board's fold glyphs (W25). -->
                        <Button x:Name="ChainsFoldAll" Style="{StaticResource PanelIcon}" Content="&#xF165;" Margin="0,0,4,0"
                                ToolTip="Fold all: show only the first card of each chain." AutomationProperties.Name="Fold all"
                                Command="{Binding Chains.FoldAllCommand}" />
                        <Button x:Name="ChainsUnfoldAll" Style="{StaticResource PanelIcon}" Content="&#xF164;" Margin="0,0,8,0"
                                ToolTip="Unfold all: show every card of every chain." AutomationProperties.Name="Unfold all"
                                Command="{Binding Chains.UnfoldAllCommand}" />
                        <Button Style="{StaticResource PanelIcon}" Content="&#xE897;" Margin="0,0,8,0"
                                ToolTip="Chains help, in your browser" AutomationProperties.Name="Chains help"
                                AutomationProperties.HelpText="Opens nigelbasel.github.io/Theseus in your browser"
                                Command="{Binding Help.OpenCommand}" CommandParameter="chains" />
                        <Button Style="{StaticResource PanelIcon}" Content="&#xE8BB;"
                                ToolTip="Hide the chains panel (F9)" AutomationProperties.Name="Hide chains"
                                AutomationProperties.AcceleratorKey="F9"
                                Command="{Binding Chains.ToggleCommand}" />
                    </StackPanel>
                </Grid>

                <!--
                    Find in chains and Filter (chains-panel-at-scale criteria 1 to 11, Nigel 2026-11-25): outside the scroll
                    viewer, so they stay in reach however far the chains are scrolled.
                -->
                <StackPanel x:Name="ChainsFinder" DockPanel.Dock="Top" Margin="4,0,4,8">
                    <!-- The box first and Filter after it, in Tab order as on screen (review should-fix 2). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="ChainsSearchBox" MinHeight="32" Padding="8,0,32,0" VerticalContentAlignment="Center"
                                     Text="{Binding Chains.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                     ToolTip="Find chain cards by any part of a title, key, project, area, Jira key, tag, branch or repo. Esc clears."
                                     AutomationProperties.Name="Find in chains" AutomationProperties.AcceleratorKey="Ctrl+F"
                                     PreviewKeyDown="OnChainsSearchKeyDown" />
                            <TextBlock Text="Find in chains (Ctrl+F)" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ChainsSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource PanelIcon}" Content="&#xE894;" HorizontalAlignment="Right" Margin="0,0,4,0"
                                    ToolTip="Clear the search (Esc)" AutomationProperties.Name="Clear the search"
                                    Command="{Binding Chains.ClearSearchCommand}"
                                    Visibility="{Binding Text, ElementName=ChainsSearchBox, Converter={StaticResource NotEmptyToVisibility}}" />
                        </Grid>
                        <Button x:Name="ChainsFilterButton" Grid.Column="1" Style="{StaticResource ItemDropDown}" Margin="8,0,0,0"
                                Click="OnOverflowClick" PreviewKeyDown="OnChainsFilterKeyDown"
                                ToolTip="Filter the chains: active only, waiting on me, hide completed."
                                AutomationProperties.Name="Filter" AutomationProperties.HelpText="{Binding Chains.FilterHelpText}">
                            <StackPanel Orientation="Horizontal">
                                <controls:GlyphText Text="&#xE71C;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12"
                                                    Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Chains.FilterButtonText}" VerticalAlignment="Center" />
                                <controls:GlyphText Text="&#xE70D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="8"
                                                    Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{Binding Chains.ActiveOnlyText}" IsCheckable="True" IsChecked="{Binding Chains.ActiveOnly, Mode=TwoWay}"
                                              ToolTip="Keep cards with a session or something waiting on you, and the cards above them." />
                                    <MenuItem Header="{Binding Chains.WaitingOnMeText}" IsCheckable="True" IsChecked="{Binding Chains.WaitingOnMe, Mode=TwoWay}"
                                              ToolTip="Keep cards asking you something, with a report to confirm, or with a start to allow." />
                                    <MenuItem Header="{Binding Chains.HideCompletedText}" IsCheckable="True" IsChecked="{Binding Chains.HideCompleted, Mode=TwoWay}"
                                              ToolTip="Hide a chain once every card in it is done or archived and nothing in it waits on you." />
                                    <Separator />
                                    <MenuItem Header="Clear filters" Command="{Binding Chains.ClearFiltersCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ChainsHiddenSummary" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{Binding Chains.HiddenSummary, NotifyOnTargetUpdated=True}" TargetUpdated="OnChainsSummaryChanged"
                               Visibility="{Binding Chains.HiddenSummary, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>

                <!--
                    The tree has the panel's height to itself and scrolls on its own, so only the rows in view are built
                    (virtualised: 300 rows took over two seconds to lay out whole, Nigel 2026-11-25). What waits on the owner
                    sits above it, scrolling apart when it is long. PreviewMouseWheel on both moves them by the wheel's own
                    delta, so a touchpad's small steps scroll too.
                -->
                <Grid x:Name="ChainsBody">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                <ScrollViewer x:Name="ChainsTop" Grid.Row="0" MaxHeight="320" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnChainsPanelMouseWheel">
                    <StackPanel>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="4,0,4,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="No links yet. Open a card's details and use Link to, or Spawn follow-on."
                                   Visibility="{Binding Chains.HasNoChains, Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            Workstreams sessions have proposed. Review opens the proposal window, and only
                            Approve there makes the card; Reject takes a note the proposer reads back.
                        -->
                        <StackPanel Visibility="{Binding Chains.Proposals.Pending.Count, Converter={StaticResource CountToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="Proposed" Style="{StaticResource ListSectionHeader}" Margin="4,0,0,8" />
                            <ItemsControl AutomationProperties.Name="Proposed" ItemContainerStyle="{StaticResource ItemNamedByHeading}" ItemsSource="{Binding Chains.Proposals.Pending}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="8,8" CornerRadius="4" BorderThickness="4,0,0,0"
                                                BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                ToolTip="{Binding Evidence}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Heading}" FontSize="14" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding DoneCriteria}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Warnings}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource CautionTextBrush}"
                                                           Visibility="{Binding Warnings, Converter={StaticResource NotEmptyToVisibility}}" />
                                                <WrapPanel Margin="0,8,0,0"
                                                           Visibility="{Binding IsRejecting, Converter={StaticResource NotBoolToVisibility}}">
                                                    <Button Style="{StaticResource CommandButton}" Content="Review…" FontSize="12" Margin="0,0,8,0"
                                                            ToolTip="Open the proposal: Approve makes its card, Reject… turns it down."
                                                            Command="{Binding ReviewCommand}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Open brief" FontSize="12" Margin="0,0,8,0"
                                                            Command="{Binding OpenBriefCommand}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Reject…" FontSize="12" Margin="0,0,8,0"
                                                            Command="{Binding AskRejectCommand}" />
                                                </WrapPanel>
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding IsRejecting, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock x:Name="RejectNoteLabel" Text="Why you reject it (optional)" Style="{StaticResource CaptionText}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                                             AutomationProperties.LabeledBy="{x:Reference RejectNoteLabel}"
                                                             Margin="0,4,0,4" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource CommandButton}" Content="Reject" FontSize="12" Margin="0,0,8,0"
                                                                Command="{Binding RejectCommand}" />
                                                        <Button Style="{StaticResource CommandButton}" Content="Cancel" FontSize="12"
                                                                Command="{Binding CancelRejectCommand}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Refusal}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource CautionTextBrush}"
                                                           Visibility="{Binding Refusal, Converter={StaticResource NotEmptyToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,4,0,8" />
                        </StackPanel>

                        <!--
                            Reports waiting for Nigel, and reports lost. A report satisfies nothing on its
                            own: Confirm is one press for a done or go verdict, and any other opens the
                            reason box with the verdict in it. Not yet moves the row to the bottom.
                        -->
                        <StackPanel Visibility="{Binding Chains.NeedsYou.Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="Needs you" Style="{StaticResource ListSectionHeader}" Margin="4,0,0,8" />
                            <ItemsControl AutomationProperties.Name="Needs you" ItemContainerStyle="{StaticResource ItemNamedByHeading}" ItemsSource="{Binding Chains.NeedsYou}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="8,8" CornerRadius="4" BorderThickness="4,0,0,0"
                                                BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                ToolTip="{Binding Evidence}">
                                            <StackPanel>
                                                <TextBlock FontSize="14" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                    <Run Text="{Binding Glyph, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Heading, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <WrapPanel Margin="0,8,0,0"
                                                           Visibility="{Binding IsAskingReason, Converter={StaticResource NotBoolToVisibility}}">
                                                    <Button Style="{StaticResource CommandButton}" Content="Open report" FontSize="12" Margin="0,0,8,0"
                                                            Command="{Binding OpenReportCommand}"
                                                            Visibility="{Binding IsReported, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Confirm report…" FontSize="12" Margin="0,0,8,0"
                                                            ToolTip="Accept the report, which satisfies the link."
                                                            Command="{Binding ConfirmCommand}"
                                                            Visibility="{Binding IsReported, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Not yet" FontSize="12" Margin="0,0,8,0"
                                                            ToolTip="Leave it reported and move it below the others. It stays unconfirmed."
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Command="{Binding NotYetCommand}"
                                                            Visibility="{Binding IsReported, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding SetAsideText}" Style="{StaticResource CaptionText}" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding SetAsideText, Converter={StaticResource NotEmptyToVisibility}}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Reject…" FontSize="12" Margin="0,0,8,0"
                                                            ToolTip="Say why, then the report never satisfies the link and leaves this list; a new report can still be confirmed."
                                                            Command="{Binding AskRejectCommand}"
                                                            Visibility="{Binding IsReported, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Open handoff" FontSize="12" Margin="0,0,8,0"
                                                            Command="{Binding OpenHandoffCommand}"
                                                            Visibility="{Binding IsLost, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Mark satisfied…" FontSize="12" Margin="0,0,8,0"
                                                            Command="{Binding AskReasonCommand}"
                                                            Visibility="{Binding IsLost, Converter={StaticResource BoolToVisibility}}" />
                                                </WrapPanel>
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding IsAskingReason, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock x:Name="ReasonLabel" Text="{Binding ReasonQuestion}" Style="{StaticResource CaptionText}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                                             AutomationProperties.LabeledBy="{x:Reference ReasonLabel}"
                                                             Margin="0,4,0,4" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource CommandButton}" Content="Mark satisfied" FontSize="12" Margin="0,0,8,0"
                                                                Command="{Binding SatisfyCommand}"
                                                                Visibility="{Binding IsRejecting, Converter={StaticResource NotBoolToVisibility}}" />
                                                        <Button Style="{StaticResource CommandButton}" Content="Reject" FontSize="12" Margin="0,0,8,0"
                                                                Command="{Binding RejectCommand}"
                                                                Visibility="{Binding IsRejecting, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Style="{StaticResource CommandButton}" Content="Cancel" FontSize="12"
                                                                Command="{Binding CancelReasonCommand}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Refusal}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource CautionTextBrush}"
                                                           Visibility="{Binding Refusal, Converter={StaticResource NotEmptyToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,4,0,8" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Chains.ShownReady.Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="Ready" Style="{StaticResource ListSectionHeader}" Margin="4,0,0,8" />
                            <ItemsControl AutomationProperties.Name="Ready" ItemContainerStyle="{StaticResource ItemNamedByTitle}" ItemsSource="{Binding Chains.ShownReady}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="8,8" CornerRadius="4" BorderThickness="4,0,0,0"
                                                BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <StackPanel>
                                                <!-- A long title ends in "…", as in the tree (links-tree-scrollbar question 3, Nigel 2026-11-19). -->
                                                <Button FontSize="12" Padding="0" HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        AutomationProperties.HelpText="Open this card's details"
                                                        Command="{Binding Show}">
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"  FontSize="14"/>
                                                            <TextBlock Text="Open this card's details" />
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <TextBlock Text="{Binding WaitsOn}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,4,0,8" />
                        </StackPanel>

                        <TextBlock Text="Chains" Style="{StaticResource ListSectionHeader}" Margin="4,0,0,8"
                                   Visibility="{Binding Chains.Roots.Count, Converter={StaticResource CountToVisibility}}" />
                        <TextBlock x:Name="ChainsNoMatch" Text="{Binding Chains.NoMatchText}" FontSize="12" TextWrapping="Wrap" Margin="4,0,4,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Chains.NoMatchText, Converter={StaticResource NotEmptyToVisibility}}" />
                        <DockPanel Margin="4,0,4,8" Visibility="{Binding Chains.AllHiddenText, Converter={StaticResource NotEmptyToVisibility}}">
                            <Button Style="{StaticResource CommandButton}" Content="Clear filters" FontSize="12" DockPanel.Dock="Right"
                                    Margin="8,0,0,0" Command="{Binding Chains.ClearFiltersCommand}" />
                            <TextBlock Text="{Binding Chains.AllHiddenText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
                        <!--
                            No sideways scrolling: under the Fluent theme the tree's own horizontal bar was drawn over
                            its bottom row (links-tree-scrollbar, Nigel 2026-11-19). A long title trims instead.
                        -->
                        <TreeView x:Name="ChainsTree" Grid.Row="1" ItemsSource="{Binding Chains.Roots}" BorderThickness="0" Background="Transparent"
                                  AutomationProperties.Name="Chains"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  PreviewMouseWheel="OnChainsPanelMouseWheel"
                                  Visibility="{Binding Chains.Roots.Count, Converter={StaticResource CountToVisibility}}">
                            <!--
                                The standard item lays its header out in an auto-width column, so a row was never held
                                to the tree's width and a long title could not trim. This one stretches the header,
                                keeps a chevron for rows with children, and indents children.
                            -->
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <!-- The row's title and its state's word, not the record's ToString (E11, W50, G170; chains-panel-at-scale 12). -->
                                    <Setter Property="AutomationProperties.Name" Value="{Binding ScreenName}" />
                                    <!-- Each level's rows virtualised too, not only the chains at the top. -->
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <StackPanel>
                                                    <Border x:Name="Highlight" Background="Transparent" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" Focusable="False" Cursor="Hand" Width="24" Height="24"
                                                                      VerticalAlignment="Top" Margin="-4,0,0,0"
                                                                      AutomationProperties.Name="Show or hide the cards this one hands over to"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent">
                                                                        <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" />
                                                        <!-- Fluent's own selection mark: the fill alone is too faint to see (re-verify should-fix 1). -->
                                                        <Border x:Name="SelectionBar" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </Grid>
                                                    </Border>
                                                    <ItemsPresenter x:Name="Children" Margin="16,0,0,0" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <!-- The arrow keys move the selection: the row they are on shows (review should-fix 1). -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Highlight" Property="Background"
                                                                Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsExpanded" Value="False">
                                                        <Setter TargetName="Children" Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="HasItems" Value="False">
                                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShown}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Border Padding="8,4" BorderThickness="4,0,0,0"
                                            BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                                        <!-- A finished card, or one kept only as the context of a match below it, is drawn quieter. -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Opacity" Value="0.7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsContext}" Value="True">
                                                        <Setter Property="Opacity" Value="0.7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel>
                                                <!--
                                                    One click to its tab (item 8): four before, through the drawer's Overview. On every row, greyed with
                                                    its reason while the card has no session to bring forward, so no row is missing it unexplained
                                                    (1.5 walkthrough row 12; W31, G157).
                                                -->
                                                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                        Command="{Binding Focus}" IsEnabled="{Binding HasFocus}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        AutomationProperties.Name="{Binding Title, StringFormat=Focus {0}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:GlyphText Text="&#xE8A7;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBlock Text="Focus" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="ToolTip" Value="Focus: bring the session's window forward." />
                                                            <Setter Property="AutomationProperties.HelpText" Value="Focus: bring the session's window forward." />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="ToolTip" Value="No session to bring forward: it opens when the card is started." />
                                                                    <Setter Property="AutomationProperties.HelpText" Value="No session to bring forward: it opens when the card is started." />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!--
                                                    One mark and word for the card's state (chains-panel-at-scale criterion 12): the mark and word carry
                                                    it, and colour only repeats it.
                                                -->
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="12" Margin="8,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RowState}" Value="Running">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RowState}" Value="Ready">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RowState}" Value="Done">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding NeedsOwner}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button FontSize="12" Padding="0" HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        AutomationProperties.HelpText="Open this card's details"
                                                        Command="{Binding Show}">
                                                    <!-- A project's header is a heading, not a card: nothing to open. -->
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                                    <Setter Property="Focusable" Value="False" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"  FontSize="14"/>
                                                            <TextBlock Text="Open this card's details" />
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                    <TextBlock controls:HighlightedText.Text="{Binding Title}" controls:HighlightedText.Spans="{Binding TitleHighlights}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Copy}" FontSize="12" FontFamily="Consolas"
                                                       ToolTip="Another card has the same title: this is its key"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding Copy, Converter={StaticResource NotEmptyToVisibility}}" />
                                            <TextBlock Text="{Binding WaitsOn}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding WaitsOn, Converter={StaticResource NotEmptyToVisibility}}" />
                                            <TextBlock Text="{Binding ReportsBack}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding ReportsBack, Converter={StaticResource NotEmptyToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                </Grid>
            </DockPanel>
        </Border>
        <!--
            The machine's locks, held by Theseus (Nigel, 2026-10-06), opened from the command bar like the
            live sessions panel and docked on the other side so both can be open. One card per lock, free
            or not. Reordering, cancelling and releasing happen here and nowhere else; Release asks twice,
            because it does not stop the holder's run and another may then start beside it.
        -->
        <Border x:Name="LocksPane" DockPanel.Dock="Right" Width="340" MinWidth="280" MaxWidth="560" Margin="0,8,12,12"
                CornerRadius="8" Padding="12"
                Visibility="{Binding Locks.IsOpen, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <controls:PaneResizeThumb AutomationProperties.Name="Resize the locks panel" DockPanel.Dock="Left" Style="{StaticResource PaneEdge}" Margin="-16,-12,0,-12" HorizontalAlignment="Left"
                                          Pane="{Binding ElementName=LocksPane}" IsOnTheRight="True" />
                <Grid DockPanel.Dock="Top" Margin="4,4,4,8">
                    <!-- Locks and Chains are two views of the side panel: a selector bar (W15, D7, G125). -->
                    <controls:SelectorGroup x:Name="LocksPaneSwitch" Orientation="Horizontal" AutomationProperties.Name="Views of the side panel"
                                KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                        <RadioButton Content="Locks" Style="{StaticResource PanelSwitchItem}" GroupName="LocksPaneSwitch"
                                     IsChecked="{Binding Locks.IsOpen, Mode=OneWay}" controls:SelectorBar.SelectsOnFocus="True"
                                     ToolTip="Show the locks panel." Command="{Binding Locks.OpenCommand}" />
                        <RadioButton Content="Chains" Style="{StaticResource PanelSwitchItem}" GroupName="LocksPaneSwitch"
                                     IsChecked="{Binding Chains.IsOpen, Mode=OneWay}" controls:SelectorBar.SelectsOnFocus="True"
                                     ToolTip="Show the chains panel." Command="{Binding Chains.OpenCommand}" />
                    </controls:SelectorGroup>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Expand all and Collapse all, with the Chains panel's glyphs (Nigel, 2026-11-26). -->
                        <Button x:Name="LocksCollapseAll" Style="{StaticResource PanelIcon}" Content="&#xF165;" Margin="0,0,4,0"
                                ToolTip="Collapse all: show only the lock names." AutomationProperties.Name="Collapse all"
                                Command="{Binding Locks.CollapseAllCommand}" />
                        <Button x:Name="LocksExpandAll" Style="{StaticResource PanelIcon}" Content="&#xF164;" Margin="0,0,8,0"
                                ToolTip="Expand all: show every lock's holds, queue and actions." AutomationProperties.Name="Expand all"
                                Command="{Binding Locks.ExpandAllCommand}" />
                        <Button Style="{StaticResource PanelIcon}" Content="&#xE897;" Margin="0,0,8,0"
                                ToolTip="Locks help, in your browser" AutomationProperties.Name="Locks help"
                                AutomationProperties.HelpText="Opens nigelbasel.github.io/Theseus in your browser"
                                Command="{Binding Help.OpenCommand}" CommandParameter="locks" />
                        <Button Style="{StaticResource PanelIcon}" Content="&#xE8BB;"
                                ToolTip="Hide the locks panel (F8)" AutomationProperties.Name="Hide locks"
                                AutomationProperties.AcceleratorKey="F8"
                                Command="{Binding Locks.ToggleCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl AutomationProperties.Name="Locks" ItemContainerStyle="{StaticResource ItemNamedByName}" ItemsSource="{Binding Locks.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="4" CornerRadius="4"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <!-- Folded, one line: the name, its state and counts, and ⚠ in words when it waits on you (Nigel, 2026-11-26). -->
                                            <controls:FoldToggle Style="{StaticResource LockFold}" IsChecked="{Binding Fold.IsExpanded, Mode=TwoWay}"
                                                                 AutomationProperties.Name="{Binding ScreenName}"
                                                                 ToolTip="Unfold for the holds, the queue and what you can do; Right and Left unfold and fold.">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0" Text="{Binding StateText}"
                                                               TextAlignment="Right" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NeedsOwner}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Grid>
                                            </controls:FoldToggle>

                                            <StackPanel Margin="24,0,0,4" Visibility="{Binding Fold.IsExpanded, Converter={StaticResource BoolToVisibility}}">

                                                <TextBlock Text="{Binding Guards}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                <TextBlock Text="{Binding Capacity}" FontSize="12" Margin="0,2,0,0"
                                                           Visibility="{Binding Capacity, Converter={StaticResource NotEmptyToVisibility}}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding IsHeld, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Held by" FontSize="12" Margin="0,0,0,4"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <ItemsControl AutomationProperties.Name="Held by" ItemContainerStyle="{StaticResource ItemNamedByText}" ItemsSource="{Binding Holders}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,8">
                                                                    <Border Margin="0,0,0,4" Padding="8,4" CornerRadius="4" BorderThickness="4,0,0,0"
                                                                            AutomationProperties.Name="{Binding Text}"
                                                                            BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                                                                        <StackPanel>
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"
                                                                                           Text="{Binding HeldFor}"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap"
                                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                            </DockPanel>
                                                                            <TextBlock Text="{Binding Amount, StringFormat='{}{0} slots'}" FontSize="12"
                                                                                       Visibility="{Binding Amount, Converter={StaticResource NotEmptyToVisibility}}"
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                            <TextBlock Text="{Binding Idle, StringFormat='⚠ {0}: release it if it is no longer needed'}" FontSize="12"
                                                                                       TextWrapping="Wrap"
                                                                                       Visibility="{Binding IsAmber, Converter={StaticResource BoolToVisibility}}"
                                                                                       Foreground="{DynamicResource CautionTextBrush}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Button Style="{StaticResource CommandButton}" Content="Release…" HorizontalAlignment="Left"
                                                                            ToolTip="Take this hold from its holder. Its run keeps going."
                                                                            Command="{Binding AskReleaseCommand}"
                                                                            Visibility="{Binding CanAskRelease, Converter={StaticResource BoolToVisibility}}" />
                                                                    <StackPanel Visibility="{Binding IsConfirmingRelease, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="Its run keeps going, and the next in line may start beside it." FontSize="12"
                                                                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Button Style="{StaticResource CommandButton}" Content="Release" Margin="0,0,8,0"
                                                                                    Command="{Binding ConfirmReleaseCommand}" />
                                                                            <Button Style="{StaticResource CommandButton}" Content="Keep"
                                                                                    Command="{Binding KeepCommand}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding Waiting.Count, Converter={StaticResource CountToVisibility}}">
                                                    <!-- The queue folds on its own, so a long one does not push the other locks down. -->
                                                    <controls:FoldToggle Style="{StaticResource LockFold}" Margin="0,0,0,4"
                                                                         IsChecked="{Binding QueueFold.IsExpanded, Mode=TwoWay}"
                                                                         AutomationProperties.Name="{Binding QueueHeading}">
                                                        <TextBlock Text="{Binding QueueHeading}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </controls:FoldToggle>
                                                    <ItemsControl AutomationProperties.Name="Waiting, in order" ItemContainerStyle="{StaticResource ItemNamedByWho}" ItemsSource="{Binding Waiting}"
                                                                  Visibility="{Binding QueueFold.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,8" Padding="8,8" CornerRadius="4"
                                                                        BorderThickness="4,0,0,0"
                                                                        BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                                <Run Text="waiting " />
                                                                                <Run Text="{Binding WaitingFor, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                            <TextBlock FontSize="14" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                                                <Run Text="{Binding Position, Mode=OneWay}" />
                                                                                <Run Text=". " />
                                                                                <Run Text="{Binding Who, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding Purpose}" FontSize="12" TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        <TextBlock Text="{Binding Reason, StringFormat=Reason: {0}}" FontSize="12" TextWrapping="Wrap"
                                                                                   Visibility="{Binding Reason, Converter={StaticResource NotEmptyToVisibility}}"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        <WrapPanel Margin="0,8,0,0">
                                                                            <Button Style="{StaticResource CommandButton}" Content="Move up" Margin="0,0,8,0"
                                                                                    ToolTip="Move one place towards the front."
                                                                                    Command="{Binding MoveUpCommand}" />
                                                                            <Button Style="{StaticResource CommandButton}" Content="Move down" Margin="0,0,8,0"
                                                                                    ToolTip="Move one place back."
                                                                                    Command="{Binding MoveDownCommand}" />
                                                                            <Button Style="{StaticResource CommandButton}" Content="Cancel request"
                                                                                    ToolTip="Take it out of the queue. Its script is told it was cancelled."
                                                                                    Command="{Binding CancelCommand}" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,0,0,4" Padding="4" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding Locks.NeedsRuling, Converter={StaticResource NotEmptyToVisibility}}">
                            <StackPanel>
                                <controls:FoldToggle Style="{StaticResource LockFold}" IsChecked="{Binding Locks.NeedsRulingFold.IsExpanded, Mode=TwoWay}"
                                                     AutomationProperties.Name="Not ruled on yet">
                                    <TextBlock Text="Not ruled on yet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </controls:FoldToggle>
                                <StackPanel Margin="24,0,0,4" Visibility="{Binding Locks.NeedsRulingFold.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{Binding Locks.NeedsRuling, StringFormat='Each is held alone until the arbiter named in Options rules on it: {0}'}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,4" Padding="4" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding Locks.Rulings.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <controls:FoldToggle Style="{StaticResource LockFold}" IsChecked="{Binding Locks.RulingsFold.IsExpanded, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Locks.Rulings.Count, StringFormat='Rulings ({0})'}">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="Rulings" /><Run Text=" (" /><Run Text="{Binding Locks.Rulings.Count, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </controls:FoldToggle>
                                <StackPanel Margin="24,0,0,4" Visibility="{Binding Locks.RulingsFold.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl AutomationProperties.Name="Rulings" ItemContainerStyle="{StaticResource ItemNamedByName}" ItemsSource="{Binding Locks.Rulings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Button Style="{StaticResource CommandButton}" Content="Overturn" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            ToolTip="Take this ruling out: the resource is held alone again until it is ruled on."
                                                            Command="{Binding OverturnCommand}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,4" Padding="4" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding Locks.StoppedDeadlocks.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <controls:FoldToggle Style="{StaticResource LockFold}" IsChecked="{Binding Locks.DeadlocksFold.IsExpanded, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Locks.StoppedDeadlocks.Count, StringFormat='Stopped deadlocks ({0})'}">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="Stopped deadlocks" /><Run Text=" (" /><Run Text="{Binding Locks.StoppedDeadlocks.Count, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </controls:FoldToggle>
                                <StackPanel Margin="24,0,0,4" Visibility="{Binding Locks.DeadlocksFold.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Requests refused because granting them would have left two or more sessions waiting on each other for ever. Nothing was stopped."
                                               FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl AutomationProperties.Name="Stopped deadlocks" ItemContainerStyle="{StaticResource ItemNamedBySelf}" ItemsSource="{Binding Locks.StoppedDeadlocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!--
                            Testcontainers containers no lock holder accounts for: leftovers from before the
                            lock, or from a run that went around the guard, which nothing will ever reap. One
                            cost a workstream a day on 2026-10-02. Shown for Nigel to remove, never removed
                            automatically, because one cannot be told apart from a run outside the lock.
                        -->
                        <Border Margin="0,0,0,4" Padding="4" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CautionTextBrush}" BorderThickness="1"
                                Visibility="{Binding Locks.Unowned.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <controls:FoldToggle Style="{StaticResource LockFold}" IsChecked="{Binding Locks.UnownedFold.IsExpanded, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Locks.Unowned.Count, StringFormat='Unowned test containers ({0})'}">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="Unowned test containers" /><Run Text=" (" /><Run Text="{Binding Locks.Unowned.Count, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </controls:FoldToggle>
                                <StackPanel Margin="24,0,0,4" Visibility="{Binding Locks.UnownedFold.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="No lock holder accounts for these. A leftover like this can make the next suite fail as if it were broken. Remove only what you know is not a run in progress." />
                                    <ItemsControl AutomationProperties.Name="Unowned test containers" ItemContainerStyle="{StaticResource ItemNamedByName}" ItemsSource="{Binding Locks.Unowned}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="8,8" CornerRadius="4"
                                                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{Binding Age, Mode=OneWay}" />
                                                                <Run Text=" old" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Image}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Status}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding StartedDuring}" FontSize="12" TextWrapping="Wrap"
                                                                   Visibility="{Binding StartedDuring, Converter={StaticResource NotEmptyToVisibility}}"
                                                                   Foreground="{DynamicResource CautionTextBrush}" />
                                                        <Button Style="{StaticResource CommandButton}" Content="Remove…" Margin="0,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                ToolTip="Stop and delete this container."
                                                                Command="{Binding AskRemoveCommand}"
                                                                Visibility="{Binding CanAskRemove, Converter={StaticResource BoolToVisibility}}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                    Visibility="{Binding IsConfirmingRemove, Converter={StaticResource BoolToVisibility}}">
                                                            <Button Style="{StaticResource CommandButton}" Content="Remove" Margin="0,0,8,0"
                                                                    Command="{Binding ConfirmRemoveCommand}" />
                                                            <Button Style="{StaticResource CommandButton}" Content="Keep"
                                                                    Command="{Binding KeepCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--
            The status bar holds readings and nothing that asks anything. The latest notice sits at
            its left, as most Windows apps put their status message, with the earlier ones a click
            away; the counts, usage, locks, version and account follow on the right.
        -->
        <Border DockPanel.Dock="Bottom" MinHeight="32" Padding="12,0"
                Visibility="{Binding IsStatusBarVisible, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The latest notice; pressed, it shows the recent ones in a flyout, not in a menu of disabled items (W33, C11, G49). -->
                <ToggleButton x:Name="NoticeButton" Grid.Column="0" HorizontalAlignment="Left" Padding="4,0" MinHeight="32"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalContentAlignment="Left"
                        ToolTip="{Binding Notice}" AutomationProperties.Name="{Binding Notice}"
                        AutomationProperties.ItemStatus="{Binding NoticeSeverity}"
                        AutomationProperties.HelpText="Shows the recent notices"
                        PreviewKeyDown="OnNoticeFlyoutKeyDown"
                        Visibility="{Binding Notice, Converter={StaticResource NotEmptyToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Information E946, Warning E7BA, Error E783, each in its own colour: the shape says it without the colour (W46, G150). -->
                        <controls:GlyphText x:Name="NoticeGlyph" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12" Margin="0,0,8,0"
                                   VerticalAlignment="Center">
                            <controls:GlyphText.Style>
                                <Style TargetType="controls:GlyphText">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeSeverity}" Value="{x:Static vm:NoticeSeverity.Warning}">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoticeSeverity}" Value="{x:Static vm:NoticeSeverity.Error}">
                                            <Setter Property="Text" Value="&#xE783;" />
                                            <Setter Property="Foreground" Value="{DynamicResource CriticalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:GlyphText.Style>
                        </controls:GlyphText>
                        <TextBlock Text="{Binding Notice}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <controls:GlyphText Text="&#xE70D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="8" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="NoticePopup" PlacementTarget="{Binding ElementName=NoticeButton}" Placement="Top" StaysOpen="False"
                       AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=NoticeButton, Mode=TwoWay}">
                    <Border x:Name="NoticeFlyout" Padding="16" CornerRadius="8" MinWidth="320" MaxWidth="640" MaxHeight="420"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="{DynamicResource FlyoutBorderThickness}"
                            PreviewKeyDown="OnNoticeFlyoutKeyDown">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Recent notices" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemContainerStyle="{StaticResource ItemNamedByDisplay}" x:Name="NoticeHistory" ItemsSource="{Binding Notices.Entries}" Focusable="False"
                                              AutomationProperties.Name="Recent notices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- While a search or tag filter is on, the count says how many match (card-search-and-tags item 5). -->
                    <TextBlock x:Name="SearchStatus" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Board.Search.StatusText}"
                               Visibility="{Binding Board.Search.HasStatus, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="IncludeArchived" Style="{StaticResource CommandButton}" Content="Include archived" FontSize="12"
                            Padding="8,0" Margin="8,4,0,4" VerticalAlignment="Center"
                            ToolTip="Show the archive, keeping the search: an archived card matches it."
                            Command="{Binding IncludeArchivedCommand}"
                            Visibility="{Binding Board.Search.ShowsIncludeArchived, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="HeadlessStatus" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="{Binding HeadlessCounts}"
                               ToolTip="Headless runs going now, and those waiting for a slot under the machine-wide cap."
                               Visibility="{Binding HeadlessCounts, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding Board.Status, Mode=OneWay}" />
                        <Run Text="{Binding Board.ShowsNoteInStatus, Mode=OneWay}" />
                        <Run Text="{Binding Board.ActiveOnlyNoteInStatus, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding SelectionSummary, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{Binding Resources.MachineText}" FontSize="12" Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Resources.MachineTooltip}"
                               Visibility="{Binding Resources.MachineText, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!--
                        Cores held back (parked-cores, Nigel 2026-11-19): shown only while most processors are parked
                        and the rest saturated, in the board's amber, with the likely cause in the tooltip.
                    -->
                    <TextBlock Text="{Binding Resources.ClampText, StringFormat=⚠ {0}}" FontSize="12" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Resources.ClampTooltip}"
                               Visibility="{Binding Resources.ClampText, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource CautionTextBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Usage.HasReading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Usage.SessionText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="  ·  " FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Usage.WeeklyText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="  ·  " FontSize="12"
                                   Visibility="{Binding Usage.BindingText, Converter={StaticResource NotEmptyToVisibility}}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock FontSize="12"
                                   Visibility="{Binding Usage.BindingText, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Usage.BindingText}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Usage.IsWarning}" Value="True">
                                            <Setter Property="Text" Value="{Binding Usage.BindingText, StringFormat='⚠ {0}, usage high'}" />
                                            <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Usage.Age, StringFormat='  ({0})'}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Usage.Problem}" FontSize="12" Margin="16,0,0,0"
                               VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Usage.Problem}" behaviors:TrimmedToolTip.IsEnabled="True"
                               Visibility="{Binding Usage.Problem, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Button Style="{StaticResource PanelIcon}" Content="&#xE72C;" Margin="4,0,0,0"
                            ToolTip="Read usage now" AutomationProperties.Name="Read usage now" Command="{Binding Usage.RefreshCommand}" />

                    <!-- When GitHub was last read for cards' pull requests and CI, with the calls left in the tooltip (pr-ci-status AC 16). -->
                    <TextBlock x:Name="GitHubStatus" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                               Text="{Binding CiStatus.Text}" ToolTip="{Binding CiStatus.Tooltip}"
                               AutomationProperties.HelpText="{Binding CiStatus.Tooltip}"
                               Visibility="{Binding CiStatus.Text, Converter={StaticResource NotEmptyToVisibility}, FallbackValue=Collapsed}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CiStatus.IsCaution}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="The machine's shared locks, held by Theseus"
                               Visibility="{Binding Locks.Summary, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Locks.Summary}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Locks.HasLongHold}" Value="True">
                                        <Setter Property="Text" Value="{Binding Locks.Summary, StringFormat='⚠ {0}, one held long'}" />
                                        <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Account}" FontSize="12" Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="The Claude account every session on this machine runs as"
                               Visibility="{Binding Account, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Version}" FontSize="12" Margin="16,0,4,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding VersionDescribed}"
                               Visibility="{Binding Version, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <DockPanel Margin="8,0,8,8">
                <!--
                    Stops asked for before this Theseus opened wait for an answer here.

                    A request survives the board being closed on purpose - the session was asked to
                    stop, wrote its handoff, and nothing ever typed the exit - but finishing it
                    silently on the next launch closes sessions within a second of startup. Two of
                    Nigel's went that way on 2026-09-02, 0.8s after the window appeared.

                    It asks in place rather than in a message box, and names the sessions, which is
                    the same way deleting asks. Nothing happens until one of the two is pressed, so
                    the board stays usable and the question cannot fire before it has been read.
                -->
                <Border DockPanel.Dock="Top" Margin="4,0,4,8" Padding="12,8" CornerRadius="4"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasUnconfirmedStops, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource CommandButton}" Content="Close the_m"
                                    Margin="0,0,8,0"
                                    ToolTip="Finish the stop: each session is told to exit."
                                    Command="{Binding ConfirmStopsCommand}" />
                            <Button Style="{StaticResource CommandButton}" Content="Leave them running"
                                    ToolTip="Drop the request and carry on."
                                    Command="{Binding AbandonStopsCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding UnconfirmedStopsSummary}" FontSize="14"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <!--
                    Cards a Start held back because they still wait on an input (Nigel, 2026-10-21). A
                    fresh session with nothing to read only goes looking for a document that is not there
                    yet, so these are asked about, whether one card was pressed or a whole selection.
                -->
                <Border DockPanel.Dock="Top" Margin="4,0,4,8" Padding="12,8" CornerRadius="4"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasHeldForInputs, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource CommandButton}" Content="Start without their i_nputs"
                                    Margin="0,0,8,0"
                                    ToolTip="Start them anyway, before what they wait on has been accepted."
                                    Command="{Binding StartWithoutInputsCommand}" />
                            <Button Style="{StaticResource CommandButton}" Content="Skip them"
                                    ToolTip="Leave them unstarted until their inputs are accepted."
                                    Command="{Binding SkipWaitingCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding HeldForInputsSummary}" FontSize="14"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <!-- While a search or tag filter is on, the board says so, so it never looks complete when it is not (item 17). -->
                <Border x:Name="FilteredLine" DockPanel.Dock="Top" Margin="4,0,4,8" Padding="12,8" CornerRadius="4"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource SearchHighlightBrush}" BorderThickness="1"
                        DataContext="{Binding Board.Search}"
                        Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock Text="{Binding FilteredLine}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FilteredLine}" behaviors:TrimmedToolTip.IsEnabled="True"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <!--
                    The stage headings, written once. The left margin matches the width of a row's
                    header so the headings line up with the cells beneath them; both are fixed, and
                    they have to stay in step.
                -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,8"
                      Visibility="{Binding IsBoardShown, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl AutomationProperties.Name="Stages" Grid.Column="1" ItemsSource="{Binding Board.StageHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:StageColumnsPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter" BasedOn="{StaticResource ItemNamedByStage}">
                                <Setter Property="controls:StageColumnsPanel.IsFolded" Value="{Binding IsCollapsed}" />
                                <Setter Property="controls:StageColumnsPanel.Weight" Value="{Binding Weight}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StageHeaderViewModel}">
                                <Grid>
                                <!-- Drag to move the edge between this column and the next; double-click to make them all even. -->
                                <Thumb AutomationProperties.Name="Resize stage columns" HorizontalAlignment="Right" Width="8" Cursor="SizeWE"
                                       ToolTip="Drag to resize the columns either side. Double-click to make them all even."
                                       DragDelta="OnColumnEdgeDrag" DragCompleted="OnSizeDragCompleted"
                                       PreviewMouseLeftButtonDown="OnColumnEdgeDown"
                                       Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent">
                                                <Border x:Name="Line" Width="1" HorizontalAlignment="Center" Opacity="0"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Line" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <DockPanel Margin="4,0,8,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CommandButton}"
                                            FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12"
                                            Padding="4,0" VerticalAlignment="Center"
                                            ToolTip="{Binding ToggleTooltip}"
                                            AutomationProperties.Name="{Binding ToggleTooltip}"
                                            Command="{Binding ToggleCommand}">
                                        <controls:GlyphText Text="{Binding Glyph}" />
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Text="{Binding LiveCount, StringFormat='&#x25CF; {0}'}"
                                               ToolTip="Cards in this stage with a session running"
                                               Foreground="{DynamicResource StateBusyBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCollapsed}" Value="True" />
                                                            <Condition Binding="{Binding LiveCount, Converter={StaticResource CountToVisibility}}"
                                                                       Value="{x:Static Visibility.Visible}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Folded, the heading is too narrow for "2 match", so the count sits in a pill and the words in its tooltip (review R5). -->
                                    <TextBlock x:Name="HeaderMatchCount" DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" Padding="4,0"
                                               VerticalAlignment="Center" Text="{Binding MatchCount}" ToolTip="{Binding MatchText}" AutomationProperties.Name="{Binding MatchText}"
                                               Background="{DynamicResource SearchHighlightBrush}"
                                               Foreground="{DynamicResource SearchHighlightTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCollapsed}" Value="True" />
                                                            <Condition Binding="{Binding MatchText, Converter={StaticResource NotEmptyToVisibility}}"
                                                                       Value="{x:Static Visibility.Visible}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Stage}" FontSize="14" FontWeight="SemiBold"
                                               Margin="4,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip="{Binding Stage}" behaviors:TrimmedToolTip.IsEnabled="True"
                                               Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVisibility}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!--
                    Dragging on empty board draws a rubber band that selects every card it touches,
                    with Ctrl adding to the selection; a click on empty board clears it.
                -->
                <!-- The board, or the open project's view in its place (project-view AC 14). -->
                <Grid>
                <Grid x:Name="BoardSurface" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                      KeyboardNavigation.IsTabStop="False"
                      Visibility="{Binding IsBoardShown, Converter={StaticResource BoolToVisibility}}"
                      PreviewMouseLeftButtonDown="OnBoardMouseDown"
                      PreviewMouseMove="OnBoardMouseMove"
                      PreviewMouseLeftButtonUp="OnBoardMouseUp">
                    <!-- Del archives on the board only, not in the project view or drawer, where the ticks are out of sight (W27, G79). -->
                    <Grid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding ArchiveSelectedCommand}" />
                    </Grid.InputBindings>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl AutomationProperties.Name="Board" ItemContainerStyle="{StaticResource ItemNamedByArea}" ItemsSource="{Binding Board.Rows}"
                                      ItemTemplate="{StaticResource RowTemplate}" />
                    </ScrollViewer>
                    <Canvas x:Name="BandLayer" IsHitTestVisible="False">
                        <Rectangle x:Name="Band" Visibility="Collapsed" StrokeThickness="1" Opacity="0.35"
                                   Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Canvas>
                </Grid>
                <DockPanel Visibility="{Binding IsProjectViewShown, Converter={StaticResource BoolToVisibility}}">
                    <!-- The tab strip, outside any one project, so All projects has it too (project-view-as-tabs AC 1, 3). -->
                    <views:ProjectTabStrip x:Name="ProjectTabStrip" DockPanel.Dock="Top" Margin="4,0,4,0" />
                    <Grid>
                        <views:ProjectView x:Name="ProjectPane" Margin="4,0,4,0" DataContext="{Binding ProjectView}"
                                           Visibility="{Binding DataContext.IsProjectOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                        <!-- 1.5b's kanban, drawn by its own implicit data template. -->
                        <ContentControl x:Name="AllProjectsPane" Margin="4,0,4,0" Content="{Binding AllProjectsView}" Focusable="False"
                                        Visibility="{Binding IsAllProjectsOpen, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
                </Grid>
            </DockPanel>

            <!--
                Detail drawer: a slim panel in tabs (Nigel, 2026-10-22). It was one column of sixteen
                sections under one Save, which also closed the drawer, and a half-made link was lost to it
                without a word. Everything here applies as it is made, so there is no Save; a card's setup
                is edited in its own dialog, further down.
            -->
            <Border x:Name="DrawerPane" HorizontalAlignment="Right" Width="480" MinWidth="400" MaxWidth="720" Margin="0,0,0,8" IsVisibleChanged="OnDrawerShown"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding Drawer.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="16,16,16,16">
                    <controls:PaneResizeThumb AutomationProperties.Name="Resize the details" DockPanel.Dock="Left" Style="{StaticResource PaneEdge}" Margin="-20,-16,8,-16"
                                              Pane="{Binding ElementName=DrawerPane}" IsOnTheRight="True" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{Binding Drawer.ColorHex, Converter={StaticResource HexToSwatch}}"
                                ToolTip="Permanent. A change applies from the next launch." />
                        <TextBlock Grid.Column="1" Text="{Binding Drawer.Title}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Drawer.Key, Converter={StaticResource TagToolTip}, ConverterParameter=Key: {0}}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Drawer.ArchiveWhyNot}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Drawer.IsLive, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Archive and Delete are rare, and Delete cannot be undone, so they wait behind a menu. -->
                        <Button Grid.Column="3" Style="{StaticResource PanelIcon}" Content="&#xE712;" Margin="8,0,8,0"
                                ToolTip="More: archive or delete this workstream." AutomationProperties.Name="More"
                                Click="OnOverflowClick">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                          RelativeSource={RelativeSource Self}}">
                                    <!-- Fixed labels, the pair that does not apply removed (W30, C10); the reason it is off is the inline text beside the title (W33, C11). -->
                                    <MenuItem Header="_Archive"
                                              Command="{Binding Drawer.ArchiveCommand}"
                                              Visibility="{Binding Drawer.IsArchived, Converter={StaticResource NotBoolToVisibility}}"
                                              ToolTip="Hide this workstream without losing it. Restore it from Archived." />
                                    <MenuItem Header="_Restore"
                                              Command="{Binding Drawer.ArchiveCommand}"
                                              Visibility="{Binding Drawer.IsArchived, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="Bring this workstream back onto the board." />
                                    <MenuItem Header="_Delete…"
                                              Command="{Binding Drawer.DeleteCommand}"
                                              ToolTip="Destroy this workstream and its plan file. Its notes and its work are left alone." />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource CommandButton}" Grid.Column="4" Content="Close"
                                Command="{Binding Drawer.CloseCommand}" />
                    </Grid>


                    <!-- The tabs first and the delete question after them, so Tab reaches them in reading order (B-m3, G65). -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TabControl Grid.Row="0" SelectedIndex="{Binding Drawer.SelectedTabIndex}"
                                    Background="Transparent" BorderThickness="0" Padding="0,8,0,0">
                            <TabItem Header="Overview">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Drawer.Card.StatusLine}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Drawer.Card.Model}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding Drawer.Card.Model, Converter={StaticResource NotEmptyToVisibility}}" />

                                        <!-- Who starts it, as its box says, in a running project (item 5, for the drawer: Nigel 2026-11-23). -->
                                        <TextBlock x:Name="DrawerStartedBy" Text="{Binding Drawer.StartedBy}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding Drawer.HasStartedBy, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource CommandButton}" Content="{Binding Drawer.StartLabel}" Margin="0,0,8,0"
                                                    ToolTip="{Binding Drawer.Card.RestartCost}"
                                                    Visibility="{Binding Drawer.Card.IsLive, Converter={StaticResource NotBoolToVisibility}}"
                                                    Command="{Binding StartCardCommand}"
                                                    CommandParameter="{Binding Drawer.Card}" />
                                            <Button Style="{StaticResource CommandButton}" Content="_Stop" Margin="0,0,8,0"
                                                    ToolTip="Ask this session to write a handoff and exit when its turn ends."
                                                    Visibility="{Binding Drawer.Card.ShowStop, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding StopCardCommand}"
                                                    CommandParameter="{Binding Drawer.Card}" />
                                            <Button Style="{StaticResource FocusCardButton}" Content="Focus" Margin="0,0,8,0"
                                                    Command="{Binding FocusCardCommand}"
                                                    CommandParameter="{Binding Drawer.Card}" />
                                            <Button Style="{StaticResource CommandButton}" Content="Spawn follow-on…"
                                                    ToolTip="Create a new card this one hands over to, in the same working directory."
                                                    Command="{Binding SpawnFollowOnCommand}"
                                                    CommandParameter="{Binding Drawer.Card}" />
                                        </StackPanel>

                                        <TextBlock x:Name="DrawerTitleLabel" Text="Title" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="DrawerTitle" Text="{Binding Drawer.Title, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.LabeledBy="{x:Reference DrawerTitleLabel}" />
                                        <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Saved when you leave the box. Also the tab title: a running session keeps the name it started with until it is restarted." />

                                        <!-- Each applies the moment it is switched, so each is a toggle switch, not a check box (W40, D3, G127). -->
                                        <StackPanel Margin="0,12,0,0">
                                            <ToggleButton x:Name="DrawerPaused" Style="{StaticResource ToggleSwitch}" Content="Paused" Margin="0,0,0,8"
                                                          ToolTip="Set aside on purpose. A flag on the card: it keeps its stage. Saved at once."
                                                          IsChecked="{Binding Drawer.IsPaused}" />
                                            <ToggleButton x:Name="DrawerBlocked" Style="{StaticResource ToggleSwitch}" Content="Blocked" Margin="0,0,0,8"
                                                          ToolTip="A flag on the card, not a lane. Saved at once."
                                                          IsChecked="{Binding Drawer.IsBlocked}" />
                                            <ToggleButton x:Name="DrawerReopenTomorrow" Style="{StaticResource ToggleSwitch}" Content="Reopen tomorrow"
                                                          ToolTip="Include this workstream when the whole board is started. Saved at once."
                                                          IsChecked="{Binding Drawer.ReopenTomorrow}" />
                                        </StackPanel>

                                        <TextBlock Text="Chain" Style="{StaticResource FieldLabel}" />
                                        <Button Style="{StaticResource LinkButton}" Padding="0" HorizontalAlignment="Left"
                                                ToolTip="Show this card's links."
                                                Command="{Binding Drawer.ShowLinksCommand}">
                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Drawer.Card.LinkLine}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Drawer.Card.LinkLine}" Value="">
                                                                <Setter Property="Text" Value="No links. Add one on the Links tab." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <TextBlock x:Name="JiraIssuesLabel" Text="Jira issues" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl AutomationProperties.Name="Jira issues" ItemsSource="{Binding Drawer.JiraKeys}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,72,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Button Style="{StaticResource CommandButton}" Content="Remove" FontSize="12" Padding="8,0"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.Drawer.RemoveJiraKeyCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,4,0,0">
                                            <TextBox Text="{Binding Drawer.NewJiraKey, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.LabeledBy="{x:Reference JiraIssuesLabel}"
                                                     Margin="0,0,60,0" />
                                            <Button Style="{StaticResource CommandButton}" Content="Add" HorizontalAlignment="Right"
                                                    Command="{Binding Drawer.AddJiraKeyCommand}" />
                                        </Grid>
                                        <Button Style="{StaticResource CommandButton}" Content="{Binding Drawer.UnclaimedKeys.Count}" ContentStringFormat="Take {0} more"
                                                ToolTip="{Binding Drawer.UnclaimedKeys.Count, Converter={StaticResource TagToolTip}, ConverterParameter=Take {0} more Jira keys from the prompt.}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4" FontSize="12"
                                                Command="{Binding Drawer.RescanPromptCommand}"
                                                Visibility="{Binding Drawer.UnclaimedKeys.Count,
                                                             Converter={StaticResource CountToVisibility}}" />

                                        <!-- Tags (card-search-and-tags item 10): each with ×; the tags in use are offered as you type; Enter adds. -->
                                        <StackPanel x:Name="DrawerTags" DataContext="{Binding Drawer.TagEditor}">
                                            <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                                            <ItemsControl AutomationProperties.Name="Tags" ItemsSource="{Binding Tags}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" Padding="8,0,4,0" Margin="0,0,4,4" BorderThickness="1"
                                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding StringFormat=#{0}}" FontSize="12" VerticalAlignment="Center" />
                                                                <Button Content="&#xE711;" Style="{StaticResource PanelIcon}" Margin="4,0,0,0"
                                                                        ToolTip="{Binding Converter={StaticResource TagToolTip}, ConverterParameter=Take #{0} off}"
                                                                        AutomationProperties.Name="{Binding StringFormat=Remove tag {0}}"
                                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="0,4,0,0">
                                                <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,60,0"
                                                         AutomationProperties.Name="New tag" ToolTip="A tag: letters, digits and hyphens. Enter adds it.">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding EnterCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <Button Content="Add" HorizontalAlignment="Right" Padding="12,4" Style="{StaticResource CommandButton}"
                                                        Command="{Binding AddCommand}" ToolTip="{Binding AddToolTip}" ToolTipService.ShowOnDisabled="True" />
                                            </Grid>
                                            <TextBlock Text="{Binding Refusal}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <ItemsControl AutomationProperties.Name="Suggested tags" ItemsSource="{Binding Suggestions}" Margin="0,4,0,0" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}" ContentStringFormat="+ #{0}" Style="{StaticResource CommandButton}" Padding="8,0" Margin="0,0,4,4" FontSize="12"
                                                                ToolTip="{Binding Converter={StaticResource TagToolTip}, ConverterParameter='Add #{0}, already used on other cards'}"
                                                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Text="Setup" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Drawer.Card.Workstream.WorkingDirectory}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="Where this workstream's sessions start"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Button Style="{StaticResource CommandButton}" Content="Edit setup" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                ToolTip="Working directory, prompts, handover notes, terminal window and order"
                                                Command="{Binding Drawer.EditSetupCommand}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Links">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <!-- One link: the other card by name, where it stands, and what can be done with it. -->
                                            <DataTemplate x:Key="LinkRowTemplate">
                                                <Border Margin="0,0,0,4" Padding="8,4" CornerRadius="4"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="12"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       ToolTip="{Binding ReportSummary}"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Button Style="{StaticResource LinkButton}" Padding="0" HorizontalAlignment="Left"
                                                                    ToolTip="Open this card's details."
                                                                    Command="{Binding ShowOtherCommand}">
                                                                <TextBlock Text="{Binding OtherTitle}" FontSize="14"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Button>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Document}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Document}" behaviors:TrimmedToolTip.IsEnabled="True"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding Document, Converter={StaticResource NotEmptyToVisibility}}" />
                                                        <StackPanel Visibility="{Binding CanSatisfy, Converter={StaticResource BoolToVisibility}}"
                                                                    Margin="0,4,0,0">
                                                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                                                     AutomationProperties.Name="Why the input is accepted"
                                                                     ToolTip="Why the input is accepted. It is kept with the link." />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Button Style="{StaticResource CommandButton}" Content="Confirm report…" FontSize="12" Padding="8,0" Margin="0,0,8,0"
                                                                    Command="{Binding ConfirmReportCommand}"
                                                                    ToolTip="Accept the report: one press for done or go, otherwise the verdict goes in the reason box."
                                                                    Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Style="{StaticResource CommandButton}" Content="Mark satisfied" FontSize="12" Padding="8,0" Margin="0,0,8,0"
                                                                    Command="{Binding SatisfyCommand}"
                                                                    ToolTip="Accept this input by hand, for the reason given."
                                                                    Visibility="{Binding CanSatisfy, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Style="{StaticResource CommandButton}" Content="Open document" FontSize="12" Padding="8,0" Margin="0,0,8,0"
                                                                    Command="{Binding OpenDocumentCommand}"
                                                                    Visibility="{Binding Document, Converter={StaticResource NotEmptyToVisibility}}" />
                                                            <Button Style="{StaticResource CommandButton}" Content="Remove…" FontSize="12" Padding="8,0"
                                                                    Command="{Binding AskRemoveCommand}"
                                                                    Visibility="{Binding CanAskRemove, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Style="{StaticResource CommandButton}" Content="Remove the link" FontSize="12" Padding="8,0" Margin="0,0,8,0"
                                                                    Command="{Binding ConfirmRemoveCommand}"
                                                                    Visibility="{Binding IsConfirmingRemove, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Style="{StaticResource CommandButton}" Content="Keep" FontSize="12" Padding="8,0"
                                                                    Command="{Binding KeepCommand}"
                                                                    Visibility="{Binding IsConfirmingRemove, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Refusal}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource CautionTextBrush}"
                                                                   Visibility="{Binding Refusal, Converter={StaticResource NotEmptyToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </StackPanel.Resources>

                                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="No links yet."
                                                   Visibility="{Binding Chains.HasNoLinks, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="Takes over from" Style="{StaticResource ListSectionHeader}" Margin="0,0,0,4"
                                                   Visibility="{Binding Chains.Parents.Count, Converter={StaticResource CountToVisibility}}" />
                                        <ItemsControl AutomationProperties.Name="Takes over from" ItemContainerStyle="{StaticResource ItemNamedByOtherTitle}" ItemsSource="{Binding Chains.Parents}" ItemTemplate="{StaticResource LinkRowTemplate}" />

                                        <Border Margin="0,4,0,8" Padding="8,4" CornerRadius="4" BorderThickness="4,0,0,0"
                                                BorderBrush="{Binding Drawer.ColorHex, Converter={StaticResource HexToBrush}}"
                                                Visibility="{Binding Chains.HasNoLinks, Converter={StaticResource NotBoolToVisibility}}">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Drawer.Title, StringFormat=● {0} (this card)}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Border>

                                        <TextBlock Text="Hands over to" Style="{StaticResource ListSectionHeader}" Margin="0,0,0,4"
                                                   Visibility="{Binding Chains.Children.Count, Converter={StaticResource CountToVisibility}}" />
                                        <ItemsControl AutomationProperties.Name="Hands over to" ItemContainerStyle="{StaticResource ItemNamedByOtherTitle}" ItemsSource="{Binding Chains.Children}" ItemTemplate="{StaticResource LinkRowTemplate}" />

                                        <TextBlock Text="Reported back to by" Style="{StaticResource ListSectionHeader}" Margin="0,8,0,4"
                                                   Visibility="{Binding Chains.Inputs.Count, Converter={StaticResource CountToVisibility}}" />
                                        <ItemsControl AutomationProperties.Name="Reported back to by" ItemContainerStyle="{StaticResource ItemNamedByOtherTitle}" ItemsSource="{Binding Chains.Inputs}" ItemTemplate="{StaticResource LinkRowTemplate}" />

                                        <TextBlock Text="Reports back to" Style="{StaticResource ListSectionHeader}" Margin="0,8,0,4"
                                                   Visibility="{Binding Chains.Outputs.Count, Converter={StaticResource CountToVisibility}}" />
                                        <ItemsControl AutomationProperties.Name="Reports back to" ItemContainerStyle="{StaticResource ItemNamedByOtherTitle}" ItemsSource="{Binding Chains.Outputs}" ItemTemplate="{StaticResource LinkRowTemplate}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                    Visibility="{Binding Chains.IsAddingLink, Converter={StaticResource NotBoolToVisibility}}">
                                            <Button Style="{StaticResource CommandButton}" Content="+ Add _link…" Margin="0,0,8,0"
                                                    ToolTip="Link this card to another card on the board."
                                                    Command="{Binding Chains.BeginAddLinkCommand}" />
                                            <Button Style="{StaticResource CommandButton}" Content="Spawn follow-on…"
                                                    ToolTip="Create a new card this one hands over to, in the same working directory."
                                                    Command="{Binding SpawnFollowOnCommand}"
                                                    CommandParameter="{Binding Drawer.Card}" />
                                        </StackPanel>

                                        <!-- The form for a new link has its own Add and Cancel, and Save has nothing to do with it. -->
                                        <Border Margin="0,12,0,0" Padding="8" CornerRadius="4"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                Visibility="{Binding Chains.IsAddingLink, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="New link" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <TextBlock x:Name="LinkKindLabel" Text="This card" Style="{StaticResource CaptionText}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ComboBox x:Name="LinkKind" ItemsSource="{Binding Chains.Kinds}" SelectedItem="{Binding Chains.Kind}"
                                                          AutomationProperties.LabeledBy="{x:Reference LinkKindLabel}"
                                                          Margin="0,4,0,0">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                </ComboBox>
                                                <ComboBox x:Name="LinkTarget" ItemsSource="{Binding Chains.Targets}" SelectedItem="{Binding Chains.Target}"
                                                          AutomationProperties.Name="The other card"
                                                          DisplayMemberPath="Title" IsTextSearchEnabled="True" Margin="0,4,0,0"
                                                          ToolTip="The other card. Type its first letters to jump to it.">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                </ComboBox>
                                                <TextBlock x:Name="LinkDocumentLabel" Text="Document (leave empty if nothing needs to wait for one)" Style="{StaticResource CaptionText}"
                                                           Margin="0,8,0,4" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBox x:Name="LinkDocument" Text="{Binding Chains.Output, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                                         AutomationProperties.LabeledBy="{x:Reference LinkDocumentLabel}"
                                                         ToolTip="The document one card writes and the other reads. On a hand-over, the next card waits until you accept it." />
                                                <TextBlock Text="{Binding Chains.LinkRefusal}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource CautionTextBrush}" Margin="0,8,0,0"
                                                           Visibility="{Binding Chains.LinkRefusal, Converter={StaticResource NotEmptyToVisibility}}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                    <Button x:Name="AddLinkButton" Content="Add _link" Style="{StaticResource DialogButton}" Margin="0,0,8,0"
                                                            Command="{Binding Chains.AddLinkCommand}" />
                                                    <Button x:Name="CancelLinkButton" Content="Cancel" Style="{StaticResource DialogButton}"
                                                            Command="{Binding Chains.CancelAddLinkCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Waiting means an input is not accepted yet, worked out from the links. Blocked means you said so." />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="History">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- What a project's session did to this card (1.1e AC 16). -->
                                        <TextBlock Text="Done by sessions" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                                   Visibility="{Binding Drawer.Events.Count, Converter={StaticResource CountToVisibility}}" />
                                        <ItemsControl AutomationProperties.Name="Done by sessions" ItemsSource="{Binding Drawer.Events}" Margin="0,0,0,8"
                                                      Visibility="{Binding Drawer.Events.Count, Converter={StaticResource CountToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Runs" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <ItemsControl ItemContainerStyle="{StaticResource ItemNamedByStarted}" AutomationProperties.Name="Runs" ItemsSource="{Binding Drawer.Runs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,4" Padding="8,4" CornerRadius="4"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Started}" FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <TextBlock FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                    <Run Text="{Binding ShortSessionId, Mode=OneWay}" />
                                                                    <Run Text="·" />
                                                                    <Run Text="{Binding Outcome, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Duration}" FontSize="12"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No runs recorded yet." FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding Drawer.Runs.Count, Converter={StaticResource ZeroToVisibility}}" />

                                        <TextBlock Text="Workflows" Style="{StaticResource FieldLabel}"
                                                   Visibility="{Binding Drawer.Workflows.Count,
                                                                Converter={StaticResource CountToVisibility}}" />
                                        <ItemsControl ItemContainerStyle="{StaticResource ItemNamedByHeadline}" AutomationProperties.Name="Workflows" ItemsSource="{Binding Drawer.Workflows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8" ToolTip="{Binding Summary}">
                                                        <TextBlock Text="{Binding Headline}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Phases}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding Phases,
                                                                                Converter={StaticResource NotEmptyToVisibility}}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                        <StackPanel Grid.Row="1">
                            <!--
                                Deleting asks in place rather than in a message box: the question names
                                what goes and what stays, which is more than a title bar and two buttons
                                can say, and the answer is one click from the thing it is about.
                            -->
                            <Border x:Name="DeleteQuestion"
                                    Visibility="{Binding Drawer.IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                    Padding="16" CornerRadius="4" Margin="0,8,0,0"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <!-- Esc answers Keep, as Cancel would in a dialog (B-m3, G70). -->
                                <Border.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding Drawer.CancelDeleteCommand}" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="{Binding Drawer.DeleteConsequence}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                                    <!-- The action first and Keep last, and Keep focused, so a slip of Enter keeps the card (W9, W43). -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button x:Name="DeleteForGood" Content="Delete for _good" Style="{StaticResource DialogButton}" Margin="0,0,8,0"
                                                Command="{Binding Drawer.ConfirmDeleteCommand}" />
                                        <Button x:Name="KeepCard" Content="Keep" Style="{StaticResource DialogButton}"
                                                behaviors:FocusWhen.IsTrue="{Binding Drawer.IsConfirmingDelete}"
                                                Command="{Binding Drawer.CancelDeleteCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
