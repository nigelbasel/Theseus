<Window x:Class="Theseus.App.DutyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="600" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Field" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>
    <!-- One tab per section, short lines, and a few-line box only for the instruction (Theseus dialog rules). -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <TabItem x:Name="DutyTab" Header="Duty">
                <StackPanel Margin="12">
                    <Label x:Name="CardLabel" Content="_Card" Target="{Binding ElementName=CardBox}" Style="{StaticResource Field}" Margin="0,0,0,8" />
                    <ComboBox x:Name="CardBox" ItemsSource="{Binding Cards}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding Card}" IsEnabled="{Binding CanChooseCard}" HorizontalAlignment="Left" MinWidth="280"
                              AutomationProperties.LabeledBy="{x:Reference CardLabel}" />

                    <Label x:Name="NameLabel" Content="_Name" Target="{Binding ElementName=NameBox}" Style="{StaticResource Field}" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRename}"
                             HorizontalAlignment="Left" Width="280" AutomationProperties.LabeledBy="{x:Reference NameLabel}" />

                    <Label x:Name="InstructionLabel" Content="_Instruction" Target="{Binding ElementName=InstructionBox}" Style="{StaticResource Field}" />
                    <TextBox x:Name="InstructionBox" Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.LabeledBy="{x:Reference InstructionLabel}" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource ExplanationText}" TextWrapping="Wrap"
                               Text="What the card is told each run. Theseus adds which run it is and what it recorded for the card since the last." />

                    <Label x:Name="CadenceLabel" Content="Runs" Style="{StaticResource Field}" />
                    <StackPanel x:Name="EveryRow" Orientation="Horizontal" AutomationProperties.LabeledBy="{x:Reference CadenceLabel}">
                        <RadioButton x:Name="EveryChoice" GroupName="Cadence" IsChecked="{Binding IsEvery}" VerticalAlignment="Center"
                                     AutomationProperties.Name="Every">
                            <AccessText Text="E_very" />
                        </RadioButton>
                        <TextBox x:Name="EveryBox" Text="{Binding Every, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="12,0,0,0"
                                 IsEnabled="{Binding IsEvery}" AutomationProperties.Name="Interval" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource ExplanationText}" Text="such as 20m or 2h; at least 5 minutes" />
                    </StackPanel>
                    <StackPanel x:Name="AtRow" Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="AtChoice" GroupName="Cadence" IsChecked="{Binding IsAt}" VerticalAlignment="Center"
                                     AutomationProperties.Name="At">
                            <AccessText Text="A_t" />
                        </RadioButton>
                        <TextBox x:Name="AtBox" Text="{Binding At, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="12,0,0,0"
                                 IsEnabled="{Binding IsAt}" AutomationProperties.Name="Times of day" />
                        <TextBlock Margin="8,0,8,0" VerticalAlignment="Center" Text="on" />
                        <TextBox x:Name="DaysBox" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                 IsEnabled="{Binding IsAt}" AutomationProperties.Name="Weekdays" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource ExplanationText}" Text="such as Mon-Fri; empty for every day" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="LimitsTab" Header="Limits">
                <StackPanel Margin="12">
                    <Label x:Name="UntilLabel" Content="_Ends" Target="{Binding ElementName=UntilBox}" Style="{StaticResource Field}" Margin="0,0,0,8" />
                    <TextBox x:Name="UntilBox" Text="{Binding Until, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="360"
                             AutomationProperties.LabeledBy="{x:Reference UntilLabel}" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource ExplanationText}" TextWrapping="Wrap"
                               Text="never; a date such as 2026-12-31; or criterion: followed by a criterion of the card's objective, which ends it once ticked. A session can always end its duties itself." />

                    <Label x:Name="CapLabel" Content="Daily _cap" Target="{Binding ElementName=CapBox}" Style="{StaticResource Field}" />
                    <TextBox x:Name="CapBox" Text="{Binding Cap, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="96"
                             AutomationProperties.LabeledBy="{x:Reference CapLabel}" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource ExplanationText}" TextWrapping="Wrap"
                               Text="The most runs in a day. Empty takes the board's, set in Options." />

                    <CheckBox x:Name="QuietBox" Margin="0,16,0,0" IsChecked="{Binding ThroughQuietHours}" AutomationProperties.Name="Runs through quiet hours">
                        <AccessText Text="Runs through _quiet hours" />
                    </CheckBox>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="History">
                <ListBox x:Name="HistoryList" Margin="12" ItemsSource="{Binding History}" AutomationProperties.Name="Runs and skips" />
            </TabItem>
        </TabControl>

        <TextBlock x:Name="RefusalText" Grid.Row="1" Margin="0,12,0,0" Text="{Binding Refusal}" TextWrapping="Wrap"
                   Foreground="{DynamicResource CautionTextBrush}" />

        <StackPanel x:Name="Footer" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{DynamicResource AccentButton}" Click="OnOk" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{DynamicResource DialogButton}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
