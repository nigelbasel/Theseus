<Window x:Class="Theseus.App.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Theseus.App.Controls"
        Title="{Binding Title}" Width="1000" Height="720" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!--
            A row's second and third lines: secondary while the row is not chosen, and the row's own colour once it is, so a
            chosen row's text inverts with it, as high contrast needs (E6, G164).
        -->
        <Style x:Key="RowCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- A piece's records (Nigel, 2026-11-22): its documents by stage, the chosen one formatted, the folder last. -->
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{DynamicResource BodyLargeText}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <!-- One bar at the top: the two views as a selector bar, then the window's commands as a toolbar, icon and word,
             in place of a button at the bottom and a link beside it (walkthrough row 42; checklist G38, G42, G125; baseline W15). -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <!-- One Tab stop; the arrow keys switch the view and stop at either end (B-m4, W42). -->
            <StackPanel x:Name="ViewChoice" DockPanel.Dock="Left" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once"
                        KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="Views of the document">
                <RadioButton x:Name="PreviewTab" Content="Preview" GroupName="RecordView" controls:SelectorBar.SelectsOnFocus="True" Style="{DynamicResource SelectorBarItem}"
                             IsChecked="{Binding IsPreview, Mode=OneWay}" Command="{Binding PreviewCommand}"
                             ToolTip="Preview: the document drawn, as it reads" />
                <RadioButton x:Name="SourceTab" Content="Source" GroupName="RecordView" controls:SelectorBar.SelectsOnFocus="True" Style="{DynamicResource SelectorBarItem}"
                             IsChecked="{Binding IsSource, Mode=OneWay}" Command="{Binding SourceCommand}"
                             ToolTip="Source: the document's Markdown, as written" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenInEditor" Style="{DynamicResource ToolIcon}" FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                        Height="32" Padding="8,0" Margin="0,0,8,0" Command="{Binding OpenInEditorCommand}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Open in editor: the document shown, in your editor" AutomationProperties.Name="Open in editor">
                    <StackPanel Orientation="Horizontal">
                        <controls:GlyphText Text="&#xE70F;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <AccessText Text="Open in _editor" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolder" Style="{DynamicResource ToolIcon}" FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                        Height="32" Padding="8,0" Command="{Binding OpenFolderCommand}"
                        ToolTip="Open folder: the records folder, in Explorer" AutomationProperties.Name="Open folder">
                    <StackPanel Orientation="Horizontal">
                        <controls:GlyphText Text="&#xE838;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <AccessText Text="Open _folder" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="None" Grid.Row="2" Text="{Binding NoneText}" TextWrapping="Wrap" Style="{DynamicResource BodyText}" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasNone, Converter={StaticResource Visible}}" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Entries" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Margin="0,0,12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Records by stage">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Stage}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4" Cursor="Hand" AutomationProperties.Name="{Binding Stage}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource RowCaption}" Margin="8,0,0,0"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Purpose}" Style="{StaticResource RowCaption}" />
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource RowCaption}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="1" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                      AutomationProperties.Name="The document, drawn"
                                      Visibility="{Binding IsPreview, Converter={StaticResource Visible}}" />
            <TextBox x:Name="Source" Grid.Column="1" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="The document's Markdown"
                     Visibility="{Binding IsSource, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- Close, so the window closes the way every other does, and Esc closes it (A17, B14, G8, G13). -->
        <StackPanel x:Name="Footer" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True" Style="{DynamicResource DialogButton}" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
