<!--
    The Fluent theme's own MenuItem templates (from PresentationFramework.Fluent, MIT), with only their
    spacing tightened. The theme spaces menus for touch: each heading on the bar sits in fixed margins
    of 4 and 10 pixels plus an icon column, about 30 pixels of space round each word, and no padding
    setting reaches them (Nigel, 2026-10-30: "the menu items seem more widely spaced than is normal").
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ns1="clr-namespace:System;assembly=System.Private.CoreLib">
<ControlTemplate x:Key="CompactTopLevelHeader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ns1="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TargetType="MenuItem"><Border BorderThickness="{TemplateBinding Border.BorderThickness}" CornerRadius="6,6,6,6" BorderBrush="{TemplateBinding Border.BorderBrush}" Background="{TemplateBinding Panel.Background}" Name="Border" Margin="1,2,1,2"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Margin="8,3,8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ContentPresenter Content="{TemplateBinding MenuItem.Icon}" Name="Icon" Margin="0,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Grid.Column="0" /><ContentPresenter RecognizesAccessKey="True" Content="{TemplateBinding HeaderedContentControl.Header}" ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" ContentStringFormat="{TemplateBinding HeaderedItemsControl.HeaderStringFormat}" ContentSource="Header" Name="HeaderPresenter" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" TextElement.Foreground="{TemplateBinding TextElement.Foreground}" Grid.Column="1" /></Grid><Popup IsOpen="{TemplateBinding MenuItem.IsSubmenuOpen}" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="1" PopupAnimation="None" AllowsTransparency="True" Name="PART_Popup" Focusable="False" Grid.Column="0" Grid.Row="1"><Grid><Border BorderThickness="1,1,1,1" Padding="0,3,0,3" CornerRadius="8,8,8,8" BorderBrush="{DynamicResource FlyoutBorderBrush}" Background="{DynamicResource FlyoutBackground}" Name="SubmenuBorder" Margin="12,0,12,18" SnapsToDevicePixels="True"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform><Border.Effect><DropShadowEffect ShadowDepth="6" Direction="270" Opacity="0.25" BlurRadius="20" /></Border.Effect><ScrollViewer CanContentScroll="True"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.BasedOn><Style TargetType="ScrollViewer"><Style.Triggers><Trigger Property="UIElement.IsEnabled"><Setter Property="TextElement.Foreground"><Setter.Value><DynamicResource ResourceKey="{x:Static SystemColors.GrayTextBrushKey}" /></Setter.Value></Setter><Trigger.Value><ns1:Boolean>False</ns1:Boolean></Trigger.Value></Trigger></Style.Triggers><Style.Resources><ResourceDictionary /></Style.Resources></Style></Style.BasedOn><Style.Resources><ResourceDictionary /></Style.Resources><Setter Property="ScrollViewer.HorizontalScrollBarVisibility"><Setter.Value><x:Static Member="ScrollBarVisibility.Disabled" /></Setter.Value></Setter><Setter Property="ScrollViewer.VerticalScrollBarVisibility"><Setter.Value><x:Static Member="ScrollBarVisibility.Auto" /></Setter.Value></Setter></Style></ScrollViewer.Style><Grid><ItemsPresenter Name="ItemsPresenter" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" /></Grid></ScrollViewer></Border></Grid></Popup></Grid></Border><ControlTemplate.Triggers><Trigger Property="MenuItem.Icon"><Setter Property="UIElement.Visibility" TargetName="Icon"><Setter.Value><x:Static Member="Visibility.Collapsed" /></Setter.Value></Setter><Trigger.Value><x:Null /></Trigger.Value></Trigger><Trigger Property="HeaderedContentControl.Header"><Setter Property="FrameworkElement.Margin" TargetName="Icon"><Setter.Value><Thickness>0,0,0,0</Thickness></Setter.Value></Setter><Setter Property="UIElement.Visibility" TargetName="HeaderPresenter"><Setter.Value><x:Static Member="Visibility.Collapsed" /></Setter.Value></Setter><Trigger.Value><x:Null /></Trigger.Value></Trigger><Trigger Property="MenuItem.IsHighlighted"><Setter Property="Panel.Background" TargetName="Border"><Setter.Value><DynamicResource ResourceKey="MenuBarItemBackgroundSelected" /></Setter.Value></Setter><Trigger.Value><ns1:Boolean>True</ns1:Boolean></Trigger.Value></Trigger><Trigger Property="UIElement.IsEnabled"><Setter Property="TextElement.Foreground"><Setter.Value><SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" /></Setter.Value></Setter><Trigger.Value><ns1:Boolean>False</ns1:Boolean></Trigger.Value></Trigger><Trigger Property="MenuItem.IsSubmenuOpen"><Trigger.EnterActions><BeginStoryboard><Storyboard><Storyboard.Children><DoubleAnimation From="-90" To="0" Duration="00:00:00.1670000" Storyboard.TargetName="SubmenuBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard.Children></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.Value><ns1:Boolean>True</ns1:Boolean></Trigger.Value></Trigger></ControlTemplate.Triggers></ControlTemplate>
