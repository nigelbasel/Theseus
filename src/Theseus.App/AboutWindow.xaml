<Window x:Class="Theseus.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Theseus"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Read-only and selectable, but not a Tab stop: there is nothing to do in them but copy (B15). -->
        <Style x:Key="Value" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,16">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="AppIcon" Source="pack://application:,,,/Theseus;component/Assets/theseus.ico" Width="48" Height="48"
                       Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="Theseus icon" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Theseus" Style="{DynamicResource SubtitleText}" />
                    <TextBlock Text="A Claude Code session orchestrator." Style="{DynamicResource BodyText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="VersionLabel" Text="Version" Style="{StaticResource Label}" />
            <TextBox Text="{Binding VersionDescribed, Mode=OneWay}" Style="{StaticResource Value}"
                     AutomationProperties.LabeledBy="{Binding ElementName=VersionLabel}" />

            <TextBlock x:Name="AccountLabel" Text="Account sessions run as" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Account, Mode=OneWay}" Style="{StaticResource Value}"
                     AutomationProperties.LabeledBy="{Binding ElementName=AccountLabel}" />

            <TextBlock x:Name="InstalledLabel" Text="Installed in" Style="{StaticResource Label}" />
            <TextBox Text="{Binding InstallFolder, Mode=OneWay}" Style="{StaticResource Value}"
                     AutomationProperties.LabeledBy="{Binding ElementName=InstalledLabel}" />

            <TextBlock x:Name="DataLabel" Text="Board, settings and logs" Style="{StaticResource Label}" />
            <TextBox Text="{Binding DataFolder, Mode=OneWay}" Style="{StaticResource Value}"
                     AutomationProperties.LabeledBy="{Binding ElementName=DataLabel}" />

            <TextBlock Text="Stop hook" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding Help.HookStatus}" Style="{DynamicResource BodyText}" TextWrapping="Wrap" />

            <!-- Each link's address is its tooltip, so it says where it goes (W54, G156). -->
            <TextBlock x:Name="Links" Margin="0,16,0,0" Style="{DynamicResource BodyText}" TextWrapping="Wrap">
                <Hyperlink NavigateUri="https://nigelbasel.github.io/Theseus/" RequestNavigate="OnLink"
                           ToolTip="https://nigelbasel.github.io/Theseus/">Help</Hyperlink>
                <Run Text=" · " />
                <Hyperlink NavigateUri="https://github.com/nigelbasel/Theseus/issues" RequestNavigate="OnLink"
                           ToolTip="https://github.com/nigelbasel/Theseus/issues">Report a problem</Hyperlink>
                <Run Text=" · " />
                <Hyperlink NavigateUri="https://github.com/nigelbasel/Theseus" RequestNavigate="OnLink"
                           ToolTip="https://github.com/nigelbasel/Theseus">Source code</Hyperlink>
                <Run Text=" · " />
                <Hyperlink NavigateUri="https://github.com/nigelbasel/Theseus/releases" RequestNavigate="OnLink"
                           ToolTip="https://github.com/nigelbasel/Theseus/releases">Releases</Hyperlink>
                <Run Text=" · " />
                <Hyperlink NavigateUri="https://github.com/nigelbasel/Theseus/blob/main/LICENSE" RequestNavigate="OnLink"
                           ToolTip="https://github.com/nigelbasel/Theseus/blob/main/LICENSE">MIT licence</Hyperlink>
            </TextBlock>
            <TextBlock Text="Copyright (c) 2026 Nigel Basel. Provided as is, without warranty."
                       Style="{DynamicResource CaptionText}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- The footer comes last, so Tab reaches it after the links (B2); Check for updates sits at its left (W9). -->
        <Border Grid.Row="1" Padding="24,16"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel x:Name="Footer" LastChildFill="False">
                <Button x:Name="CheckButton" DockPanel.Dock="Left" Content="_Check for updates" Style="{DynamicResource DialogButton}"
                        Command="{Binding Updates.CheckNowCommand}" />
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Style="{DynamicResource DialogButton}"
                        IsCancel="True" IsDefault="True" Click="OnClose" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
