<Window x:Class="Theseus.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Label" FontWeight="SemiBold" />
        <TextBox x:Name="Answer" Margin="0,6,0,0" TextChanged="OnChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="_OK" IsDefault="True" MinWidth="88" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
