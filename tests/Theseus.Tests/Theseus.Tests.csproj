<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-targeted so it can reference the application. The interop this covers - the shape of an
    INPUT, the shape of a WINDOWPLACEMENT - lives in Theseus.App and cannot be reached from a
    framework-neutral test project. Everything the application does that is pure arithmetic still
    lives in Theseus.Core and is tested there.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Theseus.Core\Theseus.Core.csproj" />
    <ProjectReference Include="..\..\src\Theseus.Launcher\Theseus.Launcher.csproj" />
    <ProjectReference Include="..\..\src\Theseus.App\Theseus.App.csproj" />
  </ItemGroup>

</Project>
