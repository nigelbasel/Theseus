<Window x:Class="Theseus.App.RunOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="560" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- A headless run's output, followed as it is written (Nigel, 2026-11-24). Read-only: the run takes no input from here. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Intro" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBox x:Name="Output" Grid.Row="1" IsReadOnly="True" AutomationProperties.Name="Run output"
                 FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Style="{DynamicResource DialogButton}" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
