<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The kit's starter files ship inside Theseus, so a new project gets the kit this build reads (1.1b AC 8). -->
    <EmbeddedResource Include="..\..\method\starter\project.md" LogicalName="Theseus.Core.Starter.project.md" />
    <!-- The kit's description of project.md, which an updater is given (1.1e AC 19). -->
    <EmbeddedResource Include="..\..\method\project.md" LogicalName="Theseus.Core.Method.project.md" />
    <!-- The holdout guard Options installs, so the installed guard is the one this build's board agrees with. -->
    <EmbeddedResource Include="..\..\tools\holdout\holdout-guard.js" LogicalName="Theseus.Core.Holdout.holdout-guard.js" />
    <!-- The trunk and tests-lock guards and the lock script, installed from Options the same way, so a new machine gets every guard. -->
    <EmbeddedResource Include="..\..\tools\guards\trunk-guard.js" LogicalName="Theseus.Core.Guards.trunk-guard.js" />
    <EmbeddedResource Include="..\..\tools\locks\ndc-test-lock-guard.js" LogicalName="Theseus.Core.Locks.ndc-test-lock-guard.js" />
    <EmbeddedResource Include="..\..\tools\locks\ndc-test-lock.sh" LogicalName="Theseus.Core.Locks.ndc-test-lock.sh" />
    <!-- The command classes the tests-lock guard and Theseus both read, installed beside the guard. -->
    <EmbeddedResource Include="..\..\tools\locks\command-classes.json" LogicalName="Theseus.Core.Locks.command-classes.json" />
    <!-- Auto mode's environment template; the owner's own hosts and domains are entered in Options, never kept here. -->
    <EmbeddedResource Include="..\..\tools\automode\environment.template.txt" LogicalName="Theseus.Core.AutoMode.environment.template.txt" />
  </ItemGroup>

</Project>
