<Window x:Class="Theseus.App.ArrangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Theseus.App.Converters"
        Title="Arrange windows"
        Width="560"
        Height="620"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    </Window.Resources>
    <!-- Rows in reading order, so Tab goes from the arrangement through the windows to the footer (B2, W43). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,16"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="KindLabel" Text="Arrangement:" VerticalAlignment="Center" Style="{DynamicResource CaptionText}"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="KindBox" Width="152" VerticalAlignment="Center"
                              ItemsSource="{Binding Kinds}"
                              SelectedItem="{Binding Kind, Mode=TwoWay}"
                              AutomationProperties.LabeledBy="{x:Reference KindLabel}" />
                    <Button x:Name="LookAgainButton" Content="_Look again" Style="{DynamicResource CommandButton}" Margin="12,0,0,0"
                            ToolTip="Read the desktop again, in case a window has opened or closed."
                            Command="{Binding RefreshCommand}" />
                </StackPanel>

                <TextBlock Style="{DynamicResource ExplanationText}" Margin="0,12,0,0"
                           Text="Untick a window to leave it exactly where it is. Sessions cannot be moved between windows from here — drag the tab in Windows Terminal to do that." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12" Focusable="False">
            <!-- One Tab stop; the arrow keys move between the windows and stop at either end (B-m5, W42). -->
            <ItemsControl x:Name="Groups" ItemsSource="{Binding Groups}" Focusable="False"
                          KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="4"
                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource BodyStrongText}"
                                               TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                                <TextBlock Text="{Binding Sessions}" Style="{DynamicResource CaptionText}" TextWrapping="Wrap"
                                           Margin="28,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Where}" Style="{DynamicResource CaptionText}" Margin="28,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,16"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Preview}" Style="{DynamicResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,4" />

                <!--
                    Said before anything moves, because finding out that four terminals are sixty
                    columns wide by doing it - after your own arrangement has been destroyed - is a
                    poor way to learn it.
                -->
                <TextBlock Text="⚠ Windows this narrow fold Claude Code's output. Two side by side is the comfortable limit here."
                           Style="{DynamicResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding IsTooNarrow, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{DynamicResource CautionTextBrush}" />

                <TextBlock Text="{Binding Outcome}" Style="{DynamicResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Outcome, Converter={StaticResource NotEmptyToVisibility}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Put back is not a commit, so it sits at the footer's left (W9). -->
                <DockPanel x:Name="Footer" LastChildFill="False">
                    <Button x:Name="PutBackButton" DockPanel.Dock="Left" Content="P_ut back" Style="{DynamicResource DialogButton}"
                            ToolTip="Return every window to where it was before the first arrangement."
                            Command="{Binding RestoreCommand}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ArrangeButton" Content="_Arrange" Style="{DynamicResource AccentButton}" IsDefault="True"
                                Command="{Binding ApplyCommand}" />
                        <Button x:Name="CloseButton" Content="Close" Style="{DynamicResource DialogButton}" Margin="8,0,0,0" IsCancel="True"
                                Command="{Binding CloseCommand}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
