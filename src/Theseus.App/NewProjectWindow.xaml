<Window x:Class="Theseus.App.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Name" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Margin="0,6,0,0" TextChanged="OnNameChanged" />
        <TextBlock x:Name="Hint" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Lower-case letters, digits and hyphens, such as my-project. It names the project's folder in the projects folder, which gets a project.md to fill in and an empty work folder." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CreateButton" Content="_Create" IsDefault="True" MinWidth="88" Click="OnCreate" IsEnabled="False" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
