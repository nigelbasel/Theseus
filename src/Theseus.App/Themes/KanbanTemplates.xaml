                    xmlns:vm="clr-namespace:Theseus.App.ViewModels"
                    xmlns:views="clr-namespace:Theseus.App.Views">
    <!-- The shell's AllProjectsView holds a KanbanViewModel; this draws it (projects-kanban spec AC 1). -->
    <DataTemplate DataType="{x:Type vm:KanbanViewModel}">
        <views:KanbanView />
    </DataTemplate>
</ResourceDictionary>
