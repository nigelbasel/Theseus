{
  "description": "The method's standing rules at the start of every session, and the trunk and holdout guards on every tool call",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/scripts/session-rules.js", "standing"],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/scripts/session-rules.js", "ladder"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/tools/guards/trunk-guard.js"],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/tools/holdout/holdout-guard.js"],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
