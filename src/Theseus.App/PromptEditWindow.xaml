<Window x:Class="Theseus.App.PromptEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Theseus.App.Controls"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!-- One of Options' prompts, edited in a window of its own so Options itself holds no large text box (options-made-clear item 6). -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Explanation" Style="{DynamicResource ExplanationText}" Margin="0,0,0,12" />
        <!-- The editor is named from the explanation over it, the only label it has besides the title (E12). -->
        <controls:MarkdownBox x:Name="Editor" Grid.Row="1" EditorMinHeight="300" EditorMaxHeight="2000"
                              AutomationProperties.LabeledBy="{x:Reference Explanation}" />
        <StackPanel x:Name="Footer" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{DynamicResource AccentButton}" Click="OnOk" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{DynamicResource DialogButton}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
