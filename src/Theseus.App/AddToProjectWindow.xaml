<Window x:Class="Theseus.App.AddToProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to project"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <!-- A field's label, with the access key that moves to its field (W26, W50). -->
        <Style x:Key="Field" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>
    <!-- Adds the card's row to the chosen objective's workstreams table in project.md (1.1c AC 7). -->
    <StackPanel Margin="24">
        <Label x:Name="ProjectLabel" Content="_Project" Target="{Binding ElementName=ProjectBox}" Style="{StaticResource Field}" Margin="0,0,0,8" />
        <ComboBox x:Name="ProjectBox" DisplayMemberPath="Title" SelectionChanged="OnProjectChanged"
                  AutomationProperties.LabeledBy="{x:Reference ProjectLabel}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <Label x:Name="ObjectiveLabel" Content="O_bjective" Target="{Binding ElementName=ObjectiveBox}" Style="{StaticResource Field}" />
        <ComboBox x:Name="ObjectiveBox" SelectionChanged="OnChanged" AutomationProperties.LabeledBy="{x:Reference ObjectiveLabel}" />

        <Label x:Name="SlugLabel" Content="_Name of its records folder" Target="{Binding ElementName=SlugBox}" Style="{StaticResource Field}" />
        <TextBox x:Name="SlugBox" TextChanged="OnChanged" AutomationProperties.LabeledBy="{x:Reference SlugLabel}" />
        <TextBlock Margin="0,4,0,0" Style="{DynamicResource ExplanationText}"
                   Text="Names the folder its records go in, work\&lt;name&gt;, and its branch. Lower-case letters, digits and hyphens." />

        <StackPanel x:Name="Footer" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="AddButton" Content="_Add" IsDefault="True" Style="{DynamicResource AccentButton}" Click="OnAdd" IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{DynamicResource DialogButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
