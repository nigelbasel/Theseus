<Window x:Class="Theseus.App.NewWorkstreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New workstream"
        Width="640"
        MinWidth="520"
        MinHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!--
        New workstream as a dialog of its own (Nigel, 2026-11-03): it used to be a panel drawn over the
        board, and a long prompt pushed Create off the bottom of the screen with no way to close it.
        Escape or the close button is Cancel; Ctrl+Enter is Create, since Enter is a new line in the prompt.
    -->
    <Window.Resources>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding NewWorkstream.CloseCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding NewWorkstream.CreateCommand}" />
    </Window.InputBindings>

    <Grid Margin="22,10,22,18">
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Open a tab now" VerticalAlignment="Center"
                              IsChecked="{Binding NewWorkstream.StartNow}" />
                    <Border Width="14" Height="14" CornerRadius="3" Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="The card's colour: allocated automatically, and permanent once created"
                            Background="{Binding NewWorkstream.ColourHex, Converter={StaticResource HexToBrush}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Padding="18,5" Margin="0,0,8,0"
                            Command="{Binding NewWorkstream.CloseCommand}" />
                    <Button Content="Create" Padding="18,5" ToolTip="Create (Ctrl+Enter)"
                            Command="{Binding NewWorkstream.CreateCommand}" />
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <!--
                        A follow-on (Nigel, 2026-10-21): the card it was opened on hands over to it, in its
                        working directory. Ticking report back asks the follow-on for a report to the parent,
                        under the parent's working directory; the parent is never held back by it.
                    -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding NewWorkstream.IsFollowOn, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding NewWorkstream.ParentTitle, StringFormat=Follow-on from {0}}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <CheckBox Content="Report back: this card reports its output to the parent when done" Margin="0,6,0,0"
                                  IsChecked="{Binding NewWorkstream.ReportBack}" />
                        <TextBlock Text="{Binding NewWorkstream.ReportPath}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Visibility="{Binding NewWorkstream.ReportBack, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="This creates a card only. No Jira item, branch, worktree, push or PR." />
                        <TextBlock Text="{Binding NewWorkstream.ProposalText}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Visibility="{Binding NewWorkstream.IsProposal, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding NewWorkstream.ProposalWarnings}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="#D68910"
                                   Visibility="{Binding NewWorkstream.ProposalWarnings, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>

                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewWorkstream.Title, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding NewWorkstream.Key, StringFormat=plan file: {0}.json}"
                               Style="{StaticResource FieldHint}" />

                    <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewWorkstream.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="This directory does not exist." FontSize="11" Margin="0,4,0,0"
                               Foreground="#CF5D61">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewWorkstream.WorkingDirectoryExists}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--
                        Where the card lands. Every new workstream used to appear in the first
                        cell whatever it was for, and had to be dragged where it belonged.
                    -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Stage" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding NewWorkstream.Stages}"
                                      SelectedItem="{Binding NewWorkstream.Stage, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding NewWorkstream.HasAreas, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Area" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding NewWorkstream.Areas}"
                                      SelectedItem="{Binding NewWorkstream.Area, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Which cell of the board the card starts in. It can be dragged anywhere afterwards." />

                    <TextBlock Text="Opening prompt" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewWorkstream.Prompt, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="420"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
