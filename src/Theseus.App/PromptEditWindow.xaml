<Window x:Class="Theseus.App.PromptEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Theseus.App.Controls"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!-- One of Options' prompts, edited in a window of its own so Options itself holds no large text box (options-made-clear item 6). -->
    <DockPanel Margin="20">
        <TextBlock x:Name="Explanation" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="_OK" IsDefault="True" MinWidth="88" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
        <controls:MarkdownBox x:Name="Editor" EditorMinHeight="300" EditorMaxHeight="2000" />
    </DockPanel>
</Window>
