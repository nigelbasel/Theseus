<Window x:Class="Theseus.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Theseus.App.Controls"
        xmlns:converters="clr-namespace:Theseus.App.Converters"
        Title="Options"
        Width="680"
        Height="620"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <!-- Its own converters, so a test draws it without the application's resources. -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
        <converters:HexToSwatchConverter x:Key="HexToSwatch" />

        <!-- A page's column stops widening on a maximised window (W7, G139). -->
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="4,16,4,8" />
            <Setter Property="MaxWidth" Value="1000" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="PageNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Based on the theme's own button, or dark mode draws a light button. One height for every control in a row (W56). -->
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <!--
        Machine-wide settings only (options-made-clear item 1): a project's own lead, branch rules and holdout folder are in
        its Project properties. One tab per section, so every section is seen at once (item 5), and each setting is one
        line of its name, its value as text, and what it does now, changed through a picker or a small dialog (item 6).
        Access keys go on a command whose label is unique on its tab; the repeated Change…, Edit… and Reset of a tab's
        rows get none, since one key shared by several buttons only moves focus between them (W26).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Margin="20,12,20,0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <controls:SettingRow Label="Theme" Value="{Binding ThemeValue}"
                                             Explanation="Applied as soon as it is chosen.">
                            <ComboBox x:Name="ThemeBox" ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Label" SelectedValuePath="Theme"
                                      SelectedValue="{Binding Theme, Mode=TwoWay}" Width="180"
                                      AutomationProperties.Name="Theme">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </controls:SettingRow>

                        <controls:SettingRow Label="Jira" Value="{Binding JiraValue}" Explanation="{Binding JiraExplanation}">
                            <Button x:Name="JiraChange" Content="_Change…" Style="{StaticResource Action}" Click="OnChangeJira"
                                    AutomationProperties.Name="Change the Jira address" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Start mode" Value="{Binding StartModeValue}"
                                             Explanation="{Binding StartModeExplanation}">
                            <!--
                                One Tab stop, the choice in force, arrows inside that do not wrap, and the focused choice is the one
                                taken (W42, G67, G72, G133). TabNavigation Once would land Tab on the first radio and so change the setting.
                            -->
                            <StackPanel KeyboardNavigation.DirectionalNavigation="Contained">
                                <RadioButton x:Name="ResumeChoice" GroupName="StartMode" Content="_Resume" IsChecked="{Binding ResumeByDefault, Mode=TwoWay}"
                                             IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                             controls:SelectorBar.SelectsOnFocus="True"
                                             AutomationProperties.Name="Resume its last conversation" />
                                <RadioButton x:Name="FreshChoice" GroupName="StartMode" Content="_Start fresh" Margin="0,4,0,0" IsChecked="{Binding FreshByDefault, Mode=TwoWay}"
                                             IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                             controls:SelectorBar.SelectsOnFocus="True"
                                             AutomationProperties.Name="Start fresh from its handoff" />
        
                        <!-- Headless runs (Nigel, 2026-11-24): a section here, not a tab of its own, so Options keeps its seven tabs (W7). -->
                        <TextBlock Text="Headless runs" Style="{DynamicResource BodyStrongText}" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource PageNote}"
                                   Text="The limits headless runs work inside, measured from each run's own output, and when a card's breaker trips. A project's own limits replace these for its cards." />
                        <ItemsControl ItemsSource="{Binding HeadlessLimits}" ItemContainerStyle="{DynamicResource ItemNamedByLabel}" Focusable="False" AutomationProperties.Name="Headless limits">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:SettingRow Label="{Binding Label}" Value="{Binding Value}" Explanation="{Binding Explanation}">
                                        <Button Content="Change…" Style="{StaticResource Action}" Command="{Binding ChangeCommand}"
                                                AutomationProperties.Name="{Binding ChangeName}" />
                                    </controls:SettingRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                        </controls:SettingRow>

                        <controls:SettingRow Label="Updates" Value="{Binding UpdatesValue}"
                                             Explanation="Pre-releases are built from a project's primary branch before it is merged into main, so its work can be tried live first.">
                            <ToggleButton x:Name="PreReleases" Content="_Pre-releases" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding IncludePreReleases, Mode=TwoWay}"
                                          AutomationProperties.Name="Include pre-releases in Check for updates" />
                        </controls:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Board">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <controls:SettingRow Label="Stages" Value="{Binding LanesValue}"
                                             Explanation="The columns: how far along the work is. No stage is special: a bulk Start or Stop acts on what you tick. Cards in a stage you remove move to the first.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeLanes"
                                    AutomationProperties.Name="Change the board stages" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Areas" Value="{Binding AreasValue}" Explanation="{Binding AreaListState}">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeAreas"
                                    AutomationProperties.Name="Change the board areas" />
                        </controls:SettingRow>
                        <StackPanel x:Name="DutyOptions" DataContext="{Binding Duties}">
                        <TextBlock Style="{StaticResource PageNote}" Margin="0,24,0,0"
                                   Text="A duty is an instruction Theseus gives a card on a cadence. These limits apply to every duty; a duty can set its own daily cap. Theseus sets no cost limit of its own yet: the daily cap is the only limit on what duties spend." />

                        <controls:SettingRow Label="Daily cap" Value="{Binding CapValue}"
                                             Explanation="The most runs a duty gives in a day, unless it sets its own. Once reached, its runs are skipped until midnight.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeDutyCap"
                                    AutomationProperties.Name="Change the daily cap" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Pauses itself" Value="{Binding FailureValue}"
                                             Explanation="A duty whose runs crash or do not reach the card this many times in a row pauses itself, and says why on its card.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeDutyFailures"
                                    AutomationProperties.Name="Change when a duty pauses itself" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Quiet hours" Value="{Binding QuietValue}"
                                             Explanation="Duties due in these hours wait and run once when they end, unless a duty runs through them. The overnight queue always runs through them.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeQuietHours"
                                    AutomationProperties.Name="Change the quiet hours" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Overnight queue" Value="{Binding QueueValue}"
                                             Explanation="In a project whose queue is on, an open card idle this long, with unfinished work and nothing waiting on you, is told to carry on. Switch it on per project in Project properties.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeQueue"
                                    AutomationProperties.Name="Change the overnight queue's limits" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Queue is on for" Value="{Binding QueueProjectsValue}"
                                             Explanation="The projects whose idle cards the queue resumes. It is off in a project until you switch it on there." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Folders">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <!-- Shown until a projects folder is set: how Theseus lays out your work (1.1b AC 11). -->
                        <Border Margin="0,0,0,20" Padding="16" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="{Binding ShowsProjectsIntro, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource BodyStrongText}" Text="How Theseus lays out your work" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                                           Text="A project home says what the work is and where it has got to; your source clones are the code as it is upstream; worktrees are the code each workstream is changing. Records never go in a code repo." />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                                           Text="Nothing is set for you. Documents\Theseus\projects and Documents\Theseus\work are a good start." />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Choose projects folder…" Style="{StaticResource Action}" Click="OnChooseProjectsFolder" />
                                    <Button Content="Choose worktrees folder…" Style="{StaticResource Action}" Margin="8,0,0,0" Click="OnChooseWorktreesFolder" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0">
                                    <Hyperlink NavigateUri="https://nigelbasel.github.io/Theseus/project-layout.html" RequestNavigate="OnLink"
                                               ToolTip="https://nigelbasel.github.io/Theseus/project-layout.html">How your work is laid out</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <controls:SettingRow Label="Projects folder" Value="{Binding ProjectsFolderValue}"
                                             Explanation="Each folder in it with a project.md is a project, with a work folder of its records. Records are plain files, outside every code repo.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChooseProjectsFolder"
                                    AutomationProperties.Name="Change the projects folder" />
                        </controls:SettingRow>

                        <!-- Folders said not to be projects, from a project card's menu (1.1e AC 20). -->
                        <StackPanel Margin="0,0,0,20" Visibility="{Binding HiddenProjectFolders.Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="Folders that are not projects" Style="{DynamicResource BodyStrongText}" />
                            <ItemsControl AutomationProperties.Name="Folders that are not projects" x:Name="HiddenProjectFolders" ItemsSource="{Binding HiddenProjectFolders}" Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="Show again" Style="{StaticResource Action}" Margin="8,0,0,0"
                                                    AutomationProperties.Name="{Binding StringFormat=Show {0} again}"
                                                    ToolTip="Show this folder's project card again."
                                                    Command="{Binding DataContext.ShowProjectFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <controls:SettingRow Label="Worktrees folder" Value="{Binding WorktreesFolderValue}"
                                             Explanation="Where each workstream's worktrees go: a folder per workstream, with a worktree in it for each repo it changes.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChooseWorktreesFolder"
                                    AutomationProperties.Name="Change the worktrees folder" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Clones folder" Value="{Binding ClonesFolderValue}"
                                             Explanation="Where your primary clones are: a repository's remote gives its place in it, host, owner, then repo. A card's repos are found here, and a worktree is made for each when it starts. Theseus never clones.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChooseClonesFolder"
                                    AutomationProperties.Name="Change the clones folder" />
                        </controls:SettingRow>

                        <!-- Claude Code's trust of the folders sessions start in, set from here and never by a session (project-view-usability item 7). -->
                        <StackPanel x:Name="FolderTrustSection" DataContext="{Binding FolderTrust}">
                            <controls:SettingRow Label="Trust the folders my cards use" Value="{Binding StandingLine}"
                                                 Explanation="Your one consent: Theseus trusts each card's folders before it starts, by the key Claude Code looks up (a worktree by its main clone), only inside the projects and clones folders, never your home folder, a drive's root or a holdout. Undo takes back what Theseus set and switches this off."
                                                 Visibility="{Binding OffersStanding, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Switch o_ff" Style="{StaticResource Action}" Command="{Binding SwitchOffCommand}"
                                        AutomationProperties.Name="Switch off folder trust" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Stop trusting new folders. What Theseus trusted stays until Undo." />
                                <Button Content="_Switch on…" Style="{StaticResource Action}" Command="{Binding SwitchOnCommand}"
                                        AutomationProperties.Name="Switch on folder trust" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Shows exactly what Theseus will write and why first, and switches it on only if you agree." />
                            </controls:SettingRow>
                            <controls:SettingRow Label="Folder trust" Value="{Binding Line}"
                                                 Explanation="Claude Code asks to trust each folder a session starts in or adds, and its answer for an added folder lasts one session. Trusting a repository covers every worktree of it.">
                                <Button Content="_Undo" Style="{StaticResource Action}" Command="{Binding UndoCommand}"
                                        AutomationProperties.Name="Undo folder trust" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Take back the trust records Theseus set. Offered only after Theseus has set some." />
                                <Button Content="_Trust these…" Style="{StaticResource Action}" Command="{Binding TrustCommand}"
                                        AutomationProperties.Name="Trust these folders" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Shows the exact change to Claude Code's configuration first, and makes it only if you agree." />
                            </controls:SettingRow>
                            <TextBlock x:Name="FolderTrustFolders" Text="{Binding Folders}" Style="{StaticResource PageNote}" Margin="0,-12,0,8"
                                       Visibility="{Binding HasNeeds, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Result}" Style="{StaticResource PageNote}" Margin="0,-8,0,8" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GuardsTab" Header="Guards">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <!-- Every guard Theseus ships, installed from here and never by a session, so a new machine gets them all (guards-ship-with-theseus, 2026-11-26). -->
                        <ItemsControl ItemContainerStyle="{DynamicResource ItemNamedByTitle}" AutomationProperties.Name="Guards" x:Name="GuardRows" ItemsSource="{Binding Guards}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <controls:SettingRow Label="{Binding Title}" Value="{Binding Line}" Explanation="{Binding Explanation}">
                                            <Button Content="Undo" Style="{StaticResource Action}" Command="{Binding UndoCommand}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Undo the {0} install}" ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Put back the copy the last install replaced. Offered only when an earlier copy is kept." />
                                            <Button Content="Install" Style="{StaticResource Action}" Command="{Binding InstallCommand}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Install the {0}}"
                                                    ToolTip="Copy this Theseus's guard to where the Claude Code hook runs it, keeping the old copy, and check it on a fixture folder." />
                                        </controls:SettingRow>
                                        <TextBlock Text="{Binding GuardPath}" Style="{StaticResource PageNote}" Margin="0,-12,0,8" />
                                        <DockPanel Margin="0,0,0,12" Visibility="{Binding HookIsMissing, Converter={StaticResource BoolToVisibility}}">
                                            <Button DockPanel.Dock="Right" Content="Add the hook entry…" Style="{StaticResource Action}" Margin="8,0,0,0"
                                                    Command="{Binding AddHookCommand}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Add a hook entry for the {0}}"
                                                    ToolTip="Shows the exact change to Claude Code's settings first, and makes it only if you agree." />
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding HookMissingLine}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Result}" Style="{StaticResource PageNote}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Auto mode's environment, built from what you enter once and written at your click (guards-ship-with-theseus step 3). -->
                        <StackPanel x:Name="AutoModeSection" DataContext="{Binding AutoMode}" Margin="0,8,0,0">
                            <TextBlock Text="Auto mode's environment" Style="{DynamicResource BodyStrongText}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource PageNote}" Margin="0,0,0,16"
                                       Text="What Claude Code's auto mode reads to tell routine work, such as pushing your own branch, from leaving the trust boundary. Built from the entries below; kept in your Theseus settings, never in a repository." />
                            <controls:SettingRow Label="Source-control hosts" Value="{Binding SourceControlHostsValue}"
                                                 Explanation="The hosts you push to, such as git.example.com or github.com/you. Pushing a workstream's branch to them is routine; completing a pull request is not.">
                                <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeSourceControlHosts"
                                        AutomationProperties.Name="Change the source-control hosts" />
                            </controls:SettingRow>
                            <controls:SettingRow Label="Internal domains" Value="{Binding InternalDomainsValue}"
                                                 Explanation="The domains trusted by name. Leave out any that also serve live systems.">
                                <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeInternalDomains"
                                        AutomationProperties.Name="Change the internal domains" />
                            </controls:SettingRow>
                            <controls:SettingRow Label="Production words" Value="{Binding ProductionPatternsValue}"
                                                 Explanation="Words that mark a host, namespace or resource as production, such as prod or live. Anything so named is sensitive.">
                                <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeProductionPatterns"
                                        AutomationProperties.Name="Change the production words" />
                            </controls:SettingRow>
                            <controls:SettingRow x:Name="AutoModeRow" Label="Environment" Value="{Binding Line}"
                                                 Explanation="Written to Claude Code's settings only when you choose Write, after the exact change is shown. Sessions started afterwards read it.">
                                <Button Content="_Write…" Style="{StaticResource Action}" Command="{Binding WriteCommand}"
                                        AutomationProperties.Name="Write auto mode's environment"
                                        ToolTip="Shows the exact change to Claude Code's settings first, and makes it only if you agree." />
                            </controls:SettingRow>
                            <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource PageNote}" Margin="0,-12,0,8" />
                            <TextBlock Text="{Binding Result}" Style="{StaticResource PageNote}" />
                        </StackPanel>

                        <!-- Each project's holdout folder, read-only: it is changed in that project's Project properties (options-made-clear item 1). -->
                        <TextBlock Text="Each project's holdout folder" Style="{DynamicResource BodyStrongText}" Margin="0,4,0,4" />
                        <TextBlock Style="{StaticResource PageNote}" Margin="0,0,0,16"
                                   Text="Found for each project on its own: the folder chosen in its Project properties; the holdout repository its project.md records; &lt;repo&gt;-holdout beside its repo; otherwise Theseus's own." />
                        <ItemsControl ItemContainerStyle="{DynamicResource ItemNamedByProject}" AutomationProperties.Name="Holdout folders" x:Name="HoldoutRows" ItemsSource="{Binding HoldoutRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:SettingRow Label="{Binding Project}" Value="{Binding Value}" Explanation="{Binding Explanation}">
                                        <Button Content="Project properties" Style="{StaticResource Action}"
                                                Command="{Binding DataContext.OpenProjectPropertiesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding Project, StringFormat=Project properties of {0}}"
                                                ToolTip="Close Options and open this project's Project properties at its holdout folder." />
                                    </controls:SettingRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tags">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Tags (card-search-and-tags items 11, 13): each with its count and colour; renamed or deleted on every card, at once. -->
                    <StackPanel x:Name="TagsSection" Style="{StaticResource Page}" DataContext="{Binding Tags}">
                        <TextBlock Style="{StaticResource PageNote}"
                                   Text="Your tags on cards, kept on this machine. Renaming or deleting one changes every card that has it, straight away." />
                        <TextBlock Style="{StaticResource PageNote}" Text="No card has a tag yet."
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl AutomationProperties.Name="Tags" ItemContainerStyle="{DynamicResource ItemNamedByLabel}" ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="4"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{Binding ColourHex, Converter={StaticResource HexToSwatch}}" />
                                                <TextBlock Text="{Binding Label}" Style="{DynamicResource BodyStrongText}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="Colour:" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ItemsControl ItemContainerStyle="{DynamicResource ItemNamedByToolTip}" AutomationProperties.Name="Colour" ItemsSource="{Binding Swatches}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Its own template, so hover does not paint over the colour; the current one is ringed (review T8). -->
                                                            <Button Width="24" Height="24" Margin="0,0,4,0" Cursor="Hand"
                                                                    ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}"
                                                                    Command="{Binding Command}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid x:Name="Face">
                                                                            <Border x:Name="Ring" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent" />
                                                                            <Border Margin="4" CornerRadius="0"
                                                                                    Background="{Binding ColourHex, Converter={StaticResource HexToSwatch}}" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Face" Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <TranslateTransform Y="1" />
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <DockPanel Margin="0,8,0,0">
                                                <Button DockPanel.Dock="Right" Content="Delete…" Style="{DynamicResource CommandButton}" Margin="8,0,0,0"
                                                        Command="{Binding DeleteCommand}" ToolTip="Take this tag off every card, after asking." />
                                                <Button DockPanel.Dock="Right" Content="Rename" Style="{DynamicResource CommandButton}" Margin="8,0,0,0"
                                                        Command="{Binding RenameCommand}" ToolTip="{Binding RenameToolTip}" ToolTipService.ShowOnDisabled="True" />
                                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New name" Width="200" HorizontalAlignment="Left"
                                                         ToolTip="The tag's new name: letters, digits and hyphens." />
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0" Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                                                <Button DockPanel.Dock="Right" Content="Keep" Style="{DynamicResource CommandButton}" Margin="8,0,0,0"
                                                        Command="{Binding CancelDeleteCommand}" ToolTip="Leave the tag where it is." />
                                                <Button DockPanel.Dock="Right" Content="Delete" Style="{DynamicResource CommandButton}" Margin="8,0,0,0"
                                                        Command="{Binding ConfirmDeleteCommand}" ToolTip="{Binding DeleteQuestion}" />
                                                <TextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Prompts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Style="{StaticResource PageNote}"
                                   Text="What sessions are told. {title}, {key}, {handoff} and {plan} are filled in." />

                        <controls:SettingRow x:Name="IdentityRow" Label="Identity prompt" Value="{Binding IdentityValue}"
                                             Explanation="Who the session is. Opens every first run and fresh start; a resume opens with one line instead. A line naming {plan} is left out when a session has no plan file.">
                            <Button Content="_Reset" Style="{StaticResource Action}" Command="{Binding ResetIdentityPromptCommand}"
                                    AutomationProperties.Name="Use the built-in wording" ToolTip="Use the built-in wording." />
                            <Button Content="Edit…" Style="{StaticResource Action}" Click="OnEditIdentity"
                                    AutomationProperties.Name="Edit the identity prompt" />
                        </controls:SettingRow>
                        <TextBlock Text="{Binding IdentityPromptState}" Style="{StaticResource PageNote}" Margin="0,-12,0,20" />

                        <controls:SettingRow Label="Standing prompt" Value="{Binding StandingValue}"
                                             Explanation="Put in front of every workstream's own opening prompt, so changing it changes every future session.">
                            <Button Content="Edit…" Style="{StaticResource Action}" Click="OnEditStanding"
                                    AutomationProperties.Name="Edit the standing prompt" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Continue prompt" Value="{Binding ContinueValue}"
                                             Explanation="Replaces the workstream's own prompt on a fresh start once it has run before. Use {handoff} for its notes. A resume is not given it.">
                            <Button Content="Edit…" Style="{StaticResource Action}" Click="OnEditContinue"
                                    AutomationProperties.Name="Edit the continue prompt" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Stop prompt" Value="{Binding StopValue}"
                                             Explanation="Put on the clipboard when you press Stop, for you to paste into the session. Use {handoff} for the file it should write.">
                            <Button Content="Edit…" Style="{StaticResource Action}" Click="OnEditStop"
                                    AutomationProperties.Name="Edit the stop prompt" />
                        </controls:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Style="{StaticResource PageNote}"
                                   Text="These rarely need changing: each is found or set up for you, and is here for when that is wrong." />

                <!-- Who rules on resources the lock table does not know; the lock tools themselves install with the tests-lock guard. -->
                <StackPanel DataContext="{Binding LockTools}">
                    <controls:SettingRow Label="Lock arbiter" Value="{Binding Arbiter}"
                                         Explanation="The card whose sessions may rule on a resource the lock table does not know (its capacity and what it clashes with). Until one rules, such a resource is held alone. You see every ruling on the Locks panel and can overturn it.">
                        <ComboBox x:Name="ArbiterBox" ItemsSource="{Binding ArbiterChoices}" SelectedItem="{Binding Arbiter, Mode=TwoWay}" Width="260"
                                  AutomationProperties.Name="Arbiter">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </controls:SettingRow>
                </StackPanel>

                        <controls:SettingRow Label="Plan directory" Value="{Binding PlanDirectoryValue}"
                                             Explanation="Where Claude Code writes its plan files. Theseus reads the cards from here.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChoosePlanDirectory"
                                    AutomationProperties.Name="Change the plan directory" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Terminal window name" Value="{Binding TerminalWindowName}"
                                             Explanation="Each area's sessions open in a window named after this and the area, such as theseus-dev, so Arrange can tile them.">
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeWindowName"
                                    AutomationProperties.Name="Change the terminal window name" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Windows Terminal" Value="{Binding TerminalValue}"
                                             Explanation="Found from whatever terminal is running, which is almost always right and the only way to be sure a named window can be joined.">
                            <Button Content="Reset" Style="{StaticResource Action}" Command="{Binding ResetTerminalCommand}"
                                    AutomationProperties.Name="Find Windows Terminal automatically" ToolTip="Find it automatically again." />
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChooseTerminal"
                                    AutomationProperties.Name="Choose Windows Terminal" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Claude Code" Value="{Binding ClaudeValue}"
                                             Explanation="Found in the usual place or on the path.">
                            <Button Content="Reset" Style="{StaticResource Action}" Command="{Binding ResetClaudeCommand}"
                                    AutomationProperties.Name="Find Claude Code automatically" ToolTip="Find it automatically again." />
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChooseClaude"
                                    AutomationProperties.Name="Choose Claude Code" />
                        </controls:SettingRow>

                        <controls:SettingRow Label="Holdout remote address" Value="{Binding HoldoutRemoteValue}"
                                             Explanation="The address of a private repository of holdout scenarios, such as host/owner/repo. The holdout guard also keeps implementing sessions away from it.">
                            <Button Content="_Clear" Style="{StaticResource Action}" Command="{Binding ResetHoldoutRemoteCommand}"
                                    AutomationProperties.Name="Clear the holdout remote address" ToolTip="Remove the address." />
                            <Button Content="Change…" Style="{StaticResource Action}" Click="OnChangeHoldoutRemote"
                                    AutomationProperties.Name="Change the holdout remote address" />
                        </controls:SettingRow>

                        <!-- About, at the foot of the last tab rather than an eighth one (W7, W53, G143). -->
                        <StackPanel x:Name="AboutSection" Margin="0,8,0,0">
                            <TextBlock Text="About" Style="{DynamicResource BodyStrongText}" />
                            <TextBlock Text="{Binding VersionDescribed, StringFormat=Theseus {0}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0">
                                <Hyperlink Click="OnAbout" ToolTip="Close Options and open About Theseus.">About Theseus</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Every row applies as it changes, so the footer is a single Close (W6, G138). It sits outside the tabs, so it is always reachable. -->
        <Border Grid.Row="1" Padding="24,16"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{DynamicResource DialogButton}" IsCancel="True"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
