<Window x:Class="Theseus.App.AddToProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to project"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!-- Adds the card's row to the chosen objective's workstreams table in project.md (1.1c AC 7). -->
    <StackPanel Margin="20">
        <TextBlock Text="Project" FontWeight="SemiBold" />
        <ComboBox x:Name="ProjectBox" Margin="0,6,0,0" DisplayMemberPath="Title" SelectionChanged="OnProjectChanged" />

        <TextBlock Text="Objective" FontWeight="SemiBold" Margin="0,12,0,0" />
        <ComboBox x:Name="ObjectiveBox" Margin="0,6,0,0" SelectionChanged="OnChanged" />

        <TextBlock Text="Name of its records folder" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBox x:Name="SlugBox" Margin="0,6,0,0" TextChanged="OnChanged" />
        <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Names the folder its records go in, work\&lt;name&gt;, and its branch. Lower-case letters, digits and hyphens." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AddButton" Content="_Add" IsDefault="True" MinWidth="88" Click="OnAdd" IsEnabled="False" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
