<Window x:Class="Theseus.App.ProposalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="860" Height="720" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!-- The one window for a proposal (sessions-run-the-project 0.1): read-only, Approve, Reject… and Cancel. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <DockPanel Margin="16,12,16,12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="HeadingText" Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ObjectiveText" Text="{Binding Objective}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="WhereText" Text="{Binding Where}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding Detail}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="DoneText" Text="{Binding DoneCriteria}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding JiraKeys}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" />
            <TextBlock x:Name="WarningsText" Text="{Binding Warnings}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock Text="{Binding Evidence}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="ApproveButton" DockPanel.Dock="Left" Content="_Approve" Style="{DynamicResource CommandButton}"
                    Padding="12,4" Command="{Binding ApproveCommand}" ToolTip="{Binding Block}" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="RejectButton" DockPanel.Dock="Left" Content="_Reject…" Margin="8,0,0,0" Padding="12,4"
                    Command="{Binding AskRejectCommand}" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="_Cancel" IsCancel="True" MinWidth="88"
                    Command="{Binding CancelCommand}" />
        </DockPanel>

        <StackPanel x:Name="RejectPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Visibility="{Binding IsRejecting, Converter={StaticResource Visible}}">
            <TextBlock Text="Why, for the session that proposed it (optional)" FontSize="12" />
            <TextBox x:Name="NoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="Why it is rejected" />
            <Button x:Name="ConfirmRejectButton" Content="Reject the proposal" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Padding="12,4" Command="{Binding RejectCommand}" />
        </StackPanel>

        <TextBlock x:Name="NoticeText" DockPanel.Dock="Bottom" Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="BlockText" DockPanel.Dock="Bottom" Text="{Binding Block}" TextWrapping="Wrap" Margin="0,8,0,0"
                   FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <FlowDocumentScrollViewer x:Name="BriefView" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                  IsInactiveSelectionHighlightEnabled="True" AutomationProperties.Name="The brief, drawn" />
    </DockPanel>
</Window>
