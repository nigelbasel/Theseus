<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Theseus.App.Controls">
    <!--
        How everything clickable answers the pointer and the keyboard (1.1e AC 6b; Nigel, 2026-11-21: "buttons and links
        give feedback as the user mouses over them"), defined once so every window has it. Theme brushes are
        DynamicResource, so light and dark both follow.
    -->

    <!-- The Fluent theme's icon font key, defined here too so icons still draw with the theme off (baseline W24). -->
    <FontFamily x:Key="SymbolThemeFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The keyboard-focus ring every clickable control shows when reached with Tab. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="5" BorderThickness="2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A clickable surface drawn as text, such as the project view's chips, rows and toggles: underlined on hover, dimmer
        when pressed, grey when disabled. A link uses LinkButton, which is underlined at rest.
    -->
    <ControlTemplate x:Key="LinkTemplate" TargetType="Button">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <!-- The underline is a hairline under the content, so it works whatever the content is. -->
            <Border x:Name="Underline" BorderThickness="0,0,0,1" BorderBrush="Transparent" VerticalAlignment="Center">
                <ContentPresenter x:Name="Text" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Underline" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        A link: the way on beside a disabled button, such as Set the holdout folder… (1.1e AC 6a). Underlined at rest, so a
        link is not told apart by colour alone (W16, G166), in its own colour; the line thickens on hover, the text dims
        when pressed and greys when disabled.
    -->
    <ControlTemplate x:Key="UnderlinedLinkTemplate" TargetType="Button">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <Border x:Name="Underline" BorderThickness="0,0,0,1" VerticalAlignment="Center"
                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentPresenter x:Name="Text" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template" Value="{StaticResource UnderlinedLinkTemplate}" />
    </Style>

    <!-- A card's ring: the card's own corners, outside its border. -->
    <Style x:Key="CardFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The command bar draws its own button rather than taking the theme's.

        The Fluent theme paints hover and pressed through a VisualStateManager inside its
        template, and in dark mode the difference is a few percent of lightness - Nigel reported
        the bar as having no feedback at all on hover or on click, which is what that amounts to
        in practice. A property trigger on the theme's own style would not help either: the
        template's visual states win over it.

        Disabled is worth as much as the other two here. "Start selected" is disabled until
        something is ticked, and a button that looks identical either way reads as broken rather
        than as waiting. It loses its fill and its label greys (1.1e AC 6a): a faded copy of the
        enabled face read as the same button, dimmer.
    -->
    <Style x:Key="CommandButton" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Face">
                        <Border x:Name="Fill" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" />

                        <!--
                            Hover fills the button with the accent outright. A wash over the
                            ordinary fill was tried first and Nigel still called it faint: on a
                            dark board a partly transparent tint is a change of shade, and a
                            change of shade is what he was complaining about in the first place.
                            The label takes the theme's text-on-accent brush with it, which keeps
                            it readable on the accent in both themes (E3: white measured 1.3:1 on
                            dark theme's light accent).
                        -->
                        <Border x:Name="Glow" CornerRadius="4" Opacity="0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />

                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <!--
                            Pressed darkens the accent and drops the button a pixel, so a click
                            reads as going in rather than merely as another shade of the same.
                        -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Glow" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!--
                            Last, so it wins over hover. Unmistakable (1.1e AC 6a): no fill, only a faint outline, so it
                            reads as not a button for now rather than a paler one.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glow" Property="Opacity" Value="0" />
                            <Setter TargetName="Fill" Property="Background" Value="Transparent" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A dialog's one commit button (W12): the accent at rest, its label in the theme's text-on-accent brush, at least 120
        wide (W11). Its own template, since CommandButton's hover is the accent itself. Theseus does not rely on the theme
        accenting IsDefault buttons, so the look is the same whatever the experimental theme does.
    -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Face">
                        <Border x:Name="Fill" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Any other button in a dialog's footer: the same width as its neighbours, at least 120 (W11, G24). -->
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <!--
        The toolbar's buttons are flat, as toolbar buttons are everywhere: no face until the
        pointer is over one, then the accent, as the command buttons do. A disabled one's glyph greys.
        The glyph font is set on the button's content, which is only ever a glyph or a glyph
        with a badge, so it never reaches a label. At least 32 square (W38).
    -->
    <Style x:Key="ToolButton" TargetType="ButtonBase">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Face" Background="Transparent">
                        <Border x:Name="Checked" CornerRadius="4" Opacity="0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="0,0,0,2" />
                        <Border x:Name="Glow" CornerRadius="4" Opacity="0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <!-- A glyph is drawn by GlyphText, which screen readers skip: the button's name says what it is (W50, E10). -->
                        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ContentTemplateSelector="{x:Static controls:GlyphTemplateSelector.Instance}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Checked" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Glow" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glow" Property="Opacity" Value="0" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The theme's toolbar button with its spacing made settable: its template fixes 12 pixels of
        padding either side, which put the buttons about 42 pixels apart where other Windows
        toolbars have them nearly touching. The face is transparent until the pointer is over it,
        as the theme's is; a panel's button stays lit while its panel is open. At least 32 square,
        so the buttons, toggles and boxes of one row share one height (W38, W56).
    -->
    <ControlTemplate x:Key="ToolIconTemplate" TargetType="ButtonBase">
        <Border x:Name="Face" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent"
                BorderThickness="0,0,0,2" BorderBrush="Transparent">
            <!-- A glyph is drawn by GlyphText, which screen readers skip; words keep their access keys (W50, E10). -->
            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                              ContentTemplateSelector="{x:Static controls:GlyphTemplateSelector.Instance}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Background" Value="Transparent" />
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The main toolbar's icon button: 20 is the glyph size for a bar (W22, G41). -->
    <Style x:Key="ToolIcon" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ToolIconTemplate}" />
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>

    <Style x:Key="ToolIconToggle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource ToolIconTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>

    <!--
        A chip: a Jira key, a pull request, a card's drop-down. Underlined on hover, in the text-on-accent brush over the
        accent (E3). 24 high, not 32: it sits in a card's line of text, as a link does.
    -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" CornerRadius="4" Padding="8,0" MinHeight="24"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Rectangle x:Name="Underline" Height="1" Margin="0,0,0,4" VerticalAlignment="Bottom"
                                       Fill="Transparent" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Underline" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chip" Property="Background"
                                    Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="Underline" Property="Fill" Value="Transparent" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A button drawn as a surface of its own, a tab or a stage of a chain: the ring and the disabled look. Its template
        lays a SurfaceWash over its face for hover and pressed, as the face's colour is the template's to choose.
    -->
    <Style x:Key="ClickableSurface" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The tint a ClickableSurface's template lays over its face: the accent, faint on hover and stronger pressed, so it
        shows on any fill in either theme; disabled, the theme's disabled fill.
    -->
    <Style x:Key="SurfaceWash" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter Property="Opacity" Value="0.14" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter Property="Opacity" Value="0.3" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A clickable card, a workstream's or a project's: its border strengthens under the pointer, and it takes a ring of
        its own shape. A Border has no pressed state; a press selects the card, which its accent border shows. A card's
        own style is based on this one, so its selection and link highlights, declared after, win over hover.
    -->
    <Style x:Key="ClickableCard" TargetType="Border">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocusRing}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        A selector bar item: a few views of the same thing are tabs over it, not toggle buttons or links (checklist G125;
        baseline W15). Text, an accent underline under the one selected, a wash on hover. Give a group's items one GroupName,
        and controls:SelectorBar.SelectsOnFocus so the arrow keys select (set where used: this file is loaded loose in tests).
    -->
    <Style x:Key="SelectorBarItem" TargetType="RadioButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Wash" CornerRadius="4" Margin="0,0,0,4" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Rectangle x:Name="Underline" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="12,0" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="IsTabStop" Value="True" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A toggle switch, for a setting that takes effect the moment it changes (W40, G127, G128): WPF ships none, so a
        ToggleButton (or a CheckBox) drawn as one, the track on the left and its label to its right. A check box stays for
        choosing several things that are then applied together.
    -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" VerticalAlignment="Center"
                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
