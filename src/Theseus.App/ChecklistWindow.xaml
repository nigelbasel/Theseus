<Window x:Class="Theseus.App.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="720" Height="520" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- One row per item, sparse, each ticked to begin with; the foot says what the press will do (Nigel, 2026-11-23). -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Intro}" Style="{DynamicResource BodyText}" TextWrapping="Wrap" MaxWidth="480"
                   HorizontalAlignment="Left" Margin="0,0,0,16" />

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <!-- One Tab stop; the arrow keys move between the rows and stop at either end (B-m5, W42). -->
                <ItemsControl AutomationProperties.Name="Cards" ItemContainerStyle="{DynamicResource ItemNamedByLabel}" x:Name="Rows" ItemsSource="{Binding Rows}" Margin="12,8" Focusable="False"
                              KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The check box says only what is ticked; why, and what else to know, sit under it (D15, G129). -->
                            <StackPanel Margin="0,8">
                                <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}">
                                    <TextBlock Text="{Binding Label}" Style="{DynamicResource BodyStrongText}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Text="{Binding Detail}" Style="{DynamicResource CaptionText}" Margin="28,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Note}" Style="{DynamicResource CaptionText}" Margin="28,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel x:Name="Footer" Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Foot}" Style="{DynamicResource BodyStrongText}" VerticalAlignment="Center" />
            <!-- Cancel is the default and the commit is not accented: Enter must not stop and archive cards (review of the checklist, S1; W12). -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ConfirmButton" Style="{DynamicResource DialogButton}"
                        IsEnabled="{Binding CanConfirm}" Click="OnConfirm" ToolTipService.ShowOnDisabled="True"
                        IsEnabledChanged="OnConfirmEnabledChanged" />
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Style="{DynamicResource DialogButton}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
