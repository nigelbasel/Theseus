<Window x:Class="Theseus.App.SpecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Theseus.App.Controls"
        Width="900" Height="760" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        PreviewKeyDown="OnKey"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!-- The spec window (1.1e AC 24a): the spec as read, Preview and Source, Ctrl+F, Accept spec… at its foot. -->
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <!-- Two views of one spec are a selector bar: one Tab stop, the arrows switch, and they stop at either end (W15, W42; B-m4, D7, E8). -->
            <StackPanel x:Name="ViewChoice" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"
                        KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained"
                        AutomationProperties.Name="Views of the spec">
                <RadioButton x:Name="PreviewTab" Content="Preview" GroupName="SpecView" controls:SelectorBar.SelectsOnFocus="True"
                             Style="{DynamicResource SelectorBarItem}" IsChecked="{Binding IsPreview, Mode=OneWay}"
                             ToolTip="Preview: the spec drawn, as it reads" Command="{Binding PreviewCommand}" />
                <RadioButton x:Name="SourceTab" Content="Source" GroupName="SpecView" controls:SelectorBar.SelectsOnFocus="True"
                             Style="{DynamicResource SelectorBarItem}" IsChecked="{Binding IsSource, Mode=OneWay}"
                             ToolTip="Source: the spec's Markdown, as written" Command="{Binding SourceCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock x:Name="FindResult" VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource CaptionText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="SearchBox" Width="220" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Find in the spec (Ctrl+F). Enter or F3 finds the next." KeyDown="OnSearchKey"
                         AutomationProperties.Name="Find in the spec" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <FlowDocumentScrollViewer x:Name="PreviewView" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                      IsInactiveSelectionHighlightEnabled="True"
                                      AutomationProperties.Name="The spec, drawn" />
            <TextBox x:Name="SourceView" IsReadOnly="True" Visibility="Collapsed" IsInactiveSelectionHighlightEnabled="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, monospace"
                     FontSize="12" AutomationProperties.Name="The spec's Markdown" />
        </Grid>

        <TextBlock x:Name="NoticeText" Grid.Row="2" Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Style="{DynamicResource BodyText}" Foreground="{DynamicResource CautionTextBrush}" />

        <!-- The editor is outside Theseus, so a link at the footer's left; the commit and Close at the right (W9, W12; A4, A10). -->
        <DockPanel x:Name="Footer" Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="EditorButton" DockPanel.Dock="Left" Content="Open in editor" Style="{DynamicResource LinkButton}"
                    VerticalAlignment="Center"
                    ToolTip="Open the spec's file in its editor; this window follows its changes."
                    ToolTipService.ShowOnDisabled="True" Command="{Binding OpenInEditorCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AcceptButton" Content="_Accept spec…" Style="{DynamicResource AccentButton}" IsDefault="True"
                        Command="{Binding AcceptCommand}" ToolTip="{Binding AcceptToolTip}"
                        ToolTipService.ShowOnDisabled="True" />
                <Button x:Name="CloseButton" Content="Close" IsCancel="True" Style="{DynamicResource DialogButton}" Margin="8,0,0,0"
                        Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
