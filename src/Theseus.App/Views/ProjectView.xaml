<UserControl x:Class="Theseus.App.Views.ProjectView"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewMouseDown="OnPreviewMouseDown" SizeChanged="OnViewSizeChanged"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Theseus.App.ViewModels"
             xmlns:converters="clr-namespace:Theseus.App.Converters"
             xmlns:controls="clr-namespace:Theseus.App.Controls"
             xmlns:projects="clr-namespace:Theseus.Core.Projects;assembly=Theseus.Core"
             xmlns:local="clr-namespace:Theseus.App.Views">
    <!--
        The project view (1.1d AC 15 to 54; Nigel accepted the mockup, 2026-11-20): time runs down the page. Every
        StaticResource it uses is defined here, because the tests load it without the application's resources; brushes
        come from the theme by DynamicResource, the state colours from Themes/StateColours.*.xaml.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- The shared looks of everything clickable (1.1e AC 6b), merged here too so the view has them in tests. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Theseus;component/Themes/Interactive.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <converters:NotBoolToVisibilityConverter x:Key="NotVisible" />
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <!--
            The stacked-card mark in the project's own colour (1.1d AC 40), or the accent colour while it has none, as in a
            view built without colours.
        -->
        <Style x:Key="ProjectMark" TargetType="controls:StackedCardMark">
            <Setter Property="Foreground" Value="{Binding ColourHex, Converter={StaticResource HexToBrush}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColourHex}" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateForeground" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StateToDoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Done}">
                    <Setter Property="Foreground" Value="{DynamicResource StateDoneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.DoneNoRecord}">
                    <Setter Property="Foreground" Value="{DynamicResource StateDoneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.WaitingOnYou}">
                    <Setter Property="Foreground" Value="{DynamicResource StateWaitingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Busy}">
                    <Setter Property="Foreground" Value="{DynamicResource StateBusyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Stuck}">
                    <Setter Property="Foreground" Value="{DynamicResource StateStuckBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.HoldoutsNotRun}">
                    <Setter Property="Foreground" Value="{DynamicResource StateHoldoutsBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateSoftFill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StateToDoSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Done}">
                    <Setter Property="Background" Value="{DynamicResource StateDoneSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.WaitingOnYou}">
                    <Setter Property="Background" Value="{DynamicResource StateWaitingSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Busy}">
                    <Setter Property="Background" Value="{DynamicResource StateBusySoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Stuck}">
                    <Setter Property="Background" Value="{DynamicResource StateStuckSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.HoldoutsNotRun}">
                    <Setter Property="Background" Value="{DynamicResource StateHoldoutsSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StateToDoSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StateToDoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Done}">
                    <Setter Property="Background" Value="{DynamicResource StateDoneSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StateDoneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.WaitingOnYou}">
                    <Setter Property="Background" Value="{DynamicResource StateWaitingSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StateWaitingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Busy}">
                    <Setter Property="Background" Value="{DynamicResource StateBusySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StateBusyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Stuck}">
                    <Setter Property="Background" Value="{DynamicResource StateStuckSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StateStuckBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.HoldoutsNotRun}">
                    <Setter Property="Background" Value="{DynamicResource StateHoldoutsSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StateHoldoutsBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateStrongFill" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource StateToDoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Done}">
                    <Setter Property="Fill" Value="{DynamicResource StateDoneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.WaitingOnYou}">
                    <Setter Property="Fill" Value="{DynamicResource StateWaitingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Busy}">
                    <Setter Property="Fill" Value="{DynamicResource StateBusyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Stuck}">
                    <Setter Property="Fill" Value="{DynamicResource StateStuckBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.HoldoutsNotRun}">
                    <Setter Property="Fill" Value="{DynamicResource StateHoldoutsBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripChip" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource StateToDoSoftBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource StateToDoBrush}" />
            <Setter Property="StrokeDashArray" Value="3 2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Done}">
                    <Setter Property="Fill" Value="{DynamicResource StateDoneSoftBrush}" />
                    <Setter Property="Stroke" Value="{DynamicResource StateDoneBrush}" />
                    <Setter Property="StrokeDashArray" Value="{x:Null}" />
                </DataTrigger>
                <!-- Done with no record: the done colour, dashed and unfilled, so it never reads as "to do" (walkthrough row 29). -->
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.DoneNoRecord}">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="{DynamicResource StateDoneBrush}" />
                    <Setter Property="StrokeDashArray" Value="3 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.WaitingOnYou}">
                    <Setter Property="Fill" Value="{DynamicResource StateWaitingSoftBrush}" />
                    <Setter Property="Stroke" Value="{DynamicResource StateWaitingBrush}" />
                    <Setter Property="StrokeDashArray" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Busy}">
                    <Setter Property="Fill" Value="{DynamicResource StateBusySoftBrush}" />
                    <Setter Property="Stroke" Value="{DynamicResource StateBusyBrush}" />
                    <Setter Property="StrokeDashArray" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.Stuck}">
                    <Setter Property="Fill" Value="{DynamicResource StateStuckSoftBrush}" />
                    <Setter Property="Stroke" Value="{DynamicResource StateStuckBrush}" />
                    <Setter Property="StrokeDashArray" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static projects:StageNodeState.HoldoutsNotRun}">
                    <Setter Property="Fill" Value="{DynamicResource StateHoldoutsSoftBrush}" />
                    <Setter Property="Stroke" Value="{DynamicResource StateHoldoutsBrush}" />
                    <Setter Property="StrokeDashArray" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The fold buttons beside Group by, as small icons of its height (item 9). -->
        <Style x:Key="ToolbarIcon" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        </Style>

        <!-- Group by's two toggle buttons, one pressed (AC 45): radio buttons drawn as toggle buttons. -->
        <!-- The project's two views as a selector bar's items (walkthrough row 44; checklist G125; baseline W15). -->
        <Style x:Key="GroupByButton" TargetType="RadioButton" BasedOn="{StaticResource SelectorBarItem}">
            <Setter Property="GroupName" Value="GroupBy" />
            <Setter Property="controls:SelectorBar.SelectsOnFocus" Value="True" />
        </Style>

        <!-- A heading's chevron, as a box's (AC 46). -->
        <!-- 20 high, in a 28-wide target: at 14 the arrow was "very small on the tree" (walkthrough row 21; checklist W22, G112). -->
        <Style x:Key="HeadingChevron" TargetType="Button">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--
            A project tab: the open one has a foreground border and a 2 px underline (AC 17); hover, pressed, disabled and the
            ring come from the shared surface (1.1e AC 6b).
        -->
        <Style x:Key="ProjectTab" TargetType="Button" BasedOn="{StaticResource ClickableSurface}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" BorderThickness="1" CornerRadius="6" Padding="8,5,12,5"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Border x:Name="Wash" Style="{StaticResource SurfaceWash}" CornerRadius="5" Margin="-8,-5,-12,-5" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:StackedCardMark Style="{StaticResource ProjectMark}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="-8,0,-12,-5"
                                           Visibility="Collapsed" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A stage of an open box's chain (AC 27): a 3 px top border in the state's colour on its soft fill, the mark and
            name over the state word. Both lines wrap, so a narrow chain never cuts a word off.
        -->
        <Style x:Key="ChainStage" TargetType="Button" BasedOn="{StaticResource ClickableSurface}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Style="{StaticResource StateSoftFill}" BorderThickness="1" CornerRadius="5"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Top" Height="3" Style="{StaticResource StateStrongFill}" />
                                    <StackPanel Margin="5,3,5,5">
                                        <TextBlock x:Name="StageLabel" Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="StageWord" Text="{Binding Word}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="Wash" Style="{StaticResource SurfaceWash}" CornerRadius="5" />
                            <Border x:Name="Chosen" BorderThickness="2" CornerRadius="5" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chosen" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A box's menu item: Properties is the default, in bold (AC 29). -->
        <Style x:Key="StageMenuItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding MenuText}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            A piece of work's box (1.1f A2, H38, H39), the same in rounds and work and grouped by objectives: a title bar in
            its kind's colour with the kind's word, then its state, who acts next, its stages with the gate diamond, the
            objective it serves and its report-back mark. Folded it shows one button; open, its stages by name and every
            action. Each as wide as the flow leaves, so it never scrolls sideways (1.1d AC 31, 54).
        -->
        <DataTemplate x:Key="PieceBox" DataType="{x:Type vm:PieceNodeViewModel}">
            <Grid x:Name="BoxFrame">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{Binding BoxWidth}" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Box" CornerRadius="8" BorderThickness="1" SizeChanged="OnBoxSizeChanged"
                        MouseEnter="OnBoxEnter" MouseLeave="OnHoverLeave">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border x:Name="TitleBar" CornerRadius="7,7,0,0" Padding="4,4,8,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource KindBuildBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Spec">
                                            <Setter Property="Background" Value="{DynamicResource KindSpecBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Verify">
                                            <Setter Property="Background" Value="{DynamicResource KindVerifyBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Bug">
                                            <Setter Property="Background" Value="{DynamicResource KindBugBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Freeform">
                                            <Setter Property="Background" Value="{DynamicResource KindFreeformBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button x:Name="Chevron" DockPanel.Dock="Left" Content="{Binding Chevron}" Command="{Binding ToggleCommand}"
                                        ToolTip="{Binding ChevronToolTip}" AutomationProperties.Name="{Binding ChevronToolTip}"
                                        Padding="4,0" Margin="0,0,4,0" MinWidth="0" MinHeight="0" FontSize="14" Background="Transparent"
                                        BorderThickness="0" VerticalAlignment="Center" Foreground="White" Cursor="Hand" />
                                <Border x:Name="KindWord" DockPanel.Dock="Left" CornerRadius="3" Background="#38000000" Padding="5,1"
                                        Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding KindToolTip}"
                                        AutomationProperties.Name="{Binding KindLabel}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <!-- One click to its tab, folded or open, while its session runs (item 8). -->
                                <!-- Out of the Tab order, so Tab still reaches the title after the chevron; an open box's Focus is in its actions. -->
                                <Button x:Name="BoxFocus" DockPanel.Dock="Right" Content="⌖ Focus" Command="{Binding FocusAction.Command}" IsTabStop="False"
                                        Visibility="{Binding HasSessionMark, Converter={StaticResource Visible}}"
                                        ToolTip="Bring its terminal tab forward" AutomationProperties.Name="{Binding Title, StringFormat=Focus {0}}"
                                        Padding="6,0" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center" Cursor="Hand"
                                        Background="#38000000" Foreground="White" BorderThickness="0" />
                                <TextBlock x:Name="BoxSession" DockPanel.Dock="Right" Text="{Binding SessionMark}" FontSize="11.5"
                                           Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White"
                                           Visibility="{Binding HasSessionMark, Converter={StaticResource Visible}}" />
                                <Border x:Name="PieceHeader" Background="Transparent" Focusable="True" Cursor="Hand"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                                        <KeyBinding Key="Enter" Command="{Binding SelectCommand}" />
                                        <KeyBinding Key="Space" Command="{Binding SelectCommand}" />
                                    </Border.InputBindings>
                                    <TextBlock x:Name="PieceName" Text="{Binding Title}" ToolTip="{Binding Title}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="White" />
                                </Border>
                            </DockPanel>
                        </Border>
                        <Border Background="Transparent" Padding="10,7,10,9" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <TextBlock x:Name="Status" Text="{Binding StatusText}" ToolTip="{Binding StatusToolTip}"
                                           Style="{StaticResource StateForeground}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                <TextBlock x:Name="WhoActs" Text="{Binding WhoActs}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <!-- A report filed after he confirmed an earlier one: seen here, never counted (Nigel, 2026-11-23). -->
                                <DockPanel x:Name="ReportedAgain" Margin="0,4,0,0" Visibility="{Binding HasReportedAgain, Converter={StaticResource Visible}}">
                                    <Button x:Name="OpenLaterReport" DockPanel.Dock="Right" Content="Open report" Command="{Binding OpenLaterReport}"
                                            IsTabStop="{Binding HasReportedAgain}"
                                            FontSize="11.5" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                            ToolTip="Open the report it filed after you confirmed the earlier one" />
                                    <TextBlock Text="{Binding ReportedAgain}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource LinkBrush}" />
                                </DockPanel>

                                <!-- Folded: one chip per stage and the gate diamond after Spec (1.1f D21; 1.1d AC 26). -->
                                <ItemsControl x:Name="Strip" ItemsSource="{Binding StripItems}" Margin="0,7,-3,0" Focusable="False"
                                              Visibility="{Binding IsFolded, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:StageNodeViewModel}">
                                            <Grid x:Name="Chip" Height="18" Margin="0,0,3,0" ToolTip="{Binding ToolTip}" Background="Transparent"
                                                  Cursor="Hand" AutomationProperties.Name="{Binding ToolTip}">
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                                                </Grid.InputBindings>
                                                <Rectangle Style="{StaticResource StripChip}" RadiusX="4" RadiusY="4" StrokeThickness="1" />
                                                <TextBlock Text="{Binding Abbreviation}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Medium"
                                                           Style="{StaticResource StateForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:GateMarkViewModel}">
                                            <TextBlock x:Name="Gate" Text="{Binding Mark}" ToolTip="{Binding ToolTip}" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,3,0"
                                                       AutomationProperties.Name="{Binding AutomationName}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                    <Setter TargetName="Gate" Property="Foreground" Value="{DynamicResource StateWaitingBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                    <Setter TargetName="Gate" Property="Foreground" Value="{DynamicResource StateDoneBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>

                                <!-- Open: the stages by name, joined by ▶, wrapping whole stages so no word is cut (H39). -->
                                <ItemsControl x:Name="Chain" ItemsSource="{Binding Stages}" Margin="0,8,0,0" Focusable="False"
                                              Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StageNodeViewModel}">
                                            <DockPanel>
                                                <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="▶" Width="12" FontSize="11" TextAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource ConnectorBrush}" />
                                                <Button x:Name="Stage" Style="{StaticResource ChainStage}" Command="{Binding SelectCommand}"
                                                        ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu ItemsSource="{Binding MenuItems}" ItemContainerStyle="{StaticResource StageMenuItem}"
                                                                     FontFamily="{x:Static SystemFonts.MessageFontFamily}" />
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                    <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="Serves" Command="{Binding ServesCommand}" ToolTip="{Binding ServesToolTip}" Template="{StaticResource LinkTemplate}"
                                        Margin="0,6,0,0" Cursor="Hand" HorizontalAlignment="Left" Foreground="{DynamicResource LinkBrush}"
                                        AutomationProperties.Name="{Binding ServesText}">
                                    <TextBlock Text="{Binding ServesText}" FontSize="12.5" TextWrapping="Wrap" />
                                </Button>
                                <TextBlock x:Name="ReportBack" Text="{Binding ReportBackText}" ToolTip="{Binding ReportBackToolTip}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasReportBack, Converter={StaticResource Visible}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReportLost}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource StateStuckBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="BranchRules" Text="{Binding BranchRulesMark}" FontSize="11" Margin="0,2,0,0"
                                           ToolTip="{Binding BranchRulesToolTip}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding BranchRulesMark, Converter={StaticResource NotEmpty}}" />
                                <!-- Grouped by objectives, the hand-overs and moves that rounds and work draw as lines (AC 47). -->
                                <ItemsControl x:Name="CrossMarks" ItemsSource="{Binding CrossMarks}" Focusable="False" Margin="0,2,0,0"
                                              Visibility="{Binding DataContext.IsGroupedByObjectives, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="CrossMark" Text="{Binding}" ToolTip="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Folded: the one primary action (H38). -->
                                <ContentControl x:Name="PrimaryAction" Content="{Binding PrimaryAction}" Margin="0,8,0,0" Focusable="False"
                                                HorizontalAlignment="Left">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsFolded}" Value="True" />
                                                        <Condition Binding="{Binding HasPrimaryAction}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!-- Open: every action (H39), as icons like the board's toolbar, the words in each tooltip, one
                                     height in the row (walkthrough rows 24, 32; checklist G38, G40, G86, G90, G92; baseline W24, W56). -->
                                <ItemsControl x:Name="Actions" ItemsSource="{Binding Actions}" Margin="0,8,0,0" Focusable="False"
                                              ItemTemplate="{DynamicResource BoxAction}"
                                              Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <!-- Why a disabled action cannot run, in plain view under the row (2026-11-23). -->
                                <ItemsControl x:Name="ActionNotes" ItemsSource="{Binding Actions}" Focusable="False"
                                              Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding Note, Converter={StaticResource NotEmpty}}">
                                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Note, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="Outline" IsHitTestVisible="False" Margin="-3" BorderThickness="2" CornerRadius="10"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Visible}}" />
            </Grid>
        </DataTemplate>

        <!--
            A box, then the pieces it hands work to (1.1f D17 to D20). Two or more sit between a fork bar and a join bar
            (UML activity notation), each labelled to its right; the children's line runs from below the fork to above the
            join, so nothing is drawn across a line. One alone has no bars: "↳ handed on" above it. Implicit, so the
            children's ItemsControl uses it again.
        -->
        <DataTemplate DataType="{x:Type vm:PieceNodeViewModel}">
            <StackPanel Margin="{Binding Gap}" Visibility="{Binding IsShown, Converter={StaticResource Visible}}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PieceBox}" />
                <Grid x:Name="BranchRow" Margin="0,10,0,0" Visibility="{Binding HasChildren, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding BranchIndent}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1">
                        <!-- The boxes beneath fold together (item 1): the chevron, and while folded one line naming them. -->
                        <DockPanel x:Name="BranchFold" Margin="0,0,0,4">
                            <Button x:Name="BranchChevron" DockPanel.Dock="Left" Style="{StaticResource HeadingChevron}"
                                    Content="{Binding Branch.Chevron}" Command="{Binding Branch.ToggleCommand}"
                                    ToolTip="{Binding Branch.ToolTip}" AutomationProperties.Name="{Binding Branch.ToolTip}" />
                            <TextBlock x:Name="BranchSummary" Text="{Binding Branch.Summary}" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Branch.IsFolded, Converter={StaticResource Visible}}" />
                        </DockPanel>
                        <StackPanel x:Name="BranchBody" Visibility="{Binding Branch.IsOpen, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="HandedOn" Text="↳ handed on" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource StateHandedOnBrush}"
                                   Visibility="{Binding IsSingleHandOver, Converter={StaticResource Visible}}" />
                        <DockPanel x:Name="Fork" Margin="0,0,0,8" Visibility="{Binding IsParallel, Converter={StaticResource Visible}}"
                                   AutomationProperties.Name="{Binding ForkText}">
                            <Rectangle x:Name="ForkBar" DockPanel.Dock="Left" Width="140" Height="5" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ForkLabel" Text="{Binding ForkText}" FontSize="12" Margin="10,0,0,0" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        <Border x:Name="Branch" Margin="9,0,0,0" Padding="16,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsParallel}" Value="True">
                                            <Setter Property="BorderThickness" Value="2,0,0,0" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource StateHandedOnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ItemsControl x:Name="Children" ItemsSource="{Binding Children}" Focusable="False" />
                        </Border>
                        <DockPanel x:Name="Join" Margin="0,0,0,4" Visibility="{Binding IsParallel, Converter={StaticResource Visible}}"
                                   AutomationProperties.Name="{Binding JoinText}">
                            <Rectangle x:Name="JoinBar" DockPanel.Dock="Left" Width="140" Height="5" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="JoinLabel" Text="{Binding JoinText}" FontSize="12" Margin="10,0,0,0" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- A proposal it raised, waiting for you: a dashed node under it (1.1e item 30). -->
                <ItemsControl x:Name="Proposals" ItemsSource="{Binding Proposals}" Margin="34,4,0,0" Focusable="False"
                              Visibility="{Binding HasProposals, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProposalRowViewModel}">
                            <Grid x:Name="ProposalNode" Margin="0,0,0,8" MaxWidth="420" HorizontalAlignment="Left">
                                <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                                           Stroke="{DynamicResource StateWaitingBrush}" />
                                <StackPanel Margin="10,7">
                                    <TextBlock Text="◆ Proposed: waiting for you" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StateWaitingBrush}" />
                                    <TextBlock x:Name="ProposalTitle" Text="{Binding Proposal.Request.Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding DoneCriteria}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <WrapPanel>
                                        <Button x:Name="ProposalReview" Content="Approve…" Command="{Binding ReviewCommand}" Style="{StaticResource CommandButton}"
                                                Padding="9,3" Margin="0,0,6,0" ToolTip="Read its brief, then approve it: creates its card and link"
                                                AutomationProperties.Name="Approve the proposal" />
                                        <Button x:Name="ProposalReject" Content="Reject…" Command="{Binding AskRejectCommand}" Style="{StaticResource CommandButton}"
                                                Padding="9,3" ToolTip="Turn it down, with your reason, here"
                                                AutomationProperties.Name="Reject the proposal" />
                                    </WrapPanel>
                                    <StackPanel x:Name="RejectPanel" Margin="0,6,0,0" Visibility="{Binding IsRejecting, Converter={StaticResource Visible}}">
                                        <TextBox x:Name="RejectNote" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                                 AutomationProperties.Name="Why you reject it" ToolTip="Your reason, kept with the proposal and told to its session" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Reject" Command="{Binding RejectCommand}" Style="{StaticResource CommandButton}" Padding="9,3"
                                                    Margin="0,0,6,0" AutomationProperties.Name="Confirm the rejection" />
                                            <Button Content="Cancel" Command="{Binding CancelRejectCommand}" Style="{StaticResource CommandButton}" Padding="9,3"
                                                    AutomationProperties.Name="Cancel the rejection" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Refusal}" TextWrapping="Wrap" Foreground="{DynamicResource StateStuckBrush}"
                                                   Visibility="{Binding Refusal, Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- A box's action: an icon button when its action has a glyph, else the text button below; never a link among
             buttons (walkthrough row 24). Every one is 32 high. -->
        <DataTemplate x:Key="BoxAction" DataType="{x:Type vm:PieceActionViewModel}">
            <Button x:Name="Action" Command="{Binding Command}" Height="32" MinWidth="32" Padding="8,0"
                    Margin="0,0,4,4" ToolTip="{Binding IconToolTip}" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="{Binding SpokenLabel}" AutomationProperties.HelpText="{Binding ToolTip}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolIcon}">
                        <Setter Property="Content" Value="{Binding Glyph}" />
                        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
                        <Setter Property="FontSize" Value="16" />
                        <Style.Triggers>
                            <!-- A label as a TextBlock: a title's underscore stays text, never an access key in a repeated template (W26). -->
                            <DataTrigger Binding="{Binding Glyph}" Value="{x:Null}">
                                <Setter Property="Content" Value="{Binding Label}" />
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
                                <Setter Property="FontSize" Value="13" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <!-- An action button: the shared command button, a way on drawn as a link (1.1e AC 6a, 6b), and a disabled
             button's note beside it, so its reason is in plain view (2026-11-23). -->
        <DataTemplate DataType="{x:Type vm:PieceActionViewModel}">
            <StackPanel>
            <Button x:Name="Action" HorizontalAlignment="Left" Command="{Binding Command}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}"
                    ToolTipService.ShowOnDisabled="True" Padding="9,3" Margin="0,0,6,6" FontSize="13">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CommandButton}">
                        <Setter Property="MinHeight" Value="30" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                <Setter Property="Template" Value="{StaticResource LinkTemplate}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter Property="Padding" Value="2,3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </Button>
            <TextBlock x:Name="ActionNote" Text="{Binding Note}" FontSize="12.5" Margin="0,-3,10,6"
                       TextWrapping="Wrap" MaxWidth="360" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding Note, Converter={StaticResource NotEmpty}}" />
            </StackPanel>
        </DataTemplate>

        <!-- A round (1.1f C10 to C13): the change banner before it, its heading, then what it set out to meet and its work. -->
        <DataTemplate DataType="{x:Type vm:RoundViewModel}">
            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsShown, Converter={StaticResource Visible}}">
                <Border x:Name="ChangeBanner" BorderThickness="4,0,0,0" CornerRadius="0,6,6,0" Padding="10,8" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource ChangeBrush}" Background="{DynamicResource ChangeSoftBrush}"
                        Visibility="{Binding HasBanner, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock x:Name="BannerText" Text="{Binding Banner}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ChangeBrush}" />
                        <TextBlock x:Name="BannerObjectives" Text="{Binding BannerObjectives}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="RoundHeading" CornerRadius="6" Padding="6,5" Cursor="Hand" Focusable="True"
                        AutomationProperties.Name="{Binding Title}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding ToggleCommand}" />
                        <KeyBinding Key="Space" Command="{Binding ToggleCommand}" />
                    </Border.InputBindings>
                    <WrapPanel>
                        <TextBlock Text="{Binding Chevron}" FontSize="13" Width="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="RoundTitle" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="RoundDates" Text="{Binding Dates}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="RoundState" Text="{Binding StateText}" Style="{StaticResource StateForeground}" FontSize="12.5"
                                   FontWeight="Medium" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="RoundLine" local:LinkedText.Text="{Binding Line}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Line, Converter={StaticResource NotEmpty}}" />
                    </WrapPanel>
                </Border>
                <StackPanel x:Name="RoundBody" Margin="10,10,0,0" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                    <!-- What the round set out to meet: one line folded, a table open (walkthrough row 37). -->
                    <StackPanel x:Name="SetOutToMeet" Margin="0,0,0,12" Visibility="{Binding MeetSummary, Converter={StaticResource NotEmpty}}">
                        <ToggleButton x:Name="MeetToggle" IsChecked="{Binding IsMeetOpen}" HorizontalAlignment="Left" Margin="0,0,0,4"
                                      Cursor="Hand" Padding="4,2" ToolTip="{Binding MeetToolTip}" AutomationProperties.Name="Set out to meet"
                                      AutomationProperties.HelpText="{Binding MeetSummary}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolIconToggle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHighlightedObjective}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StateWaitingSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock FontSize="13">
                                <Run Text="{Binding MeetChevron, Mode=OneWay}" /> <Run Text="Set out to meet:" FontWeight="SemiBold" /> <Run Text="{Binding MeetSummary, Mode=OneWay}" />
                            </TextBlock>
                        </ToggleButton>
                        <ItemsControl x:Name="RoundObjectives" ItemsSource="{Binding Objectives}" Focusable="False" Margin="16,0,0,0"
                                      Grid.IsSharedSizeScope="True" Visibility="{Binding IsMeetOpen, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RoundObjectiveViewModel}">
                                    <Border x:Name="ObjectiveChip" CornerRadius="4" BorderThickness="1" Padding="8,4" Margin="0,0,0,2"
                                            ToolTip="{Binding ToolTip}" Cursor="Hand" AutomationProperties.Name="{Binding Text}" Focusable="True"
                                            MouseEnter="OnObjectiveChipEnter" MouseLeave="OnHoverLeave">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource StateWaitingSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MeetTitle" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Text}" FontSize="13" TextDecorations="Underline" TextWrapping="Wrap" MaxWidth="420"
                                                       Foreground="{DynamicResource LinkBrush}" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Width="60" Height="6" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <Rectangle RadiusX="3" RadiusY="3" Fill="{DynamicResource StateToDoSoftBrush}"
                                                           Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                <Rectangle RadiusX="3" RadiusY="3" HorizontalAlignment="Left" Width="{Binding FilledWidth}"
                                                           Fill="{DynamicResource StateDoneBrush}" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding CriteriaText}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ItemsControl x:Name="RoundItems" ItemsSource="{Binding Items}" Focusable="False" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Finished pieces one session worked through in turn, folded to one line (1.1f D22). -->
        <DataTemplate DataType="{x:Type vm:FinishedRunViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsShown, Converter={StaticResource Visible}}">
                <WrapPanel>
                    <Button x:Name="RunToggle" Content="{Binding Text}" Command="{Binding ToggleCommand}" Template="{StaticResource LinkTemplate}"
                            Cursor="Hand" FontSize="13" Margin="0,0,10,0" Foreground="{DynamicResource LinkBrush}"
                            AutomationProperties.Name="{Binding Text}" />
                    <TextBlock x:Name="RunTitles" Text="{Binding Titles}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsFolded, Converter={StaticResource Visible}}" />
                </WrapPanel>
                <ItemsControl x:Name="RunBoxes" ItemsSource="{Binding Boxes}" Margin="0,10,0,0" Focusable="False"
                              Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DataTemplate>

        <!-- One criterion, ticked or not as project.md has it, and on whom it waits: in Properties and under its objective. -->
        <DataTemplate x:Key="CriterionLine" DataType="{x:Type vm:CriterionViewModel}">
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="Tick" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,6,0" Padding="2,0"
                        MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" FontSize="14"
                        Content="{Binding TickGlyph}" Command="{Binding ToggleCommand}" ToolTip="{Binding ToolTip}"
                        AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding ToolTip}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Waiting}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasWaiting, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- One line of Waits for you with its button, at the top and under the objective it belongs to (item 6). -->
        <DataTemplate x:Key="WaitLine" DataType="{x:Type vm:WaitItemViewModel}">
            <DockPanel Margin="0,0,0,6">
                <Button x:Name="WaitButton" DockPanel.Dock="Right" Content="{Binding Button}" Command="{Binding Command}"
                        Style="{StaticResource CommandButton}" Padding="9,3" Margin="10,0,0,0" FontSize="13"
                        ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True"
                        VerticalAlignment="Top" AutomationProperties.Name="{Binding Button}"
                        Visibility="{Binding HasButton, Converter={StaticResource Visible}}" />
                <TextBlock x:Name="WaitText" local:LinkedText.Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </DataTemplate>

        <!-- A box under its objective heading: the same box, with no branch, since no connector crosses headings (AC 47). -->
        <DataTemplate x:Key="ObjectivePiece" DataType="{x:Type vm:PieceNodeViewModel}">
            <ContentPresenter Margin="0,0,0,14" Content="{Binding}" ContentTemplate="{StaticResource PieceBox}" />
        </DataTemplate>

        <!--
            An objective heading (AC 46, 49): its number and title, ticked of criteria, its pieces' counts or "nothing
            yet", and its pieces under it in a branch that folds.
        -->
        <DataTemplate DataType="{x:Type vm:ObjectiveHeadingViewModel}">
            <StackPanel Margin="0,0,0,12">
                <Grid>
                    <DockPanel>
                        <Button x:Name="ObjectiveChevron" DockPanel.Dock="Left" Style="{StaticResource HeadingChevron}" Content="{Binding Chevron}"
                                Command="{Binding ToggleCommand}" ToolTip="{Binding ChevronToolTip}" />
                        <Border x:Name="ObjectiveHeader" Background="Transparent" Focusable="True" Padding="0,1,4,1"
                                AutomationProperties.Name="{Binding Title}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                                <KeyBinding Key="Enter" Command="{Binding SelectCommand}" />
                                <KeyBinding Key="Space" Command="{Binding SelectCommand}" />
                            </Border.InputBindings>
                            <Border.ContextMenu>
                                <ContextMenu ItemsSource="{Binding MenuItems}" ItemContainerStyle="{StaticResource StageMenuItem}"
                                             FontFamily="{x:Static SystemFonts.MessageFontFamily}" />
                            </Border.ContextMenu>
                            <StackPanel>
                                <TextBlock x:Name="ObjectiveTitle" Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <WrapPanel Margin="0,3,0,0">
                                    <TextBlock x:Name="ObjectiveRollup" Text="{Binding RollupText}" ToolTip="{Binding Rollup.ToolTip}"
                                               FontSize="12.5" FontWeight="SemiBold" Margin="0,0,10,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Button x:Name="ObjectiveCriteria" Content="{Binding CriteriaToggleText}" Command="{Binding ToggleCommand}"
                                            Style="{StaticResource ChipButton}" FontSize="12" Margin="0,0,10,4" VerticalAlignment="Center"
                                            ToolTip="{Binding ChevronToolTip}" AutomationProperties.HelpText="{Binding CriteriaToolTip}"
                                            AutomationProperties.Name="{Binding CriteriaText}"
                                            Visibility="{Binding CriteriaToggleText, Converter={StaticResource NotEmpty}}" />
                                    <ItemsControl x:Name="ObjectiveCounts" ItemsSource="{Binding Counts}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:StateCountViewModel}">
                                                <controls:StateCountChip />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NothingYet" Text="nothing yet" FontSize="12" FontStyle="Italic" Margin="0,0,0,4"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <Border x:Name="ObjectiveOutline" IsHitTestVisible="False" Margin="-3" BorderThickness="2" CornerRadius="6"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            Visibility="{Binding IsSelected, Converter={StaticResource Visible}}" />
                </Grid>
                <!-- What "n of m criteria met" counts, listed while the heading is open (Nigel, 2026-11-23). -->
                <ItemsControl x:Name="ObjectiveCriteriaList" ItemsSource="{Binding Criteria}" ItemTemplate="{StaticResource CriterionLine}"
                              Margin="27,8,0,0" Focusable="False" AutomationProperties.Name="Criteria of this objective"
                              Visibility="{Binding ShowsCriteria, Converter={StaticResource Visible}}" />
                <!-- What waits for him here, shown folded or open, since the mark above shows either way (item 6). -->
                <Border x:Name="ObjectiveWaits" Margin="27,8,0,0" Padding="10,6,10,0" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource StateWaitingBrush}" Background="{DynamicResource StateWaitingSoftBrush}"
                        Visibility="{Binding HasWaits, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{Binding Waits}" ItemTemplate="{StaticResource WaitLine}" Focusable="False"
                                  AutomationProperties.Name="Waits for you under this objective" />
                </Border>
                <Border x:Name="ObjectiveBranch" Margin="9,10,0,0" Padding="16,0,0,0" BorderThickness="2,0,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding ShowsPieces, Converter={StaticResource Visible}}">
                    <ItemsControl x:Name="ObjectivePieces" ItemsSource="{Binding Pieces}" ItemTemplate="{StaticResource ObjectivePiece}" Focusable="False" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- A phase heading (AC 46, 49): "Phase n: name", its exit gate and objectives met, then its objectives, folding. -->
        <DataTemplate DataType="{x:Type vm:PhaseHeadingViewModel}">
            <StackPanel Margin="0,0,0,16">
                <Grid>
                    <DockPanel>
                        <Button x:Name="PhaseChevron" DockPanel.Dock="Left" Style="{StaticResource HeadingChevron}" Content="{Binding Chevron}"
                                Command="{Binding ToggleCommand}" ToolTip="{Binding ChevronToolTip}" />
                        <Border x:Name="PhaseHeader" Background="Transparent" Focusable="True" Padding="0,1,4,1"
                                AutomationProperties.Name="{Binding Title}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                                <KeyBinding Key="Enter" Command="{Binding SelectCommand}" />
                                <KeyBinding Key="Space" Command="{Binding SelectCommand}" />
                            </Border.InputBindings>
                            <Border.ContextMenu>
                                <ContextMenu ItemsSource="{Binding MenuItems}" ItemContainerStyle="{StaticResource StageMenuItem}"
                                             FontFamily="{x:Static SystemFonts.MessageFontFamily}" />
                            </Border.ContextMenu>
                            <StackPanel>
                                <TextBlock x:Name="PhaseTitle" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="PhaseRollup" Text="{Binding RollupText}" ToolTip="{Binding Rollup.ToolTip}" FontSize="12.5"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="PhaseExitGate" Text="{Binding ExitGate}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasExitGate, Converter={StaticResource Visible}}" />
                                <TextBlock x:Name="PhaseDone" Text="{Binding DoneText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <Border x:Name="PhaseOutline" IsHitTestVisible="False" Margin="-3" BorderThickness="2" CornerRadius="6"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            Visibility="{Binding IsSelected, Converter={StaticResource Visible}}" />
                </Grid>
                <Border x:Name="PhaseBranch" Margin="9,10,0,0" Padding="16,0,0,0" BorderThickness="2,0,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                    <ItemsControl x:Name="PhaseObjectives" ItemsSource="{Binding Objectives}" Focusable="False" />
                </Border>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- The title bar: back to the board, then a tab per project (AC 16, 17). -->
        <Border DockPanel.Dock="Top" Padding="14,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <WrapPanel>
                <!-- Back and Forward first, then the board, then the project tabs (1.1f I46). -->
                <Button x:Name="GoBackButton" Content="◀ Back" Command="{Binding GoBackCommand}" Padding="10,4" Margin="0,0,4,0"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Back to where you were (Alt+Left, or the mouse's back button)" AutomationProperties.Name="Back" />
                <Button x:Name="GoForwardButton" Content="Forward ▶" Command="{Binding GoForwardCommand}" Padding="10,4" Margin="0,0,4,0"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Forward again (Alt+Right, or the mouse's forward button)" AutomationProperties.Name="Forward" />
                <Button x:Name="BackButton" Content="⊞ Board" Command="{Binding BackCommand}" Padding="10,4" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        ToolTip="Leave the project for the board" AutomationProperties.Name="Board" />
                <ItemsControl x:Name="Tabs" ItemsSource="{Binding Tabs}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectTabViewModel}">
                            <Button Style="{StaticResource ProjectTab}" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}"
                                    AutomationProperties.Name="{Binding Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </Border>

        <!-- Where the project is: its title, one sentence, six counts, and what waits on you (AC 19, 20). -->
        <Border x:Name="Where" DockPanel.Dock="Top" Padding="16,14" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <WrapPanel>
                    <controls:StackedCardMark x:Name="SummaryMark" Style="{StaticResource ProjectMark}" Margin="0,0,10,0" />
                    <TextBlock x:Name="ProjectTitle" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ProjectTag" Text="PROJECT" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Medium"
                               Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </WrapPanel>
                <WrapPanel x:Name="LeadLine" Margin="0,6,0,0" Visibility="{Binding HasLead, Converter={StaticResource Visible}}">
                    <TextBlock x:Name="LeadText" Text="{Binding LeadText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="FocusLead" Content="⧉ Focus" Command="{Binding FocusLeadCommand}" ToolTip="{Binding FocusLeadToolTip}"
                            ToolTipService.ShowOnDisabled="True" Style="{StaticResource CommandButton}" Padding="8,1" FontSize="12.5"
                            AutomationProperties.Name="Focus the lead's terminal" />
                </WrapPanel>
                <TextBlock x:Name="Sentence" local:LinkedText.Text="{Binding Sentence}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <!-- A clear-up's notice: it asks nothing of him, so it is not under Waits for you, and lapses with its Undo (Nigel, 2026-11-23). -->
                <DockPanel x:Name="ClearUpNoticeLine" Margin="0,8,0,0"
                           Visibility="{Binding ClearUpNotice, Converter={StaticResource NotEmpty}}">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Button x:Name="DismissClearUp" DockPanel.Dock="Right" Content="✕ Dismiss" Command="{Binding DismissClearUpCommand}"
                            Style="{StaticResource CommandButton}" Padding="8,1" FontSize="12.5" Margin="6,0,0,0"
                            AutomationProperties.Name="Dismiss the clear-up notice; it can no longer be undone" />
                    <Button x:Name="UndoClearUp" DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoClearUpCommand}"
                            Style="{StaticResource CommandButton}" Padding="8,1" FontSize="12.5" Margin="8,0,0,0"
                            AutomationProperties.Name="Undo the clear-up" />
                    <TextBlock x:Name="ClearUpNoticeText" Text="{Binding ClearUpNotice}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <!-- What waits for you, the most prominent block, in place even when empty (1.1f G36, G37a). -->
                <Border x:Name="WaitingBand" Margin="0,10,0,0" Padding="12,8,12,6" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource StateWaitingBrush}" Background="{DynamicResource StateWaitingSoftBrush}">
                    <StackPanel>
                        <TextBlock x:Name="WaitsHeading" Text="{Binding WaitsHeading}" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,6"
                                   Foreground="{DynamicResource StateWaitingBrush}"
                                   Visibility="{Binding HasWaits, Converter={StaticResource Visible}}" />
                        <TextBlock x:Name="NothingWaits" Text="Nothing waits for you." FontSize="13" Margin="0,0,0,2"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasWaits, Converter={StaticResource NotVisible}}" />
                        <ItemsControl x:Name="WaitItems" ItemsSource="{Binding Waits}" ItemTemplate="{StaticResource WaitLine}" Focusable="False" />
                    </StackPanel>
                </Border>
                <!-- The phase strip (G34), one line however many phases: it scrolls across rather than wrapping onto a second
                     (walkthrough row 17), each cell's words in full in its tooltip. Then the value of the process as tallies (G35). -->
                <ScrollViewer x:Name="PhaseStripScroller" Margin="0,10,0,0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                              AutomationProperties.Name="Phases: the arrow keys scroll across">
                    <ItemsControl x:Name="PhaseStrip" ItemsSource="{Binding PhaseStrip}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="PhaseCell" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,4,4" Width="168"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Border.ToolTip>
                                        <TextBlock MaxWidth="420" TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak /><Run Text="{Binding Line, Mode=OneWay}" /><LineBreak /><Run Text="{Binding Phase.ExitGate, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Line}" FontSize="12" TextTrimming="CharacterEllipsis" Style="{StaticResource StateForeground}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ItemsControl x:Name="Tallies" ItemsSource="{Binding Tallies}" Margin="0,2,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Tally" Text="{Binding}" FontSize="12.5" Margin="0,0,16,2" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The two views of the project, as a selector bar over the page: one Tab stop, arrow keys select (G124, G125). No
             access keys: WPF fires one on a bare letter when focus is on a button, which would switch the view (P2 review). -->
        <Border DockPanel.Dock="Top" Padding="12,4,12,0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel x:Name="GroupBy" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once"
                        KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Views of the project">
                <RadioButton x:Name="GroupByFlow" Content="Rounds and work" Style="{StaticResource GroupByButton}" Margin="0,0,4,0"
                             IsChecked="{Binding IsGroupedByFlow, Mode=TwoWay}" AutomationProperties.Name="Rounds and work"
                             ToolTip="Rounds and work: pieces of work as they hand work on, time running down the page" />
                <RadioButton x:Name="GroupByObjectives" Content="Objectives only" Style="{StaticResource GroupByButton}"
                             IsChecked="{Binding IsGroupedByObjectives, Mode=TwoWay}" AutomationProperties.Name="Objectives only"
                             ToolTip="Objectives only: pieces of work under the phases and objectives of project.md" />
            </StackPanel>
        </Border>
        <!-- The page's toolbar, then the legend, wrapping, so a narrow window cuts nothing off (AC 21, 22, 45, 54). -->
        <Border DockPanel.Dock="Top" Padding="14,8,14,2" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <WrapPanel x:Name="Toolbar">
                <!--
                    One size in the row (Nigel, 2026-11-23: "large buttons much larger than everything else in that row"):
                    small icons 32 high, each named for UI Automation as its words were, and saying what it does on hover.
                -->
                <Button x:Name="CollapseAll" Content="&#xE73F;" Command="{Binding CollapseAllCommand}" Style="{StaticResource ToolbarIcon}"
                        Height="32" Margin="0,0,4,6"
                        AutomationProperties.Name="Collapse all" ToolTip="Collapse all: fold every piece of work, its children and every heading" />
                <Button x:Name="ExpandAll" Content="&#xE740;" Command="{Binding ExpandAllCommand}" Style="{StaticResource ToolbarIcon}"
                        Height="32" Margin="0,0,4,6"
                        AutomationProperties.Name="Expand all" ToolTip="Expand all: open every piece of work into its stages, with its children, and every heading" />
                <Button x:Name="OpenWhatNeedsAttention" Content="&#xE7C1;" Command="{Binding OpenWhatNeedsAttentionCommand}"
                        Style="{StaticResource ToolbarIcon}" Height="32" Margin="0,0,12,6"
                        AutomationProperties.Name="Open what needs attention"
                        ToolTip="Open what needs attention: what is busy, waiting on you, stuck or waiting for its holdout check, and the headings on the way to it; fold the rest" />
                <WrapPanel x:Name="Legend" Margin="0,0,0,6" VerticalAlignment="Center">
                    <!-- The legend row is the state chips, and a click filters by them (1.1e item 26, moved here by 1.1f D15). -->
                    <ItemsControl x:Name="Counts" ItemsSource="{Binding Counts}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StateCountViewModel}">
                                <Button x:Name="ChipButton" Command="{Binding Command}" ToolTip="{Binding ToolTip}" Template="{StaticResource LinkTemplate}"
                                        Cursor="Hand" Margin="0,0,4,2" AutomationProperties.Name="{Binding Text}">
                                    <Border x:Name="ChipFrame" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                                        <controls:StateCountChip />
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="ChipFrame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="FilterText" Text="{Binding FilterText}" FontSize="12.5" FontWeight="SemiBold" Margin="4,2,10,2"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{Binding IsFiltered, Converter={StaticResource Visible}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,10,2">
                        <Line x:Name="HandsOverSample" X1="0" X2="26" Y1="4" Y2="4" StrokeThickness="2" Margin="0,0,4,0"
                              VerticalAlignment="Center" Stroke="{DynamicResource ConnectorBrush}" />
                        <TextBlock Text="hands work to" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,10,2">
                        <Line x:Name="ThenWorkedOnSample" X1="0" X2="26" Y1="4" Y2="4" StrokeThickness="2" StrokeDashArray="1 2"
                              Margin="0,0,4,0" VerticalAlignment="Center" Stroke="{DynamicResource ConnectorBrush}" />
                        <TextBlock Text="then worked on" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="↩ reported back" FontSize="12.5" Margin="0,2,10,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!--
            The flow beside the Properties pane, with a splitter between them (AC 23, 34, 35). In a view too narrow for
            both, the flow takes the whole width and Properties opens over it on the right when something is selected
            (AC 52, 53).
        -->
        <Grid x:Name="Split" SizeChanged="OnSplitSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FlowColumn" Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="PaneColumn" Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Flow" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Border x:Name="FlowFrame" Padding="20" VerticalAlignment="Top" MaxWidth="{Binding ViewportWidth, ElementName=Flow}">
                    <Grid x:Name="FlowContent" SizeChanged="OnFlowSizeChanged">
                        <Canvas x:Name="Connectors" IsHitTestVisible="False" />
                        <ItemsControl x:Name="RootList" ItemsSource="{Binding ShownRounds}" Focusable="False" />
                        <StackPanel x:Name="ObjectiveList">
                            <ItemsControl x:Name="PhaseList" ItemsSource="{Binding ShownPhases}" Focusable="False" />
                            <ItemsControl x:Name="UnlistedList" ItemsSource="{Binding ShownUnlisted}" Focusable="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeWE" Focusable="False"
                          ToolTip="Drag to resize; double-click to reset"
                          Visibility="{Binding IsPaneDocked, Converter={StaticResource Visible}}"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"
                          DragCompleted="OnSplitterDragCompleted" MouseDoubleClick="OnSplitterDoubleClick" />

            <Border x:Name="Pane" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaneDocked}" Value="False">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Width" Value="{x:Static vm:ProjectPaneWidth.Minimum}" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPaneDocked}" Value="False" />
                                    <Condition Binding="{Binding IsOverlayOpen}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button x:Name="CloseOverlay" DockPanel.Dock="Top" HorizontalAlignment="Right" Content="×" Command="{Binding CloseOverlayCommand}"
                            ToolTip="Close Properties (Esc)" AutomationProperties.Name="Close Properties" Margin="0,6,8,0" Padding="8,0"
                            FontSize="16" Background="Transparent" BorderThickness="0"
                            Visibility="{Binding IsOverlayOpen, Converter={StaticResource Visible}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="Properties" Margin="16,14" DataContext="{Binding Properties}">
                            <TextBlock x:Name="PropertiesHeading" Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="PropertiesHint" Text="{Binding Hint}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                            <Border Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                                <TextBlock x:Name="PropertiesStatus" Text="{Binding StatusText}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                                           Style="{StaticResource StateForeground}" />
                            </Border>
                            <StackPanel x:Name="RecordsPanel" Margin="0,12,0,0" Visibility="{Binding HasRecords, Converter={StaticResource Visible}}">
                                <TextBlock Text="Records" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="RecordsNone" Text="{Binding RecordsNone}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding RecordsNone, Converter={StaticResource NotEmpty}}" />
                                <ItemsControl x:Name="RecordRows" ItemsSource="{Binding Records}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RecordRowViewModel}">
                                            <StackPanel Margin="0,4,0,0">
                                                <Button x:Name="RecordRow" Command="{Binding OpenCommand}" Template="{StaticResource LinkTemplate}"
                                                        Cursor="Hand" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text}"
                                                        ToolTip="{Binding FileToolTip}" Foreground="{DynamicResource LinkBrush}">
                                                    <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" />
                                                </Button>
                                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <!-- The file is named once, by the link above; its name is the link's tooltip (walkthrough row 34). -->
                                                    <Run Text="{Binding StateText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl x:Name="PropertyRows" ItemsSource="{Binding Rows}" Margin="0,12,0,6" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PropertyRowViewModel}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MaxWidth="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Labels in semibold, so the eye finds Where, Who acts next and the rest (walkthrough row 33). -->
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding HasLinks, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                                <TextBlock Text="Links" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ItemsControl x:Name="PropertyLinks" ItemsSource="{Binding Links}" Focusable="False" Margin="8,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl x:Name="PropertyButtons" ItemsSource="{Binding Buttons}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PieceActionViewModel}">
                                        <StackPanel>
                                            <Button HorizontalAlignment="Left" Content="{Binding Label}" Command="{Binding Command}" ToolTip="{Binding ToolTip}"
                                                    ToolTipService.ShowOnDisabled="True" Padding="9,3" Margin="0,0,6,6" FontSize="13" />
                                            <TextBlock Text="{Binding Note}" FontSize="12.5" Margin="0,-3,10,6"
                                                       TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding Note, Converter={StaticResource NotEmpty}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The piece's objective: its criteria ticked in project.md, and Rename objective… (1.1c AC 8; Question 3). -->
                            <StackPanel x:Name="ObjectiveSection" Margin="0,10,0,0"
                                        Visibility="{Binding HasObjective, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding ObjectiveHeading}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ItemsControl x:Name="Criteria" ItemsSource="{Binding Criteria}" ItemTemplate="{StaticResource CriterionLine}" Focusable="False" />
                            <Button x:Name="EditObjective" Content="_Rename objective…" Command="{Binding EditObjectiveCommand}" HorizontalAlignment="Left"
                                    Padding="9,3" Margin="0,4,0,0" FontSize="13" ToolTip="{x:Static vm:ObjectiveHeadingViewModel.EditObjectiveToolTip}"
                                    Visibility="{Binding CanEditObjective, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
