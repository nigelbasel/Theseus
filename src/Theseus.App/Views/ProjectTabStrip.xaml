<UserControl x:Class="Theseus.App.Views.ProjectTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Theseus.App.Converters"
             xmlns:controls="clr-namespace:Theseus.App.Controls">
    <!--
        The project view's tab strip (project-view-as-tabs AC 1 to 4; Nigel, 2026-11-26: "the user interface paradigm is
        really that of a tabbed page view"). It sits over the main area, outside any one project, so it can also show 1.5b's
        All projects tab when no project is open. It holds Back and Forward, then one row of tabs, as the Windows TabView
        guidance has them: the open tab joins the page below it, the others are flat and light on hover, and when the
        tabs do not fit, the row scrolls with ‹ › and the wheel instead of wrapping. Every StaticResource it uses is defined
        here, because the tests load it without the application's resources.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theseus;component/Themes/Interactive.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <converters:HexToBrushConverter x:Key="HexToBrush" />

            <Style x:Key="ProjectMark" TargetType="controls:StackedCardMark">
                <Setter Property="Foreground" Value="{Binding ColourHex, Converter={StaticResource HexToBrush}}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ColourHex}" Value="{x:Null}">
                        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAllProjects}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                A tab (W41; G118, G124): flat until the pointer is over it, then the subtle fill; the open tab has the page's
                own fill and a frame on three sides, its open bottom joining the page (TabView). 32 high, as the buttons
                beside it (W56). The open project, not the selection, decides which tab is joined to the page.
            -->
            <Style x:Key="ProjectTab" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                <!-- The project's commands (AC 4), each asking once where it asks at all, so no ellipsis (W17). -->
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu FontFamily="{x:Static SystemFonts.MessageFontFamily}">
                            <MenuItem Header="_Start the project" Command="{Binding StartCommand}"
                                      ToolTip="Start the cards that were running when it was stopped, and its duties and queue." />
                            <MenuItem Header="S_top the project" Command="{Binding StopCommand}"
                                      ToolTip="Ask its running cards to hand over and stop, pause its duties and queue, and release their locks once they have stopped." />
                            <Separator />
                            <MenuItem Header="_Close project" Command="{Binding CloseCommand}"
                                      ToolTip="Stop its cards after their handover, pause its duties and queue, and put it under Archived until you reopen it." />
                            <MenuItem Header="_Archive project" Command="{Binding ArchiveCommand}"
                                      ToolTip="As Close, and archive its cards too. project.md and its records stay where they are." />
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Frame" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,4,12,4"
                                    MinHeight="{TemplateBinding MinHeight}" BorderBrush="Transparent" Background="Transparent">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:GlyphText x:Name="AllMark" Text="&#xF0E2;" FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                        FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                        Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <controls:StackedCardMark Style="{StaticResource ProjectMark}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TabTitle" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <!-- Waits for you has something (board-small-changes item 2): the banner's own brush, and the
                                         count in the tab's name and tooltip, so the dot is never the only sign. -->
                                    <Ellipse x:Name="WaitsDot" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource StateWaitingBrush}" IsHitTestVisible="False"
                                             Visibility="{Binding HasWaiting, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAllProjects}" Value="True">
                                    <Setter TargetName="AllMark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAllProjects}" Value="True">
                                    <Setter Property="ContextMenu" Value="{x:Null}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ‹ and ›: small, only while the tabs do not fit. -->
            <Style x:Key="ScrollTabs" TargetType="RepeatButton">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Face" CornerRadius="4" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,4,16,0">
        <DockPanel LastChildFill="True">
            <!--
                Back and Forward first, glyph and word, 32 high as the tabs are (W25, W56; C2, D19). No key the window already
                uses: the menu bar's F E V W P D T H, the search bar's R and C.
            -->
            <Button x:Name="GoBackButton" DockPanel.Dock="Left" Command="{Binding GoBackCommand}" Style="{StaticResource CommandButton}"
                    Margin="0,0,8,4" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Back to where you were (Alt+Left, or the mouse's back button)." AutomationProperties.Name="Back"
                    AutomationProperties.AcceleratorKey="Alt+Left">
                <StackPanel Orientation="Horizontal">
                    <controls:GlyphText Text="&#xE72B;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                    <AccessText Text="Bac_k" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="GoForwardButton" DockPanel.Dock="Left" Command="{Binding GoForwardCommand}" Style="{StaticResource CommandButton}"
                    Margin="0,0,12,4" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Forward again (Alt+Right, or the mouse's forward button)." AutomationProperties.Name="Forward"
                    AutomationProperties.AcceleratorKey="Alt+Right">
                <StackPanel Orientation="Horizontal">
                    <AccessText Text="Forw_ard" VerticalAlignment="Center" />
                    <controls:GlyphText Text="&#xE72A;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <RepeatButton x:Name="ScrollLeft" DockPanel.Dock="Left" Style="{StaticResource ScrollTabs}" Content="&#xE76B;"
                          Click="OnScrollLeft" ToolTip="Scroll the tabs left" AutomationProperties.Name="Scroll the tabs left"
                          VerticalAlignment="Bottom" />
            <RepeatButton x:Name="ScrollRight" DockPanel.Dock="Right" Style="{StaticResource ScrollTabs}" Content="&#xE76C;"
                          Click="OnScrollRight" ToolTip="Scroll the tabs right" AutomationProperties.Name="Scroll the tabs right"
                          VerticalAlignment="Bottom" />
            <!--
                The tabs are a selector (W41; B7, D6): one Tab stop, the arrow keys move between them without wrapping, and the
                selected tab is the open one, so selecting one opens it. Ctrl+0 to Ctrl+9 and Ctrl+Tab are the window's.
            -->
            <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" PreviewMouseWheel="OnTabWheel" ScrollChanged="OnTabsScrolled" VerticalAlignment="Bottom">
                <ListBox x:Name="Tabs" ItemsSource="{Binding ProjectTabs}" SelectedItem="{Binding OpenProjectTab, Mode=TwoWay}"
                         SelectionChanged="OnTabSelectionChanged"
                         ItemContainerStyle="{StaticResource ProjectTab}" VerticalAlignment="Bottom" Background="Transparent"
                         BorderThickness="0" Padding="0" SelectionMode="Single" AutomationProperties.Name="Project tabs"
                         KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
