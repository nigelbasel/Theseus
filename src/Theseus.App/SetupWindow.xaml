<Window x:Class="Theseus.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Drawer.Title, StringFormat=Setup: {0}}"
        Width="720"
        MinWidth="520"
        MinHeight="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!--
        A card's setup (Nigel, 2026-10-22): how its sessions start, in a window of its own that moves
        and closes like any other dialog. It is changed rarely and with care, has long prompts that want
        the room, and is the one thing about a card with Save and Cancel, which sit side by side in a
        footer that never scrolls away. Closing it, or Escape, is Cancel.
    -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Drawer.CancelSetupCommand}" />
    </Window.InputBindings>

    <Grid Margin="22,16,22,18">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="How this workstream's sessions start. Changes apply from the next launch." />

            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Not saved" FontSize="11" Foreground="#D68910"
                               Visibility="{Binding Drawer.IsSetupDirty, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Drawer.PlanPath}" FontSize="10"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left"
                               ToolTip="{Binding Drawer.PlanPath}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Padding="18,5" Margin="0,0,8,0"
                            Command="{Binding Drawer.CancelSetupCommand}" />
                    <Button Content="Save" Padding="18,5"
                            Command="{Binding Drawer.SaveCommand}" />
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <Grid>
                        <TextBox Text="{Binding Drawer.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,80,0" />
                        <Button Content="Open" HorizontalAlignment="Right" Padding="12,3"
                                Command="{Binding Drawer.OpenWorkingDirectoryCommand}" />
                    </Grid>
                    <TextBlock FontSize="11" Margin="0,4,0,0"
                               Text="This directory is missing."
                               Foreground="#CF5D61">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Drawer.WorkingDirectoryExists}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Extra directories" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding Drawer.AddDirectories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,70,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Remove" FontSize="11" Padding="8,1"
                                            HorizontalAlignment="Right"
                                            Command="{Binding DataContext.Drawer.RemoveDirectoryCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <TextBox Text="{Binding Drawer.NewDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,60,0" />
                        <Button Content="Add" HorizontalAlignment="Right" Padding="12,3"
                                Command="{Binding Drawer.AddDirectoryCommand}" />
                    </Grid>

                    <TextBlock Text="First run only" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Drawer.Prompt, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding Drawer.HasRun}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="320"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                    <TextBlock Text="{Binding Drawer.FirstRunHint}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Text="Every start" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Drawer.EveryStartPrompt, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Told to this workstream's sessions every time they start, after everything the board says. Use {handoff} for its notes." />

                    <Button Content="Instructions and skills…" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Padding="10,3" FontSize="11"
                            ToolTip="Every CLAUDE.md, rule, skill, command and agent this workstream's sessions get, in the order they are read"
                            Command="{Binding Instructions.OpenCommand}"
                            CommandParameter="{Binding Drawer}" />

                    <TextBlock Text="Handover notes" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBox Text="{Binding Drawer.StatusDocumentPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,70,0" />
                        <Button Content="Open" FontSize="11" Padding="10,2" HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding Drawer.OpenStatusDocumentCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Drawer.HandoffDestination, StringFormat=Leave empty to use {0}}"
                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Text="Terminal window" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Drawer.WindowGroup, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Leave empty to follow the lane. Name a window to put this workstream beside another one whatever lane it is in. It applies from the next launch." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Order in the lane" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding Drawer.BoardOrder, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
