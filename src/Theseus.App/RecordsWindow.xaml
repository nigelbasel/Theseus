<Window x:Class="Theseus.App.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1000" Height="720" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <!-- A piece's records (brief, Records view, 2026-11-22): its documents by stage, the chosen one formatted, the folder last. -->
    <DockPanel Margin="16,12,16,12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="OpenInEditor" DockPanel.Dock="Left" Content="Open in editor" Style="{DynamicResource CommandButton}"
                    Padding="12,4" Command="{Binding OpenInEditorCommand}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Open the document shown in your editor" />
            <Button x:Name="OpenFolder" DockPanel.Dock="Right" Content="Open the folder" Style="{DynamicResource LinkButton}"
                    Command="{Binding OpenFolderCommand}" ToolTip="Show the records folder in Explorer" Cursor="Hand" />
        </DockPanel>
        <TextBlock x:Name="None" DockPanel.Dock="Top" Text="{Binding NoneText}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasNone, Converter={StaticResource BoolToVisibility}}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Entries" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Margin="0,0,12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Records by stage">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4" Cursor="Hand" AutomationProperties.Name="{Binding Stage}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Purpose}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="1" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
        </Grid>
    </DockPanel>
</Window>
