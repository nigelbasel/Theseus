<Window x:Class="Theseus.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Theseus.App.Controls"
        Title="Options"
        Width="620"
        SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!--
            Ten fields in one column is a page you scroll and hunt through. They fall into three
            groups on their own, and the prompts - three multi-line boxes - are most of the height,
            so they start folded: the settings people actually change are then all on one screen.
        -->
        <Style x:Key="Section" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <!--
        MaxHeight is what stops SizeToContent running away.

        Sizing to content with nothing to stop it grew the window taller than the display, and
        CenterOwner then centred that: the title bar went above the top of the screen, taking its
        close button with it, and the footer went below the bottom. A window you can neither close
        nor drag back. The scroll region below could not help, because a window that grows to fit its
        content never asks it to scroll.

        Capped, SizeToContent still does the right thing for a short page - the dialog is only as
        tall as it needs to be - and a long one stops at the screen and scrolls instead.
    -->
    <DockPanel>
        <!--
            The footer sits outside the scroll region deliberately. Save and Cancel were unreachable
            when the settings were taller than the window, and a dialog whose confirm button can be
            pushed off the bottom is a dialog that cannot be used at all.
        -->
        <Border DockPanel.Dock="Bottom" Padding="22,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="18,5" Margin="0,0,8,0" IsCancel="True"
                        Command="{Binding CloseCommand}" />
                <Button Content="Save" Padding="18,5" IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>
                <!-- The theme, which was a drop-down inside a menu until the menu bar arrived. -->
                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}" />
                    </Expander.Header>
                    <StackPanel Margin="0,4,0,8">
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}"
                                  Width="160" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="Applied as soon as it is chosen; Cancel does not undo it." />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <TextBlock Text="Board" Style="{StaticResource SectionHeading}" />
                    </Expander.Header>
                    <StackPanel Margin="0,4,0,8">
                <TextBlock Text="Plan directory" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding PlanDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding PlanDirectoryState}" Style="{StaticResource FieldHint}" />

                <TextBlock Text="Board stages" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding LaneList, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="96" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                <TextBlock Text="{Binding LaneListState}" Style="{StaticResource FieldHint}" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="The columns: how far along the work is, one per line. No column is treated as special — what a bulk Start or Stop acts on is what you tick on the cards." />

                <TextBlock Text="Board areas" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding AreaList, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="80" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                <TextBlock Text="{Binding AreaListState}" Style="{StaticResource FieldHint}" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="The rows: what kind of work it is. Each area gets its own terminal window, so this is also what the windows are named after." />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <TextBlock Text="Tools" Style="{StaticResource SectionHeading}" />
                    </Expander.Header>
                    <StackPanel Margin="0,4,0,8">
                <TextBlock Text="Terminal window name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding TerminalWindowName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Each area gets a window of its own, named after this: theseus-research, theseus-dev. Arrange can then tile them against one another." />

                <TextBlock Text="Windows Terminal" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TerminalExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding TerminalState}" Style="{StaticResource FieldHint}" />

                <TextBlock Text="Claude Code" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ClaudeExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ClaudeState}" Style="{StaticResource FieldHint}" />

                <TextBlock Text="Jira" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding JiraBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding JiraState}" Style="{StaticResource FieldHint}" />

                <!-- Shown until a projects folder is saved: how Theseus lays out your work (1.1b AC 11). -->
                <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{Binding ShowsProjectsIntro, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="How Theseus lays out your work" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Three places, three jobs. A project home says what the work is and where it has got to; your source clones are the code as it is upstream; worktrees are the code each workstream is changing. Records never go in a code repo, so they never need a branch, a merge or a pull request." />
                        <TextBlock Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" xml:space="preserve"
                                   Text="&lt;projects folder&gt;\&lt;project&gt;\     project.md, and work\&lt;slug&gt;\ records&#x0a;&lt;your source clones&gt;             wherever you keep them&#x0a;&lt;worktrees folder&gt;\&lt;slug&gt;\&lt;repo&gt; a worktree per repo, branch &lt;you&gt;/&lt;slug&gt;" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Nothing is set for you. If you have no layout of your own yet, Documents\Theseus\projects and Documents\Theseus\work are a good start; the folder pickers open in Documents." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Choose _projects folder…" Click="OnChooseProjectsFolder" />
                            <Button Content="Choose _worktrees folder…" Margin="8,0,0,0" Click="OnChooseWorktreesFolder" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink NavigateUri="https://nigelbasel.github.io/Theseus/project-layout.html" RequestNavigate="OnLink">How your work is laid out</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Projects folder" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ProjectsFolder, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Each folder in it with a project.md is a project: its objectives and workstreams, and a work folder of their records. Records are plain files, kept outside every code repo. Leave empty for no projects." />

                <!-- Folders said not to be projects, from a project card's menu (1.1e AC 20). -->
                <TextBlock Text="Folders that are not projects" Style="{StaticResource FieldLabel}"
                           Visibility="{Binding HiddenProjectFolders.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl x:Name="HiddenProjectFolders" ItemsSource="{Binding HiddenProjectFolders}"
                              Visibility="{Binding HiddenProjectFolders.Count, Converter={StaticResource CountToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Show again" Padding="10,2"
                                        AutomationProperties.Name="{Binding StringFormat=Show {0} again}"
                                        ToolTip="Show this folder's project card again, once saved"
                                        Command="{Binding DataContext.ShowProjectFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Worktrees folder" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding WorktreesFolder, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Where each workstream's worktrees go: a folder per workstream, with a worktree in it for each repo the workstream changes." />

                <TextBlock Text="Holdout scenarios folder" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HoldoutFolderBox" Text="{Binding HoldoutFolder, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Holdout scenarios folder" />
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="C_hange…" Padding="10,2" Click="OnChooseHoldoutFolder"
                            ToolTip="Choose the folder the holdout scenarios are in, such as a private repository's clone" />
                    <TextBlock x:Name="HoldoutInUse" Text="{Binding HoldoutFolderInUse}" VerticalAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding HoldoutFolderInUse}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <TextBlock Text="Holdout remote address" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding HoldoutRemote, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="The clone of the private scenarios that judge changes, and its address such as host/owner/repo. The holdout guard keeps both from implementing sessions; a verifier card reads the scenarios there and writes its report to the results folder. Leave the folder empty to use a folder per project under Theseus's own data folder, made on first use." />
                <CheckBox Content="Include pre-releases in Check for updates" Margin="0,8,0,0"
                          IsChecked="{Binding IncludePreReleases, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Pre-releases are built from a project's primary branch, before it is merged into main, so its work can be tried live first. Off offers releases from main only." />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource Section}">
                    <Expander.Header>
                        <TextBlock Text="Starting sessions" Style="{StaticResource SectionHeading}" />
                    </Expander.Header>
                    <StackPanel Margin="0,4,0,8">
                <TextBlock Text="When a workstream has run before" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <RadioButton GroupName="StartMode" Content="Resume its last conversation"
                             IsChecked="{Binding ResumeByDefault, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,8"
                           Text="Keeps everything the session knew. Reloads the conversation from its last compaction - often hundreds of thousands of tokens, carried again on every reply." />
                <RadioButton GroupName="StartMode" Content="Start fresh from its handoff"
                             IsChecked="{Binding FreshByDefault, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,8"
                           Text="A new conversation, told to read the handoff. Small and cheap, but it knows only what the handoff says." />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Either way, the ▾ beside a card's Start or Restart button offers the other." />
                    </StackPanel>
                </Expander>

                <!--
                    Folded to start with. These three are multi-line and are most of the page's
                    height; leaving them open is what made the window outgrow the screen.
                -->
                <Expander Style="{StaticResource Section}" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="Prompts" Style="{StaticResource SectionHeading}" />
                    </Expander.Header>
                    <StackPanel Margin="0,4,0,8">
                <TextBlock Text="Who the session is" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <controls:MarkdownBox x:Name="IdentityBox" Text="{Binding IdentityPrompt}" EditorMinHeight="120" EditorMaxHeight="400" />
                <Grid>
                    <TextBlock Text="{Binding IdentityPromptState}" Style="{StaticResource FieldHint}"
                               Margin="0,4,150,0" />
                    <Button Content="Use the built-in wording" HorizontalAlignment="Right" Padding="10,2"
                            Margin="0,4,0,0" FontSize="11"
                            Command="{Binding ResetIdentityPromptCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Opens every first run and fresh start, before anything else; a resume keeps its conversation and opens with one line instead. {title}, {key}, {handoff} and {plan} are filled in; a line naming {plan} is left out when a session has no plan file." />

                <TextBlock Text="Standing prompt" Style="{StaticResource FieldLabel}" />
                <controls:MarkdownBox x:Name="StandingBox" Text="{Binding SessionPreamble}" EditorMinHeight="90" EditorMaxHeight="400" />
                <TextBlock Text="{Binding SessionPreambleState}" Style="{StaticResource FieldHint}" />

                <TextBlock Text="Continuing a workstream" Style="{StaticResource FieldLabel}" />
                <controls:MarkdownBox x:Name="ContinueBox" Text="{Binding ContinuePrompt}" EditorMinHeight="90" EditorMaxHeight="400" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Replaces the workstream's own prompt on a fresh start once it has run before. Use {handoff} for its notes. A resume is not given it." />
                <TextBlock Text="{Binding ContinuePromptState}" Style="{StaticResource FieldHint}" />

                <TextBlock Text="Stopping a session" Style="{StaticResource FieldLabel}" />
                <controls:MarkdownBox x:Name="StopBox" Text="{Binding StopPrompt}" EditorMinHeight="90" EditorMaxHeight="400" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Put on the clipboard when you press Stop, for you to paste into the session. Use {handoff} for the file it should write." />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
