<Window x:Class="Theseus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Theseus.App.ViewModels"
        xmlns:settings="clr-namespace:Theseus.Core.Settings;assembly=Theseus.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        AllowsTransparency="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="Manual"
        Icon="Assets/theseus.ico"
        Title="Theseus" Height="760" Width="1400" MinHeight="480" MinWidth="720">

    <Window.Resources>

        <ObjectDataProvider x:Key="ThemeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="settings:AppTheme" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="4" Padding="6,2"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="JiraKeyTemplate">
            <Button Style="{StaticResource ChipButton}"
                    Command="{Binding DataContext.OpenJiraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding StringFormat=Open {0} in Jira}">
                <TextBlock Text="{Binding}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PullRequestTemplate">
            <Button Style="{StaticResource ChipButton}"
                    Command="{Binding DataContext.OpenPullRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Url}">
                <TextBlock Text="{Binding Number, StringFormat=PR {0}}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:WorkstreamCardViewModel}">
            <Border CornerRadius="8" Margin="0,0,0,8" MinHeight="96"
                    ToolTip="{Binding Workstream.WorkingDirectory}"
                    MouseLeftButtonUp="OnCardClicked">
                <!--
                    A card with no session takes the lane's own fill and sinks into the board; a
                    running one stays raised above it. Neither hue nor the border is available to say
                    this: the stripe is the workstream's permanent tab colour, and the border already
                    means selected.
                -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8,0,0,8"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                        <!--
                            Only a session that is working moves. A session waiting for a reply is
                            the one thing on the board asking for a person, and it stands out by
                            being still among its moving neighbours. Motion that marked every live
                            session would decorate the board rather than tell you anything.
                        -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="Working">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1.0" To="0.35" Duration="0:0:1.1"
                                                        AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Working" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,10,12,10">
                        <Grid>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,124,0"
                                       ToolTip="{Binding Title}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Start" FontSize="11" Padding="8,1" Margin="0,0,4,0"
                                        Visibility="{Binding IsLive, Converter={StaticResource NotBoolToVisibility}}"
                                        ToolTip="Open a tab for this workstream"
                                        Command="{Binding DataContext.StartCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Stop" FontSize="11" Padding="8,1" Margin="0,0,4,0"
                                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Bring this session forward with a stop request ready to paste"
                                        Command="{Binding DataContext.StopCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Focus" FontSize="11" Padding="8,1" Margin="0,0,6,0"
                                        ToolTip="Bring this session's tab to the front"
                                        Command="{Binding DataContext.FocusCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding Lifecycle, Converter={StaticResource LifecycleGlyph}}"
                                           FontSize="16" VerticalAlignment="Center"
                                           ToolTip="{Binding StatusLine}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding JiraKeys}" Margin="0,8,0,0"
                                      ItemTemplate="{StaticResource JiraKeyTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding PullRequests}"
                                      ItemTemplate="{StaticResource PullRequestTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   ToolTip="{Binding TodoSummary}"
                                   Text="{Binding TodoSummary}"
                                   Visibility="{Binding TodoSummary, Converter={StaticResource NotEmptyToVisibility}}" />

                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding StatusLine}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ColumnTemplate" DataType="{x:Type vm:ColumnViewModel}">
            <Border MinWidth="300" MaxWidth="360" Margin="8" CornerRadius="10" Padding="10"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                        <TextBlock Text="{Binding Heading}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="Start lane" FontSize="11" Padding="8,1" Margin="0,0,8,0"
                                    ToolTip="Start every workstream in this lane that is not already running"
                                    Command="{Binding StartAllCommand}" />
                            <TextBlock Text="{Binding Count}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Cards}"
                                  ItemTemplate="{StaticResource CardTemplate}"
                                  AllowDrop="True"
                                  Drop="OnColumnDrop"
                                  DragOver="OnColumnDragOver"
                                  Background="Transparent"
                                  MinHeight="120"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True"
                                              Focusable="False"
                                              Padding="0,0,2,0"
                                              Background="{TemplateBinding Background}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LiveSessionTemplate" DataType="{x:Type vm:LiveSessionViewModel}">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,20,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="on board" FontSize="10" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="{Binding IsAdopted, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding WorkingDirectory}" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusLine}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Focus" FontSize="11" Padding="10,2" Margin="0,0,6,0"
                                ToolTip="Bring this session's terminal to the front"
                                Command="{Binding DataContext.Sessions.FocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button x:Name="AdoptButton" Content="Adopt into…" FontSize="11" Padding="10,2"
                                ToolTip="Make a workstream follow this running session"
                                Click="OnAdoptClicked">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding AdoptTargets}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Title}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,12,16,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center"
                        ToolTip="Show or hide the live sessions panel"
                        Command="{Binding ToggleSessionsPanelCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Sessions.Status}" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel>
                    <TextBlock Text="{Binding Board.Status}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Notice}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="New workstream" Padding="14,4" Margin="0,0,8,0"
                        ToolTip="Create a workstream and open a session for it"
                        Command="{Binding NewWorkstream.OpenCommand}" />
                <Button Content="Start all" Padding="14,4" Margin="0,0,8,0"
                        ToolTip="Start every lane except the last"
                        Command="{Binding StartBoardCommand}" />
                <Button Content="Stop all" Padding="14,4" Margin="0,0,16,0"
                        ToolTip="Work through the running sessions, one stop request at a time"
                        Command="{Binding StopBoardCommand}" />
                <TextBlock Text="Theme" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Source={StaticResource ThemeValues}}"
                          SelectedItem="{Binding Theme, Mode=TwoWay}"
                          Width="110" Margin="0,0,12,0" />
                <Button Content="Refresh" Padding="14,4" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                <Button Content="Settings" Padding="14,4" Command="{Binding Settings.OpenCommand}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Left" Width="280" Margin="16,8,0,16" CornerRadius="10" Padding="10"
                Visibility="{Binding IsSessionsPanelOpen, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                    <TextBlock Text="Live sessions" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Sessions.Status}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Padding="6,2" Margin="8,0,0,0" ToolTip="Hide the live sessions panel"
                                Command="{Binding ToggleSessionsPanelCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions.Sessions}"
                                  ItemTemplate="{StaticResource LiveSessionTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="30" Padding="16,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Usage.HasReading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Usage.SessionText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Usage.WeeklyText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="  ·  " FontSize="12"
                               Visibility="{Binding Usage.BindingText, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Usage.BindingText}" FontSize="12"
                               Visibility="{Binding Usage.BindingText, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Usage.IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="#D68910" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding Usage.Problem}" FontSize="12" VerticalAlignment="Center"
                           Visibility="{Binding Usage.Problem, Converter={StaticResource NotEmptyToVisibility}}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Account}" FontSize="11" Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               ToolTip="The Claude account every session on this machine runs as"
                               Visibility="{Binding Account, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Usage.Age}" FontSize="11" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button Content="↻" FontSize="12" Padding="8,0" ToolTip="Read usage now"
                            Command="{Binding Usage.RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Padding="8,0,8,8">
                <ItemsControl ItemsSource="{Binding Board.Columns}" ItemTemplate="{StaticResource ColumnTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Detail drawer -->
            <Border HorizontalAlignment="Right" Width="480" Margin="0,0,0,8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding Drawer.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="18,14,18,14">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Drawer.ColorHex, Converter={StaticResource HexToBrush}}"
                                    ToolTip="Permanent. A change applies from the next launch." />
                            <TextBlock Text="{Binding Drawer.Key}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <Button Content="Close" HorizontalAlignment="Right" Padding="12,3"
                                Command="{Binding Drawer.CloseCommand}" />
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Drawer.PlanPath}" FontSize="10" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,120,0"
                                   ToolTip="{Binding Drawer.PlanPath}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Button Content="Save" HorizontalAlignment="Right" Padding="20,4"
                                Command="{Binding Drawer.SaveCommand}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Drawer.Title, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Jira issues" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Drawer.JiraKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,70,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Button Content="Remove" FontSize="11" Padding="8,1"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.Drawer.RemoveJiraKeyCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <TextBox Text="{Binding Drawer.NewJiraKey, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,60,0" />
                                <Button Content="Add" HorizontalAlignment="Right" Padding="12,3"
                                        Command="{Binding Drawer.AddJiraKeyCommand}" />
                            </Grid>
                            <Button Content="{Binding Drawer.UnclaimedKeys.Count,
                                              StringFormat=Take {0} more from the prompt}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3" FontSize="11"
                                    Command="{Binding Drawer.RescanPromptCommand}"
                                    Visibility="{Binding Drawer.UnclaimedKeys.Count,
                                                 Converter={StaticResource CountToVisibility}}" />

                            <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <TextBox Text="{Binding Drawer.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,80,0" />
                                <Button Content="Open" HorizontalAlignment="Right" Padding="12,3"
                                        Command="{Binding Drawer.OpenWorkingDirectoryCommand}" />
                            </Grid>
                            <TextBlock FontSize="11" Margin="0,4,0,0"
                                       Text="This directory is missing."
                                       Foreground="#CF5D61">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drawer.WorkingDirectoryExists}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Extra directories" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Drawer.AddDirectories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,70,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Button Content="Remove" FontSize="11" Padding="8,1"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.Drawer.RemoveDirectoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <TextBox Text="{Binding Drawer.NewDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,60,0" />
                                <Button Content="Add" HorizontalAlignment="Right" Padding="12,3"
                                        Command="{Binding Drawer.AddDirectoryCommand}" />
                            </Grid>

                            <TextBlock Text="Opening prompt" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Drawer.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />

                            <Grid Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Order" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox Text="{Binding Drawer.BoardOrder, UpdateSourceTrigger=PropertyChanged}"
                                             Width="50" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox Content="Blocked" Margin="0,0,14,0"
                                              IsChecked="{Binding Drawer.IsBlocked}" />
                                    <CheckBox Content="Reopen tomorrow"
                                              IsChecked="{Binding Drawer.ReopenTomorrow}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Handover notes" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <TextBox Text="{Binding Drawer.StatusDocumentPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,70,0" />
                                <Button Content="Open" FontSize="11" Padding="10,2" HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding Drawer.OpenStatusDocumentCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding Drawer.HandoffDestination, StringFormat=Leave empty to use {0}}"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Text="Workflows" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding Drawer.Workflows.Count,
                                                    Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Drawer.Workflows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8" ToolTip="{Binding Summary}">
                                            <TextBlock Text="{Binding Headline}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Phases}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Phases,
                                                                    Converter={StaticResource NotEmptyToVisibility}}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Runs" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Drawer.Runs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="8,5" CornerRadius="4"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Started}" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="{Binding ShortSessionId, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Outcome, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Duration}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No runs recorded yet." FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Drawer.Runs.Count, Converter={StaticResource ZeroToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Background="#99000000"
                    Visibility="{Binding NewWorkstream.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                        CornerRadius="10" Padding="22"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Allocated automatically, and permanent once created"
                                    Background="{Binding NewWorkstream.ColourHex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="New workstream" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewWorkstream.Title, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding NewWorkstream.Key, StringFormat=plan file: {0}.json}"
                                   Style="{StaticResource FieldHint}" />

                        <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewWorkstream.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="This directory does not exist." FontSize="11" Margin="0,4,0,0"
                                   Foreground="#CF5D61">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewWorkstream.WorkingDirectoryExists}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Opening prompt" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewWorkstream.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />

                        <Grid Margin="0,18,0,0">
                            <CheckBox Content="Open a tab now" VerticalAlignment="Center"
                                      IsChecked="{Binding NewWorkstream.StartNow}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Padding="18,5" Margin="0,0,8,0"
                                        Command="{Binding NewWorkstream.CloseCommand}" />
                                <Button Content="Create" Padding="18,5"
                                        Command="{Binding NewWorkstream.CreateCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </DockPanel>
</Window>
