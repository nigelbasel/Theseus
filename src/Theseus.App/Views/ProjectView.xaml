<UserControl x:Class="Theseus.App.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Theseus.App.ViewModels">
    <!--
        The project view (project-view AC 14 to 16), its own control so the main window only switches to it. Its
        resources are its own, apart from the card template and brushes, which come from the window by
        DynamicResource, so a card here has the board's face, menu and selection.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type vm:ProjectEntryViewModel}">
            <StackPanel Margin="0,0,0,6" ToolTip="{Binding ToolTipText}">
                <ContentPresenter Content="{Binding Card}" ContentTemplate="{DynamicResource CardTemplate}"
                                  Visibility="{Binding HasCard, Converter={StaticResource Visible}}" />
                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Note}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding HasNote, Converter={StaticResource Visible}}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <Border x:Name="WaitingOnYou" Margin="0,4,0,0" Padding="8,6" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding IsWaitingOnYou, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{Binding WaitingText}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Open spec" Padding="8,2" Margin="0,0,6,0" Command="{Binding OpenSpecCommand}"
                                    ToolTip="Open the spec as it was read, at the commit Accept spec names" />
                            <Button Content="Accept spec…" Padding="8,2" Command="{Binding AcceptSpecCommand}"
                                    ToolTip="Pass this gate: asks first, naming the slug and the commit" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasCard}" Value="True">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- The breadcrumb back to the board (AC 14), and the project's terminal window brought forward (AC 21). -->
        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
        <Button x:Name="BringWindowForward" DockPanel.Dock="Right" Content="Bring window forward" Padding="8,2"
                Command="{Binding DataContext.BringProjectWindowForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                ToolTip="{Binding DataContext.ProjectWindowTooltip, RelativeSource={RelativeSource AncestorType=Window}}"
                ToolTipService.ShowOnDisabled="True" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BoardCrumb" Content="Board" Command="{Binding BackCommand}" Padding="8,2"
                    ToolTip="Back to the board (View › Back to the board)" />
            <TextBlock Text="›" Margin="8,0" VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="ProjectTitle" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{Binding PhaseText}" Margin="16,0,0,0" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PhaseText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MainPullRequestText}" FontSize="11" Margin="4,6,4,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: phases, objectives and workstreams. Selecting one scrolls the pipeline to its row. -->
            <TreeView x:Name="Tree" ItemsSource="{Binding Tree}" Margin="0,0,8,0" BorderThickness="0"
                      Background="Transparent" SelectedItemChanged="OnTreeSelectionChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ProjectTreeNodeViewModel}" ItemsSource="{Binding Children}">
                        <!-- A criterion ticks in the project file; an objective is edited and a phase given an objective from
                             the right-click menu (1.1c AC 8). The file is the truth: the box shows what it says. -->
                        <DockPanel Margin="0,1" Background="Transparent">
                            <DockPanel.ContextMenu>
                                <ContextMenu FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                                             Visibility="{Binding HasMenu, Converter={StaticResource Visible}}">
                                    <MenuItem Header="_Edit…" Command="{Binding EditCommand}"
                                              Visibility="{Binding HasEdit, Converter={StaticResource Visible}}"
                                              ToolTip="Change this objective's title in project.md" />
                                    <MenuItem Header="_Add objective…" Command="{Binding AddObjectiveCommand}"
                                              Visibility="{Binding HasAddObjective, Converter={StaticResource Visible}}"
                                              ToolTip="Add an objective at the end of this phase in project.md" />
                                    <MenuItem Header="Open project._md" Command="{Binding OpenFileCommand}"
                                              Visibility="{Binding HasOpenFile, Converter={StaticResource Visible}}"
                                              ToolTip="Open the project's file in its editor" />
                                </ContextMenu>
                            </DockPanel.ContextMenu>
                            <Button DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,6,0" Padding="2,0" MinWidth="0"
                                    Background="Transparent" BorderThickness="0" FontSize="14"
                                    Content="{Binding TickGlyph}" Command="{Binding ToggleCommand}"
                                    ToolTip="Tick or untick this criterion in project.md"
                                    Visibility="{Binding IsCriterion, Converter={StaticResource Visible}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasDetail, Converter={StaticResource Visible}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWaitingOnYou}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Right: a row per objective with workstreams, across the stage columns (AC 6, 15). -->
            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Width="160" />
                    <ItemsControl x:Name="Headings" ItemsSource="{x:Static vm:ProjectViewModel.ColumnHeadings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" Margin="4,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <ScrollViewer x:Name="Pipeline" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectPipelineRowViewModel}">
                                <Border Margin="0,0,0,8" Padding="0,6" BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="160" Text="{Binding Heading}" FontSize="12"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Grid>
                                            <ItemsControl x:Name="Cells" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="7" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ProjectStageCellViewModel}">
                                                        <ItemsControl Margin="4,0" ItemsSource="{Binding Entries}"
                                                                      ItemTemplate="{StaticResource EntryTemplate}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl x:Name="Loose" ItemsSource="{Binding Loose}"
                                                          ItemTemplate="{StaticResource EntryTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
